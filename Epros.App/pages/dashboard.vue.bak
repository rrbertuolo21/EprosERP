  if (sefazServiceCodes.value.length > 0) {
    servicoForm.value.codigoServicoSefazId = sefazServiceCodes.value[0].id
  }
  showServicoModal.value = true
}

const openEditServicoModal = (serv) => {
  selectedServico.value = serv
  servicoForm.value = { ...serv }
  showServicoModal.value = true
}

const submitServicoForm = async () => {
  const ssc = sefazServiceCodes.value.find(x => x.id === servicoForm.value.codigoServicoSefazId)
  if (ssc) {
    servicoForm.value.codigoServicoSefazCodigo = ssc.codigo
    servicoForm.value.codigoServicoSefazDescricao = ssc.descricao
  }

  isSavingServico.value = true
  if (apiOnline.value) {
    try {
      if (selectedServico.value) {
        const res = await $fetch(`http://localhost:5000/api/v1/servicos/${servicoForm.value.id}`, {
          method: 'PUT',
          body: servicoForm.value
        })
        if (res.sucesso) {
          alert('Serviço atualizado com sucesso!')
          showServicoModal.value = false
          await loadServicos()
        } else {
          alert('Erro ao atualizar serviço: ' + (res.mensagem || 'erro desconhecido'))
        }
      } else {
        const res = await $fetch('http://localhost:5000/api/v1/servicos', {
          method: 'POST',
          body: servicoForm.value
        })
        if (res.sucesso) {
          alert('Serviço criado com sucesso!')
          showServicoModal.value = false
          await loadServicos()
        } else {
          alert('Erro ao criar serviço: ' + (res.mensagem || 'erro desconhecido'))
        }
      }
    } catch (e) {
      saveServicoLocal()
    }
  } else {
    saveServicoLocal()
  }
  isSavingServico.value = false
}

const saveServicoLocal = () => {
  const local = localStorage.getItem('mock_servicos')
  let items = local ? JSON.parse(local) : []
  if (selectedServico.value) {
    const idx = items.findIndex(x => x.id === servicoForm.value.id)
    if (idx !== -1) {
      items[idx] = { ...servicoForm.value }
    }
  } else {
    servicoForm.value.id = 's_' + Math.random().toString(36).substr(2, 9)
    items.push({ ...servicoForm.value })
  }
  localStorage.setItem('mock_servicos', JSON.stringify(items))
  alert('Serviço salvo localmente com sucesso!')
  showServicoModal.value = false
  loadServicos()
}

const deleteServico = async (id) => {
  if (!confirm('Deseja realmente excluir este serviço?')) return
  if (apiOnline.value) {
    try {
      const res = await $fetch(`http://localhost:5000/api/v1/servicos/${id}`, {
        method: 'DELETE'
      })
      if (res.sucesso) {
        alert('Serviço excluído com sucesso!')
        await loadServicos()
      } else {
        alert('Erro ao excluir serviço: ' + (res.mensagem || 'erro desconhecido'))
      }
    } catch (e) {
      deleteServicoLocal(id)
    }
  } else {
    deleteServicoLocal(id)
  }
}

const deleteServicoLocal = (id) => {
  const local = localStorage.getItem('mock_servicos')
  if (local) {
    let items = JSON.parse(local)
    items = items.filter(x => x.id !== id)
    localStorage.setItem('mock_servicos', JSON.stringify(items))
    alert('Serviço excluído localmente!')
    loadServicos()
  }
}

watch(cfopViewMode, () => {
  cfopPagina.value = 1
  loadCfops()
})

watch(fiscalSubTab, (newSub) => {
  if (newSub === 'cfops') {
    loadCfops()
  } else if (newSub === 'servicos') {
    loadServicos()
  } else if (newSub === 'contador') {
    loadContador()
  }
})

watch(currentTab, (newTab) => {
  if (newTab === 'configuracoes') {
    loadConfiguracoes()
  } else if (newTab === 'fiscal') {
    if (fiscalSubTab.value === 'cfops') loadCfops()
    else if (fiscalSubTab.value === 'servicos') loadServicos()
    else if (fiscalSubTab.value === 'contador') loadContador()
    else loadFiscal()
  }
})
</script>

