// Módulo 4: Fiscal
const loadFiscal = async () => {
  if (apiOnline.value) {
    try {
      const data = await $fetch('http://localhost:5000/api/v1/fiscal/documentos')
      const items = data.itens || data.dados?.itens || (Array.isArray(data) ? data : [])
      fiscal.value = items.map(d => ({
        id: d.id.substring(0, 8),
        type: d.modelo === 'NFCe' ? 'NFC-e (Cupom)' : 'NF-e (Nota)',
        itemsCount: d.itensCount || 1,
        date: new Date(d.dataEmissao).toLocaleDateString('pt-BR'),
        status: d.status || 'Rascunho',
        total: d.total,
        chaveAcesso: d.chaveAcesso,
        destinatario: d.destinatarioNome
      }))
    } catch (e) {
      loadMockFiscal()
    }
  } else {
    loadMockFiscal()
  }

  // Atualiza contadores
  fiscalDraftsCount.value = fiscal.value.filter(d => d.status === 'Rascunho').length
}

