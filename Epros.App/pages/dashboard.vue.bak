const submitCartaoForm = async () => {
  if (!cartaoForm.value.apelido || !cartaoForm.value.contaBancariaId) {
    alert('Erro: Preencha todos os campos obrigatórios (*).')
    return
  }

  const payload = {
    contaBancariaId: cartaoForm.value.contaBancariaId,
    apelido: cartaoForm.value.apelido,
    titular: cartaoForm.value.titular,
    bandeiraCartao: parseInt(cartaoForm.value.bandeiraCartao),
    observacao: cartaoForm.value.observacao
  }

  if (apiOnline.value) {
    try {
      if (isEditingCartao.value) {
        await $fetch(`http://localhost:5000/api/v1/cartoes-credito/${cartaoForm.value.id}`, {
          method: 'PUT',
          body: { id: cartaoForm.value.id, ...payload }
        })
