    const allFaturas = JSON.parse(localStorage.getItem('epros_faturas_cartoes') || '[]')
    const newId = Math.random().toString()
    
    const newFatura = {
      id: newId,
      cartaoDeCreditoId: lancarFaturaForm.value.cartaoDeCreditoId,
