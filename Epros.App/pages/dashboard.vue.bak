  bancoForm.value = {
    id: null,
    bancoId: defaultBancosLookup.value[0]?.id || '',
    tipoContaBancaria: 1,
    apelido: '',
    titular: '',
    agencia: '',
    conta: '',
    gerente: '',
    foneGerente: '',
    detalhe: '',
    digitoAgencia: '0',
    dataEncerramento: null
  }
  isEditingBanco.value = false
  showBancoForm.value = true
}

const openEditBancoForm = (banco) => {
  bancoForm.value = { ...banco }
  isEditingBanco.value = true
  showBancoForm.value = true
}

const submitBancoForm = async () => {
  if (!bancoForm.value.apelido || !bancoForm.value.conta) {
    alert('Erro: Preencha todos os campos obrigatórios (*).')
    return
  }

  const payload = {
    bancoId: bancoForm.value.bancoId,
    tipoContaBancaria: parseInt(bancoForm.value.tipoContaBancaria),
    apelido: bancoForm.value.apelido,
    titular: bancoForm.value.titular,
    agencia: bancoForm.value.agencia,
    conta: bancoForm.value.conta,
    gerente: bancoForm.value.gerente,
    foneGerente: bancoForm.value.foneGerente,
    detalhe: bancoForm.value.detalhe,
    digitoAgencia: bancoForm.value.digitoAgencia,
    dataEncerramento: bancoForm.value.dataEncerramento ? new Date(bancoForm.value.dataEncerramento).toISOString() : null
  }

  if (apiOnline.value) {
    try {
      if (isEditingBanco.value) {
        await $fetch(`http://localhost:5000/api/v1/contas-bancarias/${bancoForm.value.id}`, {
          method: 'PUT',
          body: { id: bancoForm.value.id, ...payload }
        })
      } else {
        await $fetch('http://localhost:5000/api/v1/contas-bancarias', {
          method: 'POST',
          body: payload
        })
      }
      showBancoForm.value = false
      await loadContasBancarias()
    } catch (e) {
      alert('Erro ao salvar conta bancária no servidor.')
    }
  } else {
    const dbBancos = JSON.parse(localStorage.getItem('epros_contas_bancarias') || '[]')
    const selectedBancoName = defaultBancosLookup.value.find(b => b.id === bancoForm.value.bancoId)?.descricao || 'Banco Simulado'
    
    if (isEditingBanco.value) {
      const idx = dbBancos.findIndex(b => b.id === bancoForm.value.id)
      if (idx !== -1) {
        dbBancos[idx] = { ...bancoForm.value, bancoDescricao: selectedBancoName }
      }
    } else {
      const newId = Math.random().toString()
      dbBancos.push({
        id: newId,
        bancoDescricao: selectedBancoName,
        ...bancoForm.value
      })
    }
    
    localStorage.setItem('epros_contas_bancarias', JSON.stringify(dbBancos))
    bancosList.value = dbBancos
    showBancoForm.value = false
    alert('Conta bancária salva localmente (offline)!')
  }
}

