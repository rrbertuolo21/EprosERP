        await $fetch('http://localhost:5000/api/v1/cartoes-credito', {
          method: 'POST',
          body: payload
        })
      }
      showCartaoForm.value = false
      await loadCartoesDeCredito()
    } catch (e) {
      alert('Erro ao salvar cartão de crédito no servidor.')
    }
  } else {
    const dbCartoes = JSON.parse(localStorage.getItem('epros_cartoes_credito') || '[]')
    const selectedContaName = bancosList.value.find(b => b.id === cartaoForm.value.contaBancariaId)?.apelido || 'Conta Simulado'
    
    if (isEditingCartao.value) {
      const idx = dbCartoes.findIndex(c => c.id === cartaoForm.value.id)
      if (idx !== -1) {
        dbCartoes[idx] = { ...cartaoForm.value, contaApelido: selectedContaName }
      }
    } else {
      const newId = Math.random().toString()
      dbCartoes.push({
        id: newId,
        contaApelido: selectedContaName,
        ...cartaoForm.value
      })
    }
    
    localStorage.setItem('epros_cartoes_credito', JSON.stringify(dbCartoes))
    cartoesList.value = dbCartoes
    showCartaoForm.value = false
    alert('Cartão de crédito salvo localmente (offline)!')
  }
}

