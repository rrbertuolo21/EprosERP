  isEditingProduct.value = false
  productForm.value = {
    id: null,
    codigo: '',
    descricao: '',
    ean: '',
    valorVenda: 0,
    valorVendaPrazo: 0,
    valorCompra: 0,
    pesoLiquido: 0,
    pesoBruto: 0,
    ativo: true,
    utilizaBalanca: false,
    codigoProdutoBalanca: '',
    balancaId: '4fa85f64-5717-4562-b3fc-2c963f66afa6'
  }
  showProductForm.value = true
}

const openEditProductForm = (prod) => {
  isEditingProduct.value = true
  productForm.value = {
    id: prod.id,
    codigo: prod.sku,
    descricao: prod.name,
    ean: prod.ean || '',
    valorVenda: prod.price,
    valorVendaPrazo: prod.valorVendaPrazo || prod.price,
    valorCompra: prod.valorCompra || 0,
    pesoLiquido: prod.pesoLiquido || 0,
    pesoBruto: prod.pesoBruto || 0,
    ativo: prod.ativo ?? true,
    utilizaBalanca: prod.utilizaBalanca ?? false,
    codigoProdutoBalanca: prod.codigoProdutoBalanca || '',
    balancaId: prod.balancaId || '4fa85f64-5717-4562-b3fc-2c963f66afa6'
  }
  showProductForm.value = true
}

const submitProductForm = async () => {
  if (productForm.value.utilizaBalanca && !/^\d+$/.test(productForm.value.codigoProdutoBalanca)) {
    alert('Erro: O código do produto na balança deve conter apenas dígitos.')
    return
  }

  if (apiOnline.value) {
    try {
      if (isEditingProduct.value) {
        // Atualizar
        const command = {
          id: productForm.value.id,
          categoriaId: null,
          marcaProdutoId: null,
          unidadeMedidaComercialId: null,
          codigo: productForm.value.codigo,
          descricao: productForm.value.descricao,
          ean: productForm.value.ean,
          pesoLiquido: productForm.value.pesoLiquido,
          pesoBruto: productForm.value.pesoBruto,
          valorVenda: productForm.value.valorVenda,
          valorVendaPrazo: productForm.value.valorVendaPrazo || productForm.value.valorVenda,
          valorCompra: productForm.value.valorCompra,
          tipoProduto: 1,
          ativo: productForm.value.ativo,
          cestId: null,
          codigoAnpId: null,
          balancaId: productForm.value.utilizaBalanca ? productForm.value.balancaId : null,
          utilizaBalanca: productForm.value.utilizaBalanca,
          codigoProdutoBalanca: productForm.value.utilizaBalanca ? productForm.value.codigoProdutoBalanca : null,
          ncmId: null
        }

        await $fetch(`http://localhost:5000/api/v1/estoque/produtos/${productForm.value.id}`, {
          method: 'PUT',
          body: command
        })

        alert('Produto atualizado com sucesso!')
      } else {
        // Criar
        const command = {
          categoriaId: null,
          marcaProdutoId: null,
          unidadeMedidaComercialId: null,
          codigo: productForm.value.codigo,
          descricao: productForm.value.descricao,
          ean: productForm.value.ean,
          pesoLiquido: productForm.value.pesoLiquido,
          pesoBruto: productForm.value.pesoBruto,
          valorVenda: productForm.value.valorVenda,
          valorVendaPrazo: productForm.value.valorVendaPrazo || productForm.value.valorVenda,
          valorCompra: productForm.value.valorCompra,
          tipoProduto: 1,
          ativo: productForm.value.ativo,
          imagem: '',
          cestId: null,
          codigoAnpId: null,
          balancaId: productForm.value.utilizaBalanca ? productForm.value.balancaId : null,
          utilizaBalanca: productForm.value.utilizaBalanca,
          codigoProdutoBalanca: productForm.value.utilizaBalanca ? productForm.value.codigoProdutoBalanca : null,
          ncmId: null
        }

        await $fetch('http://localhost:5000/api/v1/estoque/produtos', {
          method: 'POST',
          body: command
        })

        alert('Produto cadastrado com sucesso!')
      }
      showProductForm.value = false
      await loadProducts()
    } catch (e) {
      console.error(e)
      alert('Erro ao salvar produto no servidor.')
    }
  } else {
    // Modo Simulação Offline
    if (isEditingProduct.value) {
      const idx = products.value.findIndex(p => p.id === productForm.value.id || p.sku === productForm.value.codigo)
      if (idx !== -1) {
        products.value[idx] = {
          ...products.value[idx],
          name: productForm.value.descricao,
          price: productForm.value.valorVenda,
          ean: productForm.value.ean,
          pesoLiquido: productForm.value.pesoLiquido,
          pesoBruto: productForm.value.pesoBruto,
          ativo: productForm.value.ativo,
          utilizaBalanca: productForm.value.utilizaBalanca,
          codigoProdutoBalanca: productForm.value.codigoProdutoBalanca
        }
      }
      alert('Produto atualizado na simulação!')
    } else {
      products.value.unshift({
        id: Math.random().toString(),
        sku: productForm.value.codigo,
        name: productForm.value.descricao,
        price: productForm.value.valorVenda,
        stock: 0,
        cost: productForm.value.valorCompra,
        ean: productForm.value.ean,
        pesoLiquido: productForm.value.pesoLiquido,
        pesoBruto: productForm.value.pesoBruto,
        ativo: productForm.value.ativo,
        utilizaBalanca: productForm.value.utilizaBalanca,
        codigoProdutoBalanca: productForm.value.codigoProdutoBalanca
      })
      alert('Produto criado na simulação!')
    }
    showProductForm.value = false
    lowStockCount.value = products.value.filter(p => p.stock < 50).length
  }
}

const deleteProduct = async (prod) => {
  if (!confirm(`Deseja realmente excluir o produto "${prod.name}"?`)) return

  if (apiOnline.value) {
    try {
      await $fetch(`http://localhost:5000/api/v1/estoque/produtos/${prod.id}`, {
        method: 'DELETE'
      })
      alert('Produto excluído com sucesso!')
      await loadProducts()
    } catch (e) {
      console.error(e)
      alert('Erro ao excluir produto no servidor.')
    }
  } else {
    // Offline Simulation
    products.value = products.value.filter(p => p.sku !== prod.sku)
    lowStockCount.value = products.value.filter(p => p.stock < 50).length
    alert('Produto removido da simulação!')
  }
}

