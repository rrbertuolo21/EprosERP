      if (resUni && resUni.sucesso) unidades.value = resUni.dados || []

      const resConv = await $fetch('http://localhost:5000/api/v1/configuracoes/conversoes')
      if (resConv && resConv.sucesso) conversoes.value = resConv.dados || []

      const resProj = await $fetch('http://localhost:5000/api/v1/configuracoes/projetos')
