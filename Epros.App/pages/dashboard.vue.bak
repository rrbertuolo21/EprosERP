const submitLancarFatura = async () => {
  if (lancarFaturaForm.value.valor <= 0) {
    alert('Erro: O valor do lançamento deve ser maior que zero.')
    return
  }

  const payload = {
    dataLancamento: new Date(lancarFaturaForm.value.dataLancamento).toISOString(),
    dataVencimento: new Date(lancarFaturaForm.value.dataVencimento).toISOString(),
    valor: parseFloat(lancarFaturaForm.value.valor),
