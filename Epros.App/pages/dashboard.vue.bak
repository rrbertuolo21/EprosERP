const submitFinanceForm = async () => {
  if (financeForm.value.valor <= 0) {
    alert('Erro: O valor do título deve ser maior que zero.')
    return
  }

  if (apiOnline.value) {
    try {
      const endpoint = financeForm.value.tipo === 'Pagar' 
        ? 'http://localhost:5000/api/v1/financeiro/contas-pagar'
        : 'http://localhost:5000/api/v1/financeiro/contas-receber'

      const command = {
        descricao: financeForm.value.descricao,
        valor: financeForm.value.valor,
        dataVencimento: new Date(financeForm.value.dataVencimento).toISOString(),
        numeroDocumento: financeForm.value.numeroDocumento,
        categoria: financeForm.value.categoria,
        fornecedorId: financeForm.value.tipo === 'Pagar' ? '4fa85f64-5717-4562-b3fc-2c963f66afa6' : undefined,
        clienteId: financeForm.value.tipo === 'Receber' ? '4fa85f64-5717-4562-b3fc-2c963f66afa6' : undefined
      }

      await $fetch(endpoint, {
        method: 'POST',
        body: command
      })

      alert('Título financeiro cadastrado com sucesso!')
      showFinanceForm.value = false
      await loadFinance()
    } catch (e) {
      console.error(e)
      alert('Erro ao cadastrar título no servidor.')
    }
  } else {
    // Offline Mock Mode
    const mockId = (financeForm.value.tipo === 'Pagar' ? 'PAG-' : 'REC-') + Math.floor(1000 + Math.random() * 9000)
    finance.value.unshift({
      id: mockId,
      description: financeForm.value.descricao,
      dueDate: new Date(financeForm.value.dataVencimento).toLocaleDateString('pt-BR'),
      amount: financeForm.value.valor,
      type: financeForm.value.tipo,
      status: 'Pendente'
    })
    showFinanceForm.value = false
    
    // Atualiza totais
    receivablesTotal.value = finance.value.filter(f => f.type === 'Receber' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
    payablesTotal.value = finance.value.filter(f => f.type === 'Pagar' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
    
    alert('Título financeiro criado no modo de simulação!')
  }
}

const openPaymentModal = (item) => {
