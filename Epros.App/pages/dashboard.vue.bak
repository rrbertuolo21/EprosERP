      valor: parseFloat(lancarFaturaForm.value.valor),
      pago: lancarFaturaForm.value.pago
    }
    
    allFaturas.push(newFatura)
    localStorage.setItem('epros_faturas_cartoes', JSON.stringify(allFaturas))
    
    faturasList.value.push(newFatura)
    showLancarFaturaForm.value = false
