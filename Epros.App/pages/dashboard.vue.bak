// Caixa e PDV Frente de Caixa
const checkCaixaStatus = async () => {
  const opId = 'operador-padrao'
  if (apiOnline.value) {
    try {
      const data = await $fetch(`http://localhost:5000/api/v1/vendas/caixas/status?operadorId=${opId}`)
      if (data && data.dados && data.dados.status === 'Aberto') {
        activeCaixa.value = {
          id: data.dados.id,
          operadorId: data.dados.operadorId,
          saldoAbertura: data.dados.saldoAbertura,
          criadoEm: data.dados.criadoEm
        }
        await loadCaixaDetails()
      } else {
        activeCaixa.value = null
      }
    } catch (e) {
      activeCaixa.value = null
    }
  } else {
    // Simulação local do caixa
    const local = localStorage.getItem('active_caixa')
    if (local) {
      activeCaixa.value = JSON.parse(local)
      await loadCaixaDetails()
    } else {
      activeCaixa.value = null
    }
  }
}

const loadCaixaDetails = async () => {
  if (!activeCaixa.value) return

  if (apiOnline.value) {
    try {
      const data = await $fetch(`http://localhost:5000/api/v1/vendas/caixas/${activeCaixa.value.id}/detalhado`)
      activeCaixaDetails.value = data?.dados || data
    } catch (e) {
      // Fallback local se falhar
      calculateLocalCaixaDetails()
    }
  } else {
    calculateLocalCaixaDetails()
  }
}

const calculateLocalCaixaDetails = () => {
  if (!activeCaixa.value) return
  
  const totalVendas = sales.value
    .filter(s => s.status !== 'Cancelada')
    .reduce((sum, s) => sum + s.total, 0)

  const totalVendasDinheiro = sales.value
    .filter(s => s.status !== 'Cancelada' && s.payment === 'Dinheiro')
    .reduce((sum, s) => sum + s.total, 0)

  const movimentosLocais = JSON.parse(localStorage.getItem(`caixa_movs_${activeCaixa.value.id}`) || '[]')
  const totalSuprimentos = movimentosLocais.filter(m => m.tipo === 'Suprimento').reduce((sum, m) => sum + m.valor, 0)
  const totalSangrias = movimentosLocais.filter(m => m.tipo === 'Sangria').reduce((sum, m) => sum + m.valor, 0)

  activeCaixaDetails.value = {
    saldoAbertura: activeCaixa.value.saldoAbertura,
    totalVendasDinheiro: totalVendasDinheiro,
    totalSuprimentos: totalSuprimentos,
    totalSangrias: totalSangrias,
    saldoCalculadoDinheiro: activeCaixa.value.saldoAbertura + totalVendasDinheiro + totalSuprimentos - totalSangrias
  }
}

const handleOpenCaixa = async () => {
  const opId = 'operador-padrao'
  const payload = {
    operadorId: opId,
    saldoAbertura: parseFloat(openingBalance.value)
  }

  if (apiOnline.value) {
    try {
      const res = await $fetch('http://localhost:5000/api/v1/vendas/caixas/abrir', {
        method: 'POST',
        body: payload
      })
      if (res.sucesso) {
        alert('Caixa aberto com sucesso no servidor!')
        activeCaixa.value = {
          id: res.dados.caixaId,
          operadorId: opId,
          saldoAbertura: payload.saldoAbertura,
          criadoEm: new Date().toISOString()
        }
        await loadCaixaDetails()
      }
    } catch (e) {
      alert('Erro ao abrir caixa no servidor.')
    }
  } else {
    // Offline local open
    const newId = Math.random().toString()
    const session = {
      id: newId,
      operadorId: opId,
      saldoAbertura: payload.saldoAbertura,
      criadoEm: new Date().toISOString()
    }
    localStorage.setItem('active_caixa', JSON.stringify(session))
    activeCaixa.value = session
    await loadCaixaDetails()
    alert('Caixa aberto localmente (modo de simulação)!')
  }
}

const openMovement = (tipo) => {
  movementType.value = tipo
  movementAmount.value = 0.0
  movementObservation.value = ''
  showMovementForm.value = true
}

const submitMovementForm = async () => {
  if (movementAmount.value <= 0) {
    alert('Erro: O valor deve ser maior que zero.')
    return
  }

  const payload = {
    caixaId: activeCaixa.value.id,
    tipo: movementType.value,
    valor: parseFloat(movementAmount.value),
    observacao: movementObservation.value
  }

  if (apiOnline.value) {
    try {
      await $fetch('http://localhost:5000/api/v1/vendas/caixas/movimentar', {
        method: 'POST',
        body: payload
      })
      alert(`${movementType.value} registrado com sucesso!`)
      showMovementForm.value = false
      await loadCaixaDetails()
    } catch (e) {
      alert('Erro ao registrar movimentação no servidor.')
    }
  } else {
    // Offline local simulation
    const movimentosLocais = JSON.parse(localStorage.getItem(`caixa_movs_${activeCaixa.value.id}`) || '[]')
    movimentosLocais.push({
      id: Math.random().toString(),
      tipo: movementType.value,
      valor: payload.valor,
      observacao: payload.observacao,
      criadoEm: new Date().toISOString()
    })
    localStorage.setItem(`caixa_movs_${activeCaixa.value.id}`, JSON.stringify(movimentosLocais))
    
    alert(`${movementType.value} registrado localmente (simulado).`)
    showMovementForm.value = false
    await loadCaixaDetails()
  }
}

const showCloseCaixa = async () => {
  await loadCaixaDetails()
  physicalCashCount.value = activeCaixaDetails.value ? activeCaixaDetails.value.saldoCalculadoDinheiro : 0
  showCloseCaixaForm.value = true
}

const submitCloseCaixa = async () => {
  const payload = {
    caixaId: activeCaixa.value.id,
    saldoFechamento: parseFloat(physicalCashCount.value)
  }

  if (apiOnline.value) {
    try {
      await $fetch('http://localhost:5000/api/v1/vendas/caixas/fechar', {
        method: 'POST',
        body: payload
      })
      alert('Caixa fechado com sucesso!')
      showCloseCaixaForm.value = false
      activeCaixa.value = null
      activeCaixaDetails.value = null
    } catch (e) {
      alert('Erro ao fechar caixa no servidor.')
    }
  } else {
    // Offline local simulation
    localStorage.removeItem('active_caixa')
    const diff = payload.saldoFechamento - activeCaixaDetails.value.saldoCalculadoDinheiro
    alert(`Caixa fechado na simulação! Diferença de fechamento calculada: ${formatAmount(diff)}`)
    showCloseCaixaForm.value = false
    activeCaixa.value = null
    activeCaixaDetails.value = null
  }
}

const addCartItem = () => {
  const productSelect = document.getElementById('pdvProductSelect')
  const qtyInput = document.getElementById('pdvQtyInput')
  if (!productSelect || !qtyInput) return

  const sku = productSelect.value
  const qty = parseInt(qtyInput.value)

  if (!sku) {
    alert('Por favor, selecione um produto.')
    return
  }
  if (qty <= 0) {
    alert('A quantidade deve ser maior que zero.')
    return
  }

  const p = products.value.find(prod => prod.sku === sku)
  if (!p) return

  const existing = pdvCart.value.find(item => item.sku === sku)
  if (existing) {
    existing.qty += qty
  } else {
    pdvCart.value.push({
      productId: p.id,
      sku: p.sku,
      name: p.name,
      price: p.price,
      qty: qty,
      cost: p.cost || 0
    })
  }

  // Reset controls
  productSelect.value = ''
  qtyInput.value = '1'
}

const removeCartItem = (idx) => {
  pdvCart.value.splice(idx, 1)
}

const handleConfirmPdvSale = async () => {
  if (pdvCart.value.length === 0) {
    alert('Erro: O carrinho de compras está vazio.')
    return
  }

  const payload = {
    caixaId: activeCaixa.value.id,
    total: parseFloat(pdvCartTotal.value),
    status: 'Emitida', // Emitida (ou Contingencia) faturada automaticamente
    modeloFiscal: 65, // NFC-e
    naturezaOperacao: 'Venda de Mercadorias',
    dataVenda: new Date().toISOString(),
    formaPagamento: pdvPaymentMethod.value,
    valorDesconto: parseFloat(pdvDiscount.value),
    itens: pdvCart.value.map(i => ({
      produtoId: i.productId,
      quantidade: parseFloat(i.qty),
      precoUnitario: parseFloat(i.price),
      codigoProduto: i.sku,
      descricaoProduto: i.name,
      ncm: '22030000',
      cfop: 5102,
      unidadeComercial: 'UN',
      valorCusto: parseFloat(i.cost)
    }))
  }

  if (apiOnline.value) {
    try {
      await $fetch('http://localhost:5000/api/v1/vendas', {
        method: 'POST',
        body: payload
      })
      alert('Venda e cupom fiscal NFC-e gerados com sucesso!')
      pdvCart.value = []
      pdvDiscount.value = 0.0
      await loadSales()
      await loadProducts()
      await loadCaixaDetails()
      await loadFinance()
      await loadFiscal()
    } catch (e) {
      alert('Erro ao registrar venda no servidor.')
    }
  } else {
    // Simulação local offline
    const saleId = Math.random().toString()
    
    // Diminuir estoques
    payload.itens.forEach(item => {
      const prod = products.value.find(p => p.sku === item.codigoProduto)
      if (prod) {
        prod.stock = Math.max(0, prod.stock - item.quantidade)
      }
    })

    // Adicionar faturamento financeiro (Contas a Receber)
    finance.value.unshift({
      id: Math.random().toString(),
      description: `Venda PDV Ref ${saleId.substring(0, 8)}`,
      amount: payload.total,
      dueDate: new Date().toISOString(),
      status: 'Pago',
      type: 'Receber',
      category: 'Receita de Vendas'
    })

    sales.value.unshift({
      id: saleId,
      date: new Date().toLocaleDateString('pt-BR'),
      customer: 'Consumidor Balcão',
      total: payload.total,
      payment: payload.formaPagamento,
      status: 'Faturada'
    })

    // Adicionar documento fiscal NFC-e simulado
    fiscal.value.unshift({
      id: Math.random().toString(),
      numeroNota: Math.floor(1000 + Math.random() * 9000).toString(),
      chaveAcesso: '3526' + Math.floor(100000 + Math.random() * 900000) + '0001995500100001234567890',
      clienteNome: 'Consumidor Balcão',
      dataEmissao: new Date().toISOString(),
      valorTotal: payload.total,
      tipoDocumento: 'NFC-e',
      status: 'Autorizada'
    })

    alert('Venda faturada com sucesso (modo de simulação)! Estoques e documentos atualizados localmente.')
    pdvCart.value = []
    pdvDiscount.value = 0.0
    lowStockCount.value = products.value.filter(p => p.stock < 50).length
    await loadCaixaDetails()
  }
}

