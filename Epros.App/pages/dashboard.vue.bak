            <div class="form-group" style="flex: 2; min-width: 250px; margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Incidência Simples Nacional *</label>
              <select v-model="cfopForm.incidenciaSimples" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option :value="1">1 - Revenda de Produtos Industrializados</option>
                <option :value="2">2 - Revenda de Mercadorias</option>
                <option :value="3">3 - Locação Bens Móveis</option>
                <option :value="4">4 - Serviço de Transporte de Cargas</option>
                <option :value="5">5 - Serviço de Comunicação</option>
                <option :value="6">6 - Prestação de Serviços</option>
                <option :value="7">7 - Exterior</option>
                <option :value="9">9 - Não se Aplica</option>
              </select>
            </div>
          </div>

          <!-- Descricao -->
          <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Descrição Completa *</label>
            <textarea v-model="cfopForm.descricao" placeholder="Escreva a descrição do CFOP..." required style="width: 100%; height: 80px; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px; resize: vertical;"></textarea>
          </div>

          <!-- Checkboxes de Flags (Indicadores) -->
          <label style="font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; display: block;">Parâmetros e Indicadores Fiscais</label>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; margin-bottom: 20px; background: rgba(24, 24, 27, 0.4); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer;">
