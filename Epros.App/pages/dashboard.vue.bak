        if (idx !== -1) list[idx] = currentImposto.value
      } else {
        currentImposto.value.id = Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join('')
        list.push(currentImposto.value)
      }
      localStorage.setItem('epros_simulated_impostos', JSON.stringify(list))
      impostos.value = list
      showImpostoForm.value = false
      alert('Imposto salvo (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Falha ao salvar imposto: ' + (e.data?.mensagem || e.message))
  }
}

const deleteImposto = async (id, nome) => {
  if (nome.includes('Em Uso')) {
    alert('Erro de integridade: Este imposto está vinculado a transações fiscais/vendas e não pode ser excluído.')
    return
  }

  if (!confirm(`Deseja realmente excluir o imposto "${nome}"?`)) return

  try {
    if (apiOnline.value) {
      const res = await $fetch(`http://localhost:5000/api/v1/configuracoes/impostos/${id}`, {
        method: 'DELETE'
      })
      if (res && res.sucesso) {
        alert('Imposto excluído!')
        await loadAuxiliares()
      } else {
        alert('Erro ao excluir: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      let list = JSON.parse(localStorage.getItem('epros_simulated_impostos') || '[]')
      list = list.filter(i => i.id !== id)
      localStorage.setItem('epros_simulated_impostos', JSON.stringify(list))
      impostos.value = list
      alert('Imposto excluído (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Falha ao excluir imposto: ' + (e.data?.mensagem || e.message))
  }
}

const toggleApiKeyVisibility = () => {
  showApiKeyText.value = !showApiKeyText.value
}

const copyApiKeyToClipboard = () => {
  if (apiKeyData.value.key) {
    navigator.clipboard.writeText(apiKeyData.value.key)
    alert('Chave de API copiada para a área de transferência!')
  }
}

const rotateApiKey = async () => {
  isRotatingKey.value = true
  try {
    if (apiOnline.value && currentUserId.value) {
      const payload = {
        usuarioId: currentUserId.value,
        rateLimit: apiKeySetup.value.rateLimit,
        validadeDias: apiKeySetup.value.validityDays
      }
      const res = await $fetch('http://localhost:5000/api/v1/aplicativo/usuarios/api-key/gerar', {
        method: 'POST',
        body: payload
      })
      
      if (res && res.sucesso) {
        alert('Chave de API rotacionada com sucesso no servidor!')
        await loadConfiguracoes()
      } else {
        alert('Erro ao rotacionar chave: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      const randomKey = Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join('')
      const created = new Date().toISOString()
      const expiry = new Date()
      expiry.setDate(expiry.getDate() + apiKeySetup.value.validityDays)
      
      apiKeyData.value = {
        key: 'epros_live_' + randomKey,
        rateLimit: apiKeySetup.value.rateLimit,
        createdDate: created,
        expirationDate: expiry.toISOString(),
        lastUsedDate: null
      }
      localStorage.setItem('epros_simulated_api_key', JSON.stringify(apiKeyData.value))
      alert('Chave de API gerada com sucesso (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Erro ao rotacionar chave de API: ' + (e.data?.mensagem || e.message))
  } finally {
    isRotatingKey.value = false
  }
}

const revokeApiKey = async () => {
  if (!confirm('Tem certeza de que deseja revogar a chave de API ativa? Todos os sistemas que a utilizam perderão o acesso imediatamente.')) return
  isRotatingKey.value = true
  try {
    if (apiOnline.value && currentUserId.value) {
      const payload = {
        usuarioId: currentUserId.value
      }
      const res = await $fetch('http://localhost:5000/api/v1/aplicativo/usuarios/api-key/revogar', {
        method: 'POST',
        body: payload
      })
      if (res && res.sucesso) {
        alert('Chave de API revogada com sucesso no servidor!')
        await loadConfiguracoes()
      } else {
        alert('Erro ao revogar chave: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      apiKeyData.value = {
        key: null,
        rateLimit: 60,
        createdDate: null,
        expirationDate: null,
        lastUsedDate: null
      }
      localStorage.setItem('epros_simulated_api_key', JSON.stringify(apiKeyData.value))
      alert('Chave de API revogada com sucesso (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Erro ao revogar chave de API: ' + (e.data?.mensagem || e.message))
  } finally {
    isRotatingKey.value = false
  }
}

// Módulo Fiscal Avançado: CFOPs
const loadCfops = async () => {
  if (cfopViewMode.value === 'padrao') {
    await loadCfopPadrao()
    return
  }
  if (apiOnline.value) {
    try {
      const queryParams = new URLSearchParams({
        localizar: cfopLocalizar.value,
        pagina: cfopPagina.value.toString(),
        tamanhoPagina: cfopTamanhoPagina.value.toString()
      })
      const data = await $fetch(`http://localhost:5000/api/v1/cfops?${queryParams}`)
      cfopsList.value = data.dados?.itens || data.itens || []
      cfopTotal.value = data.dados?.total || data.total || 0
    } catch (e) {
      loadMockCfops()
    }
  } else {
    loadMockCfops()
  }
}

const loadCfopPadrao = async () => {
  if (apiOnline.value) {
    try {
      const queryParams = new URLSearchParams({
        localizar: cfopLocalizar.value,
        pagina: '1',
        tamanhoPagina: '50'
      })
      const data = await $fetch(`http://localhost:5000/api/v1/cfop-padrao?${queryParams}`)
      cfopPadraoList.value = data.dados?.itens || data.itens || []
    } catch (e) {
      loadMockCfopPadraos()
    }
  } else {
    loadMockCfopPadraos()
  }
}

const loadMockCfops = () => {
  const local = localStorage.getItem('mock_cfops')
  if (local) {
    const items = JSON.parse(local)
    let filtered = items
    if (cfopLocalizar.value) {
      filtered = items.filter(c => 
        c.descricao.toLowerCase().includes(cfopLocalizar.value.toLowerCase()) || 
        c.cfopCodigo.toString().includes(cfopLocalizar.value)
      )
    }
    cfopsList.value = filtered.slice((cfopPagina.value - 1) * cfopTamanhoPagina.value, cfopPagina.value * cfopTamanhoPagina.value)
    cfopTotal.value = filtered.length
  } else {
    const defaults = [
      { id: '1', cfopCodigo: 1102, descricao: 'Compra para comercialização', naturezaOperacao: 'Compra', cfopCorrelacao: '1102', integraFaturamento: true, indicadorNfe: true, indicadorNfce: false, incidenciaSimples: 9, cfopDevolucao: '5202' },
      { id: '2', cfopCodigo: 5102, descricao: 'Venda de mercadoria adquirida de terceiros', naturezaOperacao: 'Venda', cfopCorrelacao: '5102', integraFaturamento: true, indicadorNfe: true, indicadorNfce: true, incidenciaSimples: 2, cfopDevolucao: '1202' }
    ]
    localStorage.setItem('mock_cfops', JSON.stringify(defaults))
    cfopsList.value = defaults
    cfopTotal.value = defaults.length
  }
}

