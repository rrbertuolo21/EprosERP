            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer;">
              <input type="checkbox" v-model="cfopForm.indicadorRetorno" /> Retorno
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer;">
              <input type="checkbox" v-model="cfopForm.indicadorUsoConsumo" /> Uso e Consumo
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer;">
