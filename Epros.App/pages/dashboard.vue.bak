              <input type="text" v-model="cfopForm.naturezaOperacao" placeholder="Ex: Venda de mercadoria" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
