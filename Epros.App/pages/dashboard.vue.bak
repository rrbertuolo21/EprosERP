const saveConversao = async () => {
  try {
    if (apiOnline.value) {
      const res = await $fetch('http://localhost:5000/api/v1/configuracoes/conversoes', {
        method: 'POST',
        body: {
          unidadeOrigemId: currentConversao.value.unidadeOrigemId,
          unidadeDestinoId: currentConversao.value.unidadeDestinoId,
          fator: currentConversao.value.fator
        }
      })
      if (res && res.sucesso) {
        alert('Regra de conversão salva!')
        showConversaoForm.value = false
        await loadAuxiliares()
      } else {
        alert('Erro ao salvar: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      let list = JSON.parse(localStorage.getItem('epros_simulated_conversoes') || '[]')
      const origemOpt = unidades.value.find(u => u.id === currentConversao.value.unidadeOrigemId)
      const destinoOpt = unidades.value.find(u => u.id === currentConversao.value.unidadeDestinoId)

      const nova = {
        id: Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join(''),
        unidadeOrigemId: currentConversao.value.unidadeOrigemId,
        unidadeOrigemNome: origemOpt ? origemOpt.nome : 'Origem',
        unidadeDestinoId: currentConversao.value.unidadeDestinoId,
        unidadeDestinoNome: destinoOpt ? destinoOpt.nome : 'Destino',
        fator: currentConversao.value.fator
      }
      
      list.push(nova)
      localStorage.setItem('epros_simulated_conversoes', JSON.stringify(list))
      conversoes.value = list
      showConversaoForm.value = false
      alert('Regra de conversão salva (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Falha ao salvar conversão: ' + (e.data?.mensagem || e.message))
  }
}

