            <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-top: 25px;">
              <input type="checkbox" id="srv-iss" v-model="servicoForm.indicadorIss" style="width: 16px; height: 16px;" />
              <label for="srv-iss" style="margin: 0; font-size: 12.5px;">Incidência de ISSQN</label>
            </div>
            <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-top: 25px;">
              <input type="checkbox" id="srv-ret" v-model="servicoForm.calcularRetencao" style="width: 16px; height: 16px;" />
              <label for="srv-ret" style="margin: 0; font-size: 12.5px;">Calcular Retenções Fiscais</label>
            </div>
          </div>

          <div style="display: flex; gap: 15px; margin-top: 25px; border-top: 1px solid var(--border-color); padding-top: 15px;">
            <button type="button" @click="showServicoModal = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              ❌ Cancelar
            </button>
            <button type="submit" :disabled="isSavingServico" class="btn btn-success" style="flex: 1;">
              {{ isSavingServico ? 'Processando...' : '💾 Salvar Serviço' }}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Cadastro / Edição de CFOP -->
    <div v-if="showCfopModal" class="welcome-overlay">
