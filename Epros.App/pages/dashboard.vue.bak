const simulateXmlUpload = () => {
  let mockChave = '3526' + Math.floor(10000000 + Math.random() * 90000000) + '000199550010000' + Math.floor(10000 + Math.random() * 90000) + '1234567890'
  mockChave = mockChave.substring(0, 44)

  const fornecedoresMock = [
    { nome: 'Distribuidora Heineken Brasil S/A', cnpj: '17215903000140' },
    { nome: 'FrigoEstrela Alimentos S/A', cnpj: '48372619000102' },
    { nome: 'Empório de Cereais São Paulo Ltda', cnpj: '10928374000185' }
  ]
  const forn = fornecedoresMock[Math.floor(Math.random() * fornecedoresMock.length)]

  const selectedItens = []
  if (products.value.length > 0) {
    const count = Math.min(3, products.value.length)
    const shuffled = [...products.value].sort(() => 0.5 - Math.random())
    for (let i = 0; i < count; i++) {
      const p = shuffled[i]
      const qtd = Math.floor(20 + Math.random() * 80)
      const cost = parseFloat((p.cost || p.price * 0.6).toFixed(2))
      selectedItens.push({
        sku: p.sku,
        quantidade: qtd,
        precoUnitario: cost,
        valorIms: parseFloat((cost * 0.18).toFixed(2)),
        valorIpi: parseFloat((cost * 0.05).toFixed(2))
      })
    }
  } else {
    selectedItens.push({
      sku: 'PROD-001',
      quantidade: 50,
      precoUnitario: 10.50,
      valorIms: 1.89,
      valorIpi: 0.50
    })
  }

  const total = selectedItens.reduce((sum, item) => sum + (item.quantidade * item.precoUnitario), 0)

  purchaseForm.value = {
    fornecedorCnpj: forn.cnpj,
    fornecedorNome: forn.nome,
    numeroNota: Math.floor(10000 + Math.random() * 90000).toString(),
    dataEmissao: new Date().toISOString().substring(0, 10),
    valorTotal: parseFloat(total.toFixed(2)),
    chaveAcesso: mockChave,
    itens: selectedItens
  }

  alert('XML carregado com sucesso! Dados importados para o formulário.')
}

const submitPurchaseForm = async () => {
  if (purchaseForm.value.chaveAcesso.length !== 44) {
    alert('Erro: A chave de acesso fiscal deve conter exatamente 44 caracteres.')
    return
  }
  if (purchaseForm.value.itens.length === 0) {
    alert('Erro: A nota fiscal de compra deve conter ao menos um item.')
    return
  }

  const payload = {
    fornecedorCnpj: purchaseForm.value.fornecedorCnpj,
    fornecedorNome: purchaseForm.value.fornecedorNome,
    numeroNota: purchaseForm.value.numeroNota,
    chaveAcesso: purchaseForm.value.chaveAcesso,
    valorTotal: purchaseForm.value.valorTotal,
    dataEmissao: new Date(purchaseForm.value.dataEmissao).toISOString(),
    itens: purchaseForm.value.itens.map(i => ({
      sku: i.sku,
      nomeProduto: products.value.find(p => p.sku === i.sku)?.name || 'Produto Compra',
      quantidade: parseFloat(i.quantidade),
      precoUnitario: parseFloat(i.precoUnitario),
      valorIms: parseFloat(i.valorIms || 0),
      valorIpi: parseFloat(i.valorIpi || 0)
    }))
  }

  if (apiOnline.value) {
    try {
      await $fetch('http://localhost:5000/api/v1/estoque/compras/lancar', {
        method: 'POST',
        body: payload
      })
      alert('Nota de Compra lançada e faturada com sucesso!')
      showPurchaseForm.value = false
      await loadPurchases()
      await loadProducts()
    } catch (e) {
      console.error(e)
      alert('Erro ao lançar compra no servidor.')
    }
  } else {
    // Simulação Offline
    const newPurchaseId = Math.random().toString()
    const newItems = payload.itens.map(i => ({
      sku: i.sku,
      nomeProduto: i.nomeProduto,
      quantidade: i.quantidade,
      precoUnitario: i.precoUnitario,
      valorIms: i.valorIms,
      valorIpi: i.valorIpi
    }))

    newItems.forEach(item => {
      const prod = products.value.find(p => p.sku === item.sku)
      if (prod) {
        const currentTotalCost = prod.stock * (prod.cost || 0)
        const newTotalCost = item.quantidade * item.precoUnitario
        prod.stock += item.quantidade
        prod.cost = parseFloat(((currentTotalCost + newTotalCost) / prod.stock).toFixed(2))
      }
    })

    finance.value.unshift({
      id: Math.random().toString(),
      description: `Compra NF-e ${purchaseForm.value.numeroNota} - ${purchaseForm.value.fornecedorNome}`,
      amount: purchaseForm.value.valorTotal,
      dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
      status: 'pendente',
      type: 'pagar',
      category: 'Mercadorias para Revenda'
    })

    purchases.value.unshift({
      id: newPurchaseId,
      numeroNota: purchaseForm.value.numeroNota,
      chaveAcesso: purchaseForm.value.chaveAcesso,
      fornecedorNome: purchaseForm.value.fornecedorNome,
      fornecedorCnpj: purchaseForm.value.fornecedorCnpj,
      dataEmissao: new Date(purchaseForm.value.dataEmissao).toISOString(),
      valorTotal: purchaseForm.value.valorTotal,
      status: 'Lancada',
      itens: newItems
    })

    alert('Compra lançada com sucesso (modo de simulação)! Estoques e custos recalculados locally.')
    showPurchaseForm.value = false
    lowStockCount.value = products.value.filter(p => p.stock < 50).length
  }
}

const openDetailPurchase = async (compra) => {
  if (apiOnline.value) {
    try {
      const data = await $fetch(`http://localhost:5000/api/v1/estoque/compras/${compra.id}`)
      selectedPurchase.value = data?.dados || data
    } catch (e) {
      selectedPurchase.value = compra
    }
  } else {
    selectedPurchase.value = compra
  }
  showPurchaseDetail.value = true
}

const cancelPurchase = async (compra) => {
  const motivo = prompt('Digite o motivo do cancelamento da compra (mínimo 10 caracteres):')
  if (!motivo) return
  if (motivo.length < 10) {
    alert('Erro: O motivo do cancelamento deve possuir pelo menos 10 caracteres.')
    return
  }

  if (apiOnline.value) {
    try {
      await $fetch(`http://localhost:5000/api/v1/estoque/compras/${compra.id}/cancelar`, {
        method: 'POST',
        body: { motivo }
      })
      alert('Nota de compra cancelada com sucesso!')
      await loadPurchases()
      await loadProducts()
    } catch (e) {
      console.error(e)
      alert('Erro ao cancelar nota de compra no servidor.')
    }
  } else {
    // Offline Simulation
    const idx = purchases.value.findIndex(p => p.id === compra.id)
    if (idx !== -1) {
      purchases.value[idx].status = 'Cancelada'
      
      purchases.value[idx].itens.forEach(item => {
        const prod = products.value.find(p => p.sku === item.sku)
        if (prod) {
          prod.stock = Math.max(0, prod.stock - item.quantidade)
        }
      })
    }
    alert('Nota de compra cancelada na simulação!')
    lowStockCount.value = products.value.filter(p => p.stock < 50).length
  }
}

// Helpers e watchers
watch(estoqueSubTab, (newVal) => {
  if (newVal === 'compras') {
    loadPurchases()
  }
})

watch(vendasSubTab, (newVal) => {
  if (newVal === 'pdv') {
    checkCaixaStatus()
  } else if (newVal === 'historico') {
    loadSales()
  }
})

watch(currentTab, (newVal) => {
  if (newVal === 'vendas') {
    loadSales()
    checkCaixaStatus()
  }
})

const formatCnpj = (cnpj) => {
  if (!cnpj) return ''
  const clean = cnpj.replace(/\D/g, '')
  if (clean.length !== 14) return cnpj
  return clean.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, "$1.$2.$3/$4-$5")
}

const formatDate = (dateStr) => {
  if (!dateStr) return ''
  const d = new Date(dateStr)
  return d.toLocaleDateString('pt-BR')
}

