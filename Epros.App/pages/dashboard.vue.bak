    { id: 'p3', cfopCodigo: 5101, descricao: 'Venda de produção do estabelecimento', naturezaOperacao: 'Venda', cfopCorrelacao: '5101', integraFaturamento: true, indicadorNfe: true, incidenciaSimples: 1, cfopDevolucao: '1201' },
