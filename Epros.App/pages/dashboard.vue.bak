// Helpers
const formatAmount = (val) => {
  return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val)
}

const getFinanceBadge = (status) => {
  if (status === 'Pago') return 'badge-paga'
  if (status === 'Atrasado') return 'badge-atrasada'
  return 'badge-pendente'
}

const getFiscalBadge = (status) => {
  if (status === 'Autorizada' || status === 'Autorizado') return 'badge-paga'
  if (status === 'Rejeitada' || status === 'Rejeitado') return 'badge-atrasada'
  if (status === 'Cancelada' || status === 'Cancelado') return 'badge-cancelada'
  return 'badge-pendente' // Rascunho, Pendente
}

const getSaleBadge = (status) => {
  if (status === 'Faturada' || status === 'Emitida') return 'badge-paga'
  if (status === 'Cancelada') return 'badge-cancelada'
  return 'badge-pendente'
}

const cancelSale = async (vendaId) => {
  const motivo = prompt('Por favor, informe o motivo do cancelamento da venda (mínimo 10 caracteres):')
  if (motivo === null) return // Clicou em cancelar

  if (motivo.trim().length < 10) {
    alert('Erro: O motivo do cancelamento deve possuir pelo menos 10 caracteres.')
    return
  }

  if (!apiOnline.value) {
    const saleIndex = sales.value.findIndex(s => s.id === vendaId)
    if (saleIndex !== -1) {
      sales.value[saleIndex] = {
        ...sales.value[saleIndex],
        status: 'Cancelada'
      }
      alert('Venda cancelada com sucesso (Modo Simulação)!')
    }
    return
  }

  try {
    await $fetch(`http://localhost:5000/api/v1/vendas/${vendaId}/cancelar`, {
      method: 'POST',
      body: { motivo: motivo.trim() }
    })
    
    alert('Venda cancelada com sucesso! O estorno de estoque, financeiro e fiscal foi enfileirado para processamento.')
    await loadSales()
  } catch (error) {
    console.error('Erro ao cancelar venda:', error)
    alert('Falha ao cancelar a venda no servidor. Detalhes: ' + (error.data?.mensagem || error.message))
  }
}

// Métodos de Negócio de Configurações
const decodeJwt = (token) => {
  try {
    const base64Url = token.split('.')[1]
    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
    const jsonPayload = decodeURIComponent(atob(base64).split('').map((c) => {
      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
    }).join(''))
    return JSON.parse(jsonPayload)
  } catch (e) {
    console.error('Falha ao decodificar JWT nativamente:', e)
    return null
  }
}

const formatDateForInput = (isoString) => {
  if (!isoString) return null
  return isoString.split('T')[0]
}

const mapStockModeToApi = (modeStr) => {
  if (modeStr === 'CustoMedio') return 1
  if (modeStr === 'FIFO') return 2
  if (modeStr === 'Ultimo') return 3
  return 1
}

const mapStockModeFromApi = (modeVal) => {
  if (modeVal === 1 || modeVal === '1') return 'CustoMedio'
  if (modeVal === 2 || modeVal === '2') return 'FIFO'
  if (modeVal === 3 || modeVal === '3') return 'Ultimo'
  return modeVal || 'CustoMedio'
}

const loadConfiguracoes = async () => {
  const storedUser = localStorage.getItem('epros_user')
  if (!storedUser) return
  const parsedUser = JSON.parse(storedUser)

  await loadGlobais()

  if (apiOnline.value) {
    try {
      const token = localStorage.getItem('epros_token')
      if (token) {
        const decoded = decodeJwt(token)
        if (decoded && decoded.sub) {
          currentUserId.value = decoded.sub
          
          const userDetail = await $fetch(`http://localhost:5000/api/v1/aplicativo/usuarios/${decoded.sub}`)
          if (userDetail) {
            apiKeyData.value = {
              key: userDetail.apiKey || null,
              rateLimit: userDetail.apiKeyRateLimit || 60,
              createdDate: userDetail.apiKeyCreated || null,
              expirationDate: userDetail.apiKeyExpiration || null,
              lastUsedDate: userDetail.apiKeyLastUsed || null
            }
            
            if (userDetail.empresas && userDetail.empresas.length > 0) {
              currentEmpresaId.value = userDetail.empresas[0].empresaId
            }
          }
        }
      }

      let empresaData = null
      try {
        const resEmp = await $fetch('http://localhost:5000/api/v1/configuracoes/empresa')
        if (resEmp && resEmp.sucesso && resEmp.dados) {
          empresaData = resEmp.dados
        }
      } catch (err) {
        console.warn('Erro ao obter empresa pela rota padrão, tentando obter por ID...', err)
      }

      if (empresaData) {
        companySettings.value = {
          empresaId: empresaData.id,
          razaoSocial: empresaData.razaoSocial || '',
          nomeFantasia: empresaData.nomeFantasia || '',
          cnpj: empresaData.cnpj || '',
          inscricaoEstadual: empresaData.inscricaoEstadual || '',
          inscricaoMunicipal: empresaData.inscricaoMunicipal || '',
          inscricaoSuframa: empresaData.inscricaoSuframa || '',
          cnae: empresaData.cnae || '',
          email: empresaData.email || '',
          telefone: empresaData.telefone || '',
          regimeTributario: empresaData.regimeTributario || 1,
          regimeApuracao: empresaData.regimeApuracao || 1,
          endereco: {
            cep: empresaData.endereco?.cep || '',
            logradouro: empresaData.endereco?.logradouro || '',
            numero: empresaData.endereco?.numero || '',
            complemento: empresaData.endereco?.complemento || '',
            bairro: empresaData.endereco?.bairro || '',
            cidade: empresaData.endereco?.cidade || '',
            estado: empresaData.endereco?.estado || ''
          },
          timeZoneId: empresaData.timeZoneId || null,
          dateFormat: empresaData.dateFormat || 'DD-MM-YYYY',
          currencyId: empresaData.currencyId || null,
          logo: empresaData.logo || '',
          favicon: empresaData.favicon || ''
        }
        currentEmpresaId.value = empresaData.id
      }

      const resPref = await $fetch('http://localhost:5000/api/v1/configuracoes/preferencias')
      if (resPref && resPref.sucesso && resPref.dados) {
        preferencias.value = {
          showCurrency: resPref.dados.showCurrency,
          negativeCash: resPref.dados.negativeCash,
          negativeStock: resPref.dados.negativeStock,
          stockCalculationMode: mapStockModeFromApi(resPref.dados.stockCalculationMode),
          creditLimit: resPref.dados.creditLimit,
          discount: resPref.dados.discount,
          vatOnPurchase: resPref.dados.vatOnPurchase,
          vatOnSales: resPref.dados.vatOnSales
        }
        preferenciasOriginal.value = JSON.parse(JSON.stringify(preferencias.value))
      }

      const resMail = await $fetch('http://localhost:5000/api/v1/configuracoes/email')
      if (resMail && resMail.sucesso && resMail.dados) {
        emailConfig.value = {
          host: resMail.dados.host || '',
          port: resMail.dados.port || 587,
          username: resMail.dados.username || '',
          password: resMail.dados.password || '',
          fromEmail: resMail.dados.fromEmail || ''
        }
      }

      await loadAuxiliares()
      return
    } catch (e) {
      console.warn('Erro ao carregar configurações online, caindo de volta para simulação...', e)
    }
  }

  loadSimulatedConfiguracoes(parsedUser)
}

