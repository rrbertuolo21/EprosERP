<template>
  <div class="dashboard-layout">
    <!-- Cabeçalho Compartilhado -->
    <AppHeader />

    <!-- Área Operacional ERP -->
    <div class="workspace-wrapper">
      <!-- Sidebar Menu Lateral -->
      <aside class="sidebar-menu glass-panel">
        <nav class="sidebar-nav">
          <button 
            @click="currentTab = 'overview'" 
            :class="['sidebar-item', { 'active': currentTab === 'overview' }]"
          >
            <span class="icon">📊</span> Visão Geral
          </button>
          
          <button 
            @click="currentTab = 'estoque'" 
            :class="['sidebar-item', { 'active': currentTab === 'estoque' }]"
          >
            <span class="icon">📦</span> Estoque & Produtos
          </button>

          <button 
            @click="currentTab = 'vendas'" 
            :class="['sidebar-item', { 'active': currentTab === 'vendas' }]"
          >
            <span class="icon">🛒</span> Vendas & PDV
          </button>

          <button 
            @click="currentTab = 'financeiro'" 
            :class="['sidebar-item', { 'active': currentTab === 'financeiro' }]"
          >
            <span class="icon">💸</span> Financeiro (CP/CR)
          </button>

          <button 
            @click="currentTab = 'fiscal'" 
            :class="['sidebar-item', { 'active': currentTab === 'fiscal' }]"
          >
            <span class="icon">🧾</span> Notas Fiscais (DFe)
          </button>

          <button 
            @click="currentTab = 'pessoas'" 
            :class="['sidebar-item', { 'active': currentTab === 'pessoas' }]"
          >
            <span class="icon">👥</span> Pessoas & Contatos
          </button>

          <button 
            @click="currentTab = 'configuracoes'" 
            :class="['sidebar-item', { 'active': currentTab === 'configuracoes' }]"
          >
            <span class="icon">⚙️</span> Configurações
          </button>
        </nav>

        <!-- Informações do Tenant Conectado -->
        <footer class="sidebar-footer" v-if="user">
          <span class="status-connection">
            <span class="status-dot"></span>
            {{ apiOnline ? 'API Conectada' : 'Modo Demonstrativo' }}
          </span>
          <span class="tenant-id-label">Tenant: {{ user.tenantId }}</span>
        </footer>
      </aside>

      <!-- Seção Principal de Conteúdo -->
      <main class="workspace-main">
        <!-- RENDER: Visão Geral -->
        <div v-if="currentTab === 'overview'" class="tab-content animate-fade">
          <header class="tab-header">
            <h2>Visão Geral do Negócio</h2>
            <p>Painel consolidado das operações comerciais e fiscais do inquilino.</p>
          </header>

          <!-- KPIs Rápidos -->
          <section class="overview-kpis">
            <div class="overview-kpi glass-panel">
              <span class="kpi-icon">💰</span>
              <div class="kpi-info">
                <span class="label">Contas a Receber</span>
                <span class="value">{{ formatAmount(receivablesTotal) }}</span>
              </div>
            </div>
            <div class="overview-kpi glass-panel">
              <span class="kpi-icon">📉</span>
              <div class="kpi-info">
                <span class="label">Contas a Pagar</span>
                <span class="value">{{ formatAmount(payablesTotal) }}</span>
              </div>
            </div>
            <div class="overview-kpi glass-panel">
              <span class="kpi-icon">📦</span>
              <div class="kpi-info">
                <span class="label">Alerta de Estoque Baixo</span>
                <span class="value danger-text">{{ lowStockCount }} itens</span>
              </div>
            </div>
            <div class="overview-kpi glass-panel">
              <span class="kpi-icon">🧾</span>
              <div class="kpi-info">
                <span class="label">Rascunhos NFC-e</span>
                <span class="value">{{ fiscalDraftsCount }} rascunhos</span>
              </div>
            </div>
          </section>

          <!-- Gráfico Simulado & Atividades -->
          <div class="overview-charts-grid">
            <div class="chart-box glass-panel">
              <h4>Desempenho de Vendas Semanais</h4>
              
              <!-- Gráfico Premium SVG CSS-Based -->
              <div class="svg-chart-container">
                <svg viewBox="0 0 500 150" class="svg-chart">
                  <!-- Grids horizontais -->
                  <line x1="0" y1="30" x2="500" y2="30" stroke="rgba(255,255,255,0.03)" />
                  <line x1="0" y1="75" x2="500" y2="75" stroke="rgba(255,255,255,0.03)" />
                  <line x1="0" y1="120" x2="500" y2="120" stroke="rgba(255,255,255,0.03)" />
                  
                  <!-- Área com gradiente de Vendas -->
                  <path d="M 0 150 L 50 110 L 120 125 L 200 60 L 280 85 L 360 40 L 440 50 L 500 20 L 500 150 Z" fill="url(#chartGrad)" opacity="0.1" />
                  <!-- Linha principal das vendas -->
                  <path d="M 0 150 L 50 110 L 120 125 L 200 60 L 280 85 L 360 40 L 440 50 L 500 20" fill="none" stroke="var(--primary)" stroke-width="3" />
                  
                  <!-- Gradientes -->
                  <defs>
                    <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--primary)" />
                      <stop offset="100%" stop-color="var(--primary)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                </svg>
              </div>

              <div class="chart-labels">
                <span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span>
              </div>
            </div>

            <!-- Últimas Atividades / Notificações -->
            <div class="recent-events-box glass-panel">
              <h4>Atividades Recentes do Inquilino</h4>
              <ul class="events-list">
                <li>
                  <span class="event-bullet success-bg"></span>
                  <div class="event-details">
                    <p>Caixa do terminal <strong>PDV-01</strong> fechado com sucesso.</p>
                    <span>Há 15 minutos</span>
                  </div>
                </li>
                <li>
                  <span class="event-bullet info-bg"></span>
                  <div class="event-details">
                    <p>Venda <strong>VEN-8813</strong> sincronizada com sucesso para a nuvem.</p>
                    <span>Há 1 hora</span>
                  </div>
                </li>
                <li>
                  <span class="event-bullet success-bg"></span>
                  <div class="event-details">
                    <p>Lançamento de <strong>ContaReceber</strong> gerado via Outbox para faturamento.</p>
                    <span>Há 2 horas</span>
                  </div>
                </li>
                <li>
                  <span class="event-bullet danger-bg"></span>
                  <div class="event-details">
                    <p>NFC-e <strong>DFE-90215</strong> rejeitada pela SEFAZ (Erro de tributação ICMS).</p>
                    <span>Ontem</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- RENDER: Estoque -->
        <div v-else-if="currentTab === 'estoque'" class="tab-content animate-fade">
          <header class="tab-header">
            <div class="header-action-wrapper">
              <div>
                <h2>Produtos & Controle de Estoque</h2>
                <p>Monitore preços, quantidades e o Custo Médio Ponderado (CMP) dos itens.</p>
              </div>
              <div v-if="estoqueSubTab === 'produtos'" style="display: flex; gap: 8px;">
                <button @click="openNewProductForm" class="btn btn-primary">➕ Novo Produto</button>
                <button @click="loadProducts" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
              <div v-else-if="estoqueSubTab === 'compras'" style="display: flex; gap: 8px;">
                <button @click="openNewPurchaseForm" class="btn btn-primary">📥 Importar XML / Lançar Compra</button>
                <button @click="loadPurchases" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
            </div>
            
            <!-- Sub-Navegação interna de Estoque -->
            <div class="config-tabs-nav glass-panel" style="margin-top: 15px; margin-bottom: 5px; width: fit-content; padding: 4px; border-radius: 8px;">
              <button type="button" @click="estoqueSubTab = 'produtos'" :class="['tab-btn', { active: estoqueSubTab === 'produtos' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📦 Produtos Cadastrados
              </button>
              <button type="button" @click="estoqueSubTab = 'compras'" :class="['tab-btn', { active: estoqueSubTab === 'compras' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📥 Notas de Entrada (Compras)
              </button>
            </div>
          </header>

          <!-- Seção de Produtos -->
          <div v-if="estoqueSubTab === 'produtos'" class="table-container glass-panel">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Código / SKU</th>
                  <th>Nome do Produto</th>
                  <th>Preço de Venda</th>
                  <th>Qtd. Estoque</th>
                  <th>Custo Médio</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="prod in products" :key="prod.sku">
                  <td><span class="sku-badge">{{ prod.sku }}</span></td>
                  <td class="bold-text">{{ prod.name }}</td>
                  <td>{{ formatAmount(prod.price) }}</td>
                  <td :class="{ 'danger-text bold-text': prod.stock < 50 }">{{ prod.stock }} un</td>
                  <td>{{ formatAmount(prod.cost) }}</td>
                  <td>
                    <span :class="['badge', prod.stock < 50 ? 'badge-atrasada' : 'badge-paga']">
                      {{ prod.stock < 50 ? 'Estoque Baixo' : 'Normal' }}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button @click="openEditProductForm(prod)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; margin-right: 6px;">
                      ✏️ Editar
                    </button>
                    <button @click="deleteProduct(prod)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--danger); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                      🗑️ Excluir
                    </button>
                  </td>
                </tr>
                <tr v-if="products.length === 0">
                  <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhum produto cadastrado no estoque.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Seção de Notas de Entrada (Compras) -->
          <div v-else-if="estoqueSubTab === 'compras'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Nota / Chave</th>
                  <th>Fornecedor</th>
                  <th>Data Emissão</th>
                  <th>Valor Total</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="compra in purchases" :key="compra.id">
                  <td>
                    <div style="display: flex; flex-direction: column;">
                      <span class="bold-text">NF-e nº {{ compra.numeroNota }}</span>
                      <span style="font-size: 10.5px; color: var(--text-muted); font-family: monospace;">{{ compra.chaveAcesso }}</span>
                    </div>
                  </td>
                  <td class="bold-text">
                    <div style="display: flex; flex-direction: column;">
                      <span>{{ compra.fornecedorNome }}</span>
                      <span style="font-size: 10.5px; color: var(--text-muted);">CNPJ: {{ formatCnpj(compra.fornecedorCnpj) }}</span>
                    </div>
                  </td>
                  <td>{{ formatDate(compra.dataEmissao) }}</td>
                  <td class="bold-text">{{ formatAmount(compra.valorTotal) }}</td>
                  <td>
                    <span :class="['badge', compra.status === 'Cancelada' ? 'badge-atrasada' : 'badge-paga']">
                      {{ compra.status }}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button @click="openDetailPurchase(compra)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; margin-right: 6px;">
                      👁️ Detalhes
                    </button>
                    <button v-if="compra.status !== 'Cancelada'" @click="cancelPurchase(compra)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--danger); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                      🚫 Cancelar
                    </button>
                  </td>
                </tr>
                <tr v-if="purchases.length === 0">
                  <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhuma nota fiscal de compra lançada.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- RENDER: Vendas -->
        <div v-else-if="currentTab === 'vendas'" class="tab-content animate-fade">
          <header class="tab-header">
            <div class="header-action-wrapper">
              <div>
                <h2>Gestão de Vendas & PDV (Frente de Caixa)</h2>
                <p>Abra o caixa operador, realize suprimentos/sangrias, registre vendas e fature cupons fiscais.</p>
              </div>
              <div v-if="vendasSubTab === 'historico'" style="display: flex; gap: 8px;">
                <button @click="loadSales" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
            </div>

            <!-- Sub-Navegação interna de Vendas -->
            <div class="config-tabs-nav glass-panel" style="margin-top: 15px; margin-bottom: 5px; width: fit-content; padding: 4px; border-radius: 8px;">
              <button type="button" @click="vendasSubTab = 'historico'" :class="['tab-btn', { active: vendasSubTab === 'historico' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📈 Vendas Registradas
              </button>
              <button type="button" @click="vendasSubTab = 'pdv'" :class="['tab-btn', { active: vendasSubTab === 'pdv' }]" style="font-size: 12.5px; padding: 6px 16px;">
                🖥️ Terminal PDV / Frente de Caixa
              </button>
            </div>
          </header>

          <!-- Seção de Histórico de Vendas -->
          <div v-if="vendasSubTab === 'historico'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Venda ID</th>
                  <th>Data</th>
                  <th>Cliente</th>
                  <th>Valor Total</th>
                  <th>Forma Pagamento</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="sale in sales" :key="sale.id">
                  <td>
                    <span class="sku-badge" style="font-family: monospace;">{{ sale.id.substring(0, 8) }}</span>
                  </td>
                  <td>{{ sale.date }}</td>
                  <td>{{ sale.customer }}</td>
                  <td class="bold-text" style="color: var(--primary);">{{ formatAmount(sale.total) }}</td>
                  <td>{{ sale.payment }}</td>
                  <td>
                    <span :class="['badge', getSaleBadge(sale.status)]">
                      {{ sale.status }}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button v-if="sale.status !== 'Cancelada'" @click="cancelSale(sale.id)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: #ef4444; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                      🚫 Cancelar
                    </button>
                    <span v-else class="kpi-sub" style="font-size: 11px; opacity: 0.5;">Estornado</span>
                  </td>
                </tr>
                <tr v-if="sales.length === 0">
                  <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhuma venda registrada encontrada.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Seção Terminal PDV (Frente de Caixa) -->
          <div v-else-if="vendasSubTab === 'pdv'" class="animate-fade" style="display: flex; flex-direction: column; gap: 15px;">
            <!-- Caixa Fechado State -->
            <div v-if="!activeCaixa" class="glass-panel" style="padding: 40px; text-align: center; border-radius: 12px; display: flex; flex-direction: column; align-items: center; gap: 15px;">
              <span style="font-size: 48px;">🔒</span>
              <h3 style="font-size: 20px; font-weight: 600; color: var(--text-primary);">O Caixa do Operador está Fechado</h3>
              <p style="color: var(--text-secondary); max-width: 450px; font-size: 14px; line-height: 1.5;">
                Abra o caixa informando o saldo inicial em dinheiro para poder realizar vendas no Terminal PDV e registrar movimentações de suprimento e sangria.
              </p>
              
              <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 20px; border-radius: 10px; width: 320px; text-align: left; margin-top: 10px;">
                <label style="font-size: 11px; font-weight: 600; text-transform: uppercase; display: block; margin-bottom: 8px;">Saldo de Abertura (Dinheiro)</label>
                <input type="number" step="0.01" v-model="openingBalance" class="form-control" style="width: 100%; padding: 10px; font-size: 16px; font-weight: bold; background: #18181b; color: var(--text-primary); border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 15px;" />
                
                <button type="button" @click="handleOpenCaixa" class="btn btn-primary" style="width: 100%; font-size: 14px; padding: 10px; font-weight: 600;">
                  ⚡ Abrir Caixa do Operador
                </button>
              </div>
            </div>

            <!-- Caixa Aberto State -->
            <div v-else style="display: flex; gap: 20px;">
              <!-- Left Column: Checkout Cart -->
              <div class="glass-panel" style="flex: 2; padding: 20px; border-radius: 12px; display: flex; flex-direction: column; gap: 15px; height: 75vh;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                  <h3 style="font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    🛒 Carrinho de Compras do PDV
                  </h3>
                  <span style="font-size: 12px; color: var(--text-muted);">{{ pdvCart.length }} item(s)</span>
                </div>

                <!-- Select Product Selector -->
                <div style="display: flex; gap: 10px;">
                  <select id="pdvProductSelect" style="flex: 3; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                    <option value="">Selecione um produto para adicionar...</option>
                    <option v-for="p in products" :key="p.sku" :value="p.sku">{{ p.sku }} - {{ p.name }} (Qtd: {{ p.stock }} un) - {{ formatAmount(p.price) }}</option>
                  </select>
                  <input type="number" id="pdvQtyInput" min="1" value="1" style="width: 70px; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); text-align: center; font-size: 13.5px;" />
                  <button type="button" @click="addCartItem" class="btn btn-primary" style="margin: 0; padding: 0 18px;">
                    Adicionar
                  </button>
                </div>

                <!-- Cart Items List -->
                <div style="flex: 1; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px; background: rgba(0,0,0,0.1); padding: 8px;">
                  <div v-for="(item, idx) in pdvCart" :key="idx" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.03); font-size: 13px;">
                    <div>
                      <div class="bold-text">{{ item.name }}</div>
                      <div style="font-size: 11px; color: var(--text-secondary);">
                        {{ formatAmount(item.price) }} x {{ item.qty }} un
                      </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <div class="bold-text" style="color: var(--primary);">{{ formatAmount(item.price * item.qty) }}</div>
                      <button @click="removeCartItem(idx)" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 14px;">🗑️</button>
                    </div>
                  </div>
                  <div v-if="pdvCart.length === 0" style="text-align: center; color: var(--text-muted); padding: 40px; font-size: 13px;">
                    Carrinho vazio. Selecione um produto acima para iniciar a venda.
                  </div>
                </div>
              </div>

              <!-- Right Column: Totals & Caixa Operations -->
              <div style="flex: 1.1; display: flex; flex-direction: column; gap: 15px;">
                <!-- Active Caixa Header details -->
                <div class="glass-panel" style="padding: 15px; border-radius: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 12.5px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                    <span class="bold-text" style="color: var(--success); display: flex; align-items: center; gap: 6px;">🟢 CAIXA OPERADOR ABERTO</span>
                    <button @click="showCloseCaixa" class="btn btn-danger" style="margin: 0; padding: 4px 8px; font-size: 11px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Fechar Caixa</button>
                  </div>
                  <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-muted);">Operador:</span>
                    <span class="bold-text">{{ activeCaixa.operadorId }}</span>
                  </div>
                  <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-muted);">Saldo Abertura:</span>
                    <span class="bold-text">{{ formatAmount(activeCaixa.saldoAbertura) }}</span>
                  </div>
                  <div style="display: flex; justify-content: space-between;" v-if="activeCaixaDetails">
                    <span style="color: var(--text-muted);">Dinheiro em Caixa:</span>
                    <span class="bold-text" style="color: var(--success);">{{ formatAmount(activeCaixaDetails.saldoCalculadoDinheiro) }}</span>
                  </div>
                  
                  <!-- Suprimento / Sangria Buttons -->
                  <div style="display: flex; gap: 8px; margin-top: 5px;">
                    <button type="button" @click="openMovement('Suprimento')" class="btn btn-secondary" style="flex: 1; font-size: 11.5px; padding: 6px 0; margin: 0;">➕ Suprimento</button>
                    <button type="button" @click="openMovement('Sangria')" class="btn btn-secondary" style="flex: 1; font-size: 11.5px; padding: 6px 0; margin: 0; color: #ef4444; border-color: rgba(239, 68, 68, 0.1);">💸 Sangria</button>
                  </div>
                </div>

                <!-- Checkout details -->
                <div class="glass-panel" style="padding: 20px; border-radius: 12px; display: flex; flex-direction: column; gap: 15px;">
                  <h3 style="font-size: 15px; font-weight: 600; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">💳 Resumo e Pagamento</h3>
                  
                  <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13.5px;">
                    <div style="display: flex; justify-content: space-between;">
                      <span style="color: var(--text-secondary);">Subtotal:</span>
                      <span class="bold-text">{{ formatAmount(pdvCartSubtotal) }}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <span style="color: var(--text-secondary);">Desconto (R$):</span>
                      <input type="number" step="0.01" min="0" v-model="pdvDiscount" style="width: 80px; padding: 4px; background: #18181b; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); text-align: right;" />
                    </div>
                    <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 10px; font-size: 16px;">
                      <span class="bold-text">TOTAL FINAL:</span>
                      <span class="bold-text" style="color: var(--primary);">{{ formatAmount(pdvCartTotal) }}</span>
                    </div>
                  </div>

                  <!-- Payment Method -->
                  <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 5px;">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Forma de Pagamento</label>
                    <select v-model="pdvPaymentMethod" style="width: 100%; padding: 8px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                      <option value="Dinheiro">💵 Dinheiro</option>
                      <option value="Pix">⚡ Pix</option>
                      <option value="CartaoCredito">💳 Cartão de Crédito</option>
                      <option value="CartaoDebito">💳 Cartão de Débito</option>
                    </select>
                  </div>

                  <button type="button" @click="handleConfirmPdvSale" class="btn btn-success" style="width: 100%; font-size: 15px; padding: 12px; margin-top: 10px; font-weight: 600;">
                    🛒 Concluir Venda & Emitir NFC-e
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RENDER: Financeiro -->
        <div v-if="currentTab === 'financeiro'" class="tab-content animate-fade">
          <header class="tab-header">
            <div class="header-action-wrapper">
              <div>
                <h2>Módulo Financeiro Avançado</h2>
                <p>Gerencie fluxos de caixa, contas bancárias, cartões de crédito corporativos e reconciliação bancária.</p>
              </div>
              <div v-if="financeSubTab === 'contas'" style="display: flex; gap: 8px;">
                <button @click="openNewFinanceForm" class="btn btn-primary">➕ Novo Lançamento</button>
                <button @click="loadFinance" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
              <div v-else-if="financeSubTab === 'bancos'" style="display: flex; gap: 8px;">
                <button @click="openNewBancoForm" class="btn btn-primary">➕ Nova Conta Bancária</button>
                <button @click="loadContasBancarias" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
              <div v-else-if="financeSubTab === 'cartoes'" style="display: flex; gap: 8px;">
                <button @click="openNewCartaoForm" class="btn btn-primary">➕ Novo Cartão de Crédito</button>
                <button @click="loadCartoesDeCredito" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
            </div>

            <!-- Sub-Navegação interna de Financeiro -->
            <div class="config-tabs-nav glass-panel" style="margin-top: 15px; margin-bottom: 5px; width: fit-content; padding: 4px; border-radius: 8px;">
              <button type="button" @click="financeSubTab = 'contas'" :class="['tab-btn', { active: financeSubTab === 'contas' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📑 Contas Pagar & Receber
              </button>
              <button type="button" @click="financeSubTab = 'bancos'" :class="['tab-btn', { active: financeSubTab === 'bancos' }]" style="font-size: 12.5px; padding: 6px 16px;">
                🏦 Contas Bancárias
              </button>
              <button type="button" @click="financeSubTab = 'cartoes'" :class="['tab-btn', { active: financeSubTab === 'cartoes' }]" style="font-size: 12.5px; padding: 6px 16px;">
                💳 Cartões de Crédito
              </button>
              <button type="button" @click="financeSubTab = 'ofx'" :class="['tab-btn', { active: financeSubTab === 'ofx' }]" style="font-size: 12.5px; padding: 6px 16px;">
                🧾 Reconciliação OFX
              </button>
            </div>
          </header>

          <!-- ABA: Contas Pagar & Receber -->
          <div v-if="financeSubTab === 'contas'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Título</th>
                  <th>Descrição da Origem</th>
                  <th>Vencimento</th>
                  <th>Valor</th>
                  <th>Tipo</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="item in finance" :key="item.id">
                  <td><span class="sku-badge">{{ item.id }}</span></td>
                  <td>{{ item.description }}</td>
                  <td>{{ item.dueDate }}</td>
                  <td class="bold-text" :class="item.type === 'Pagar' ? 'danger-text' : 'success-text'">
                    {{ item.type === 'Pagar' ? '-' : '+' }} {{ formatAmount(item.amount) }}
                  </td>
                  <td>
                    <span :class="['type-badge', item.type === 'Pagar' ? 'pagar-type' : 'receber-type']">
                      {{ item.type }}
                    </span>
                  </td>
                  <td>
                    <span :class="['badge', getFinanceBadge(item.status)]">
                      {{ item.status }}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <template v-if="item.status === 'Pendente' || item.status === 'Atrasado'">
                      <button @click="openPaymentModal(item)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--success); border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.05); margin-right: 6px;">
                        💸 Baixar
                      </button>
                      <button @click="openCancelFinanceModal(item)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--danger); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                        🚫 Cancelar
                      </button>
                    </template>
                    <span v-else class="kpi-sub" style="font-size: 11px; opacity: 0.5;">{{ item.status }}</span>
                  </td>
                </tr>
                <tr v-if="finance.length === 0">
                  <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhum lançamento financeiro encontrado.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- ABA: Contas Bancárias -->
          <div v-else-if="financeSubTab === 'bancos'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Apelido</th>
                  <th>Banco</th>
                  <th>Tipo</th>
                  <th>Agência</th>
                  <th>Conta Corrente</th>
                  <th>Titular</th>
                  <th>Status</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="banco in bancosList" :key="banco.id">
                  <td class="bold-text">{{ banco.apelido }}</td>
                  <td>{{ banco.bancoDescricao || 'Banco Associado' }}</td>
                  <td>{{ tiposContaBancariaList.find(t => t.value === banco.tipoContaBancaria)?.text || 'Conta Corrente' }}</td>
                  <td>{{ banco.agencia }}<span v-if="banco.digitoAgencia">-{{ banco.digitoAgencia }}</span></td>
                  <td>{{ banco.conta }}</td>
                  <td>{{ banco.titular }}</td>
                  <td>
                    <span :class="['badge', banco.ativo ? 'badge-active' : 'badge-inactive']">
                      {{ banco.ativo ? 'Ativa' : 'Encerrada' }}
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <button @click="openEditBancoForm(banco)" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px; margin: 0; margin-right: 6px;">
                      ✏️ Editar
                    </button>
                    <button @click="deleteBanco(banco.id)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--danger); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                      🗑️ Excluir
                    </button>
                  </td>
                </tr>
                <tr v-if="bancosList.length === 0">
                  <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhuma conta bancária cadastrada.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- ABA: Cartões de Crédito -->
          <div v-else-if="financeSubTab === 'cartoes'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Apelido</th>
                  <th>Bandeira</th>
                  <th>Titular</th>
                  <th>Conta Bancária</th>
                  <th>Observações</th>
                  <th style="text-align: right;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="cartao in cartoesList" :key="cartao.id">
                  <td class="bold-text">{{ cartao.apelido }}</td>
                  <td>{{ bandeirasCartaoList.find(b => b.value === cartao.bandeiraCartao)?.text || 'Outra' }}</td>
                  <td>{{ cartao.titular }}</td>
                  <td>{{ cartao.contaApelido || 'Conta Associada' }}</td>
                  <td>{{ cartao.observacao }}</td>
                  <td style="text-align: right;">
                    <button @click="openFaturasModal(cartao)" class="btn btn-primary" style="padding: 4px 10px; font-size: 11px; margin: 0; margin-right: 6px;">
                      🧾 Faturas / Lançamentos
                    </button>
                    <button @click="openEditCartaoForm(cartao)" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px; margin: 0; margin-right: 6px;">
                      ✏️ Editar
                    </button>
                    <button @click="deleteCartao(cartao.id)" class="btn btn-secondary btn-header-refresh" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--danger); border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05);">
                      🗑️ Excluir
                    </button>
                  </td>
                </tr>
                <tr v-if="cartoesList.length === 0">
                  <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhum cartão de crédito cadastrado.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- ABA: Reconciliação OFX -->
          <div v-else-if="financeSubTab === 'ofx'" class="animate-fade" style="display: flex; flex-direction: column; gap: 20px;">
            <div class="glass-panel" style="padding: 25px; border-radius: 12px; display: flex; flex-direction: column; gap: 20px;">
              <h3>Processador de Extratos Bancários (OFX)</h3>
              <p style="color: var(--text-muted); font-size: 13.5px; margin-top: -10px;">
                Importe e reconcilie extratos no formato OFX para conciliação automática de títulos a pagar e receber.
              </p>

              <div class="form-grid-2">
                <div class="form-group">
                  <label>Conta Bancária para Reconciliação *</label>
                  <select v-model="ofxForm.contaBancariaId" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                    <option value="">Selecione uma conta bancária...</option>
                    <option v-for="c in bancosList" :key="c.id" :value="c.id">{{ c.apelido }} ({{ c.conta }})</option>
                  </select>
                </div>
                <div class="form-group" style="display: flex; align-items: flex-end;">
                  <button @click="processarOfx" class="btn btn-success" :disabled="isProcessingOfx" style="width: 100%; padding: 12px; font-size: 13.5px; font-weight: 600;">
                    {{ isProcessingOfx ? '⚙️ Processando extrato...' : '⚙️ Reconciliar Extrato' }}
                  </button>
                </div>
              </div>

              <div class="form-group">
                <label>Conteúdo do Arquivo Extrato OFX (XML)</label>
                <textarea v-model="ofxForm.ofxConteudo" rows="12" placeholder="Cole aqui o conteúdo xml do seu arquivo .ofx ou use o exemplo abaixo para testar...

Exemplo:
<OFX>
  <BANKMSGSRSV1>
    <STMTTRNRS>
      <STMTRS>
        <BANKTRANLIST>
          <STMTTRN>
            <TRNTYPE>DEBIT</TRNTYPE>
            <DTPOSTED>20260701120000</DTPOSTED>
            <TRNAMT>-1850.00</TRNAMT>
            <FITID>TXN1001</FITID>
            <MEMO>FORNECEDOR DE REFRESCOS MOCK</MEMO>
          </STMTTRN>
          <STMTTRN>
            <TRNTYPE>CREDIT</TRNTYPE>
            <DTPOSTED>20260702120000</DTPOSTED>
            <TRNAMT>124.50</TRNAMT>
            <FITID>TXN1002</FITID>
            <MEMO>RECEBIMENTO DE VENDA CLIENTE</MEMO>
          </STMTTRN>
        </BANKTRANLIST>
      </STMTRS>
    </STMTTRNRS>
  </BANKMSGSRSV1>
</OFX>" style="width: 100%; font-family: monospace; background: #121214; border: 1px solid var(--border-color); color: #22c55e; border-radius: 8px; padding: 12px; font-size: 12px; line-height: 1.5; resize: vertical;"></textarea>
              </div>
            </div>

            <!-- Resultados do OFX -->
            <div v-if="ofxResult" class="glass-panel animate-fade" style="padding: 25px; border-radius: 12px; display: flex; flex-direction: column; gap: 20px;">
              <h3 style="color: var(--success);">✅ Resultado do Processamento do OFX</h3>
              <div class="kpi-grid">
                <div class="kpi-card">
                  <span class="kpi-title">Total de Lançamentos</span>
                  <span class="kpi-value text-primary-gradient">{{ ofxResult.total }}</span>
                </div>
                <div class="kpi-card">
                  <span class="kpi-title">Reconciliados Automaticamente</span>
                  <span class="kpi-value text-success-gradient">{{ ofxResult.conciliados }}</span>
                </div>
                <div class="kpi-card">
                  <span class="kpi-title">Taxa de Sucesso</span>
                  <span class="kpi-value text-warning-gradient">{{ Math.round((ofxResult.conciliados / ofxResult.total) * 100) }}%</span>
                </div>
              </div>

              <div class="table-container">
                <table class="workspace-table">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th>Histórico / Memo</th>
                      <th>Valor</th>
                      <th>Status da Conciliação</th>
                      <th>Título Vinculado</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr v-for="(item, idx) in ofxResult.itens" :key="idx">
                      <td>{{ item.data }}</td>
                      <td>{{ item.memo }}</td>
                      <td class="bold-text" :class="item.valor < 0 ? 'danger-text' : 'success-text'">
                        {{ item.valor < 0 ? '-' : '+' }} {{ formatAmount(Math.abs(item.valor)) }}
                      </td>
                      <td>
                        <span :class="['badge', item.conciliado ? 'badge-active' : 'badge-inactive']">
                          {{ item.conciliado ? 'Conciliado ✅' : 'Ignorado ❌' }}
                        </span>
                      </td>
                      <td :style="{ opacity: item.conciliado ? 1 : 0.5 }">{{ item.descricao }}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- RENDER: Fiscal -->
        <div v-else-if="currentTab === 'fiscal'" class="tab-content animate-fade">
          <header class="tab-header">
            <div class="header-action-wrapper">
              <div>
                <h2>Módulo Fiscal — Documentos Eletrônicos (DFe)</h2>
                <p>Monitore a emissão de cupons (NFC-e) e notas fiscais (NF-e) geradas via Outbox.</p>
              </div>
              <div v-if="fiscalSubTab === 'documentos'" style="display: flex; gap: 8px;">
                <button @click="loadFiscal" class="btn btn-secondary btn-header-refresh">🔄 Atualizar</button>
              </div>
            </div>

            <!-- Sub-Navegação interna de Fiscal -->
            <div class="config-tabs-nav glass-panel" style="margin-top: 15px; margin-bottom: 5px; width: fit-content; padding: 4px; border-radius: 8px;">
              <button type="button" @click="fiscalSubTab = 'documentos'" :class="['tab-btn', { active: fiscalSubTab === 'documentos' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📄 Documentos Emitidos (NF-e / NFC-e)
              </button>
              <button type="button" @click="fiscalSubTab = 'cfops'" :class="['tab-btn', { active: fiscalSubTab === 'cfops' }]" style="font-size: 12.5px; padding: 6px 16px;">
                📚 Gerenciador de CFOPs
              </button>
              <button type="button" @click="fiscalSubTab = 'servicos'" :class="['tab-btn', { active: fiscalSubTab === 'servicos' }]" style="font-size: 12.5px; padding: 6px 16px;">
                🛠️ Serviços & ISSQN
              </button>
              <button type="button" @click="fiscalSubTab = 'contador'" :class="['tab-btn', { active: fiscalSubTab === 'contador' }]" style="font-size: 12.5px; padding: 6px 16px;">
                💼 Dados do Contador
              </button>
              <button type="button" @click="fiscalSubTab = 'certificado'" :class="['tab-btn', { active: fiscalSubTab === 'certificado' }]" style="font-size: 12.5px; padding: 6px 16px;">
                ⚙️ Configurações Fiscais (Certificado & SEFAZ)
              </button>
            </div>
          </header>

          <!-- Seção de Documentos Emitidos -->
          <div v-if="fiscalSubTab === 'documentos'" class="table-container glass-panel animate-fade">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th>Documento ID</th>
                  <th>Modelo / Tipo</th>
                  <th>Destinatário</th>
                  <th>Valor Total</th>
                  <th>Emissão</th>
                  <th>Status Sefaz</th>
                </tr>
              </thead>
              <tbody>
                <tr v-for="doc in fiscal" :key="doc.id">
                  <td>
                    <span class="sku-badge">{{ doc.id }}</span>
                    <div style="font-size: 10.5px; color: var(--text-muted); font-family: monospace; margin-top: 3px;" v-if="doc.chaveAcesso">{{ doc.chaveAcesso }}</div>
                  </td>
                  <td>{{ doc.type }}</td>
                  <td>{{ doc.destinatario || 'Consumidor Final' }}</td>
                  <td class="bold-text" style="color: var(--primary);">{{ formatAmount(doc.total || 0) }}</td>
                  <td>{{ doc.date }}</td>
                  <td>
                    <span :class="['badge', getFiscalBadge(doc.status)]">
                      {{ doc.status }}
                    </span>
                  </td>
                </tr>
                <tr v-if="fiscal.length === 0">
                  <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhum documento fiscal emitido.</td>
                </tr>
              </tbody>
            </table>
          </div>
 
          <!-- Seção de Gerenciamento de CFOPs -->
          <div v-else-if="fiscalSubTab === 'cfops'" class="animate-fade" style="display: flex; flex-direction: column; gap: 15px;">
            <!-- Menu interno da aba CFOP -->
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
              <div class="glass-panel" style="display: flex; padding: 4px; border-radius: 8px;">
                <button type="button" @click="cfopViewMode = 'cliente'" :class="['tab-btn', { active: cfopViewMode === 'cliente' }]" style="font-size: 11.5px; padding: 4px 12px; border-radius: 6px;">
                  📋 CFOPs do Cliente
                </button>
                <button type="button" @click="cfopViewMode = 'padrao'" :class="['tab-btn', { active: cfopViewMode === 'padrao' }]" style="font-size: 11.5px; padding: 4px 12px; border-radius: 6px;">
                  📚 Catálogo SEFAZ (Padrão)
                </button>
              </div>

              <div style="display: flex; gap: 8px; align-items: center;">
                <input type="text" v-model="cfopLocalizar" @input="debounceLoadCfops" placeholder="Buscar por código ou descrição..." class="input-search" style="padding: 6px 12px; font-size: 13px; width: 250px; background: rgba(24, 24, 27, 0.6); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary);" />
                <button v-if="cfopViewMode === 'cliente'" @click="openNewCfopModal" class="btn btn-primary" style="margin: 0; font-size: 12.5px; padding: 6px 14px;">
                  ➕ Novo CFOP
                </button>
              </div>
            </div>

            <!-- Tabela CFOPs do Cliente -->
            <div v-if="cfopViewMode === 'cliente'" class="table-container glass-panel animate-fade">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Natureza Operação</th>
                    <th>Correlação</th>
                    <th>Devolução</th>
                    <th>Incidência Simples</th>
                    <th style="text-align: right;">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="c in cfopsList" :key="c.id">
                    <td class="bold-text">{{ c.cfopCodigo }}</td>
                    <td>{{ c.descricao }}</td>
                    <td>{{ c.naturezaOperacao }}</td>
                    <td>{{ c.cfopCorrelacao }}</td>
                    <td>{{ c.cfopDevolucao || '-' }}</td>
                    <td>
                      <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">
                        {{ getIncidenciaSimplesDesc(c.incidenciaSimples) }}
                      </span>
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                      <button @click="openEditCfopModal(c)" class="btn btn-secondary" style="margin: 0 4px 0 0; padding: 4px 8px; font-size: 11px;">✏️ Editar</button>
                      <button @click="deleteCfop(c.id)" class="btn btn-danger" style="margin: 0; padding: 4px 8px; font-size: 11px; background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.4); color: #f87171;">🗑️ Excluir</button>
                    </td>
                  </tr>
                  <tr v-if="cfopsList.length === 0">
                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">Nenhum CFOP cadastrado.</td>
                  </tr>
                </tbody>
              </table>
              
              <!-- Paginação -->
              <div v-if="cfopTotal > cfopTamanhoPagina" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-top: 1px solid var(--border-color);">
                <span style="font-size: 12.5px; color: var(--text-muted);">Exibindo {{ cfopsList.length }} de {{ cfopTotal }} CFOPs</span>
                <div style="display: flex; gap: 8px;">
                  <button :disabled="cfopPagina === 1" @click="cfopPagina--; loadCfops()" class="btn btn-secondary" style="margin:0; padding: 4px 10px; font-size: 12px;">◀ Anterior</button>
                  <button :disabled="cfopPagina * cfopTamanhoPagina >= cfopTotal" @click="cfopPagina++; loadCfops()" class="btn btn-secondary" style="margin:0; padding: 4px 10px; font-size: 12px;">Próximo ▶</button>
                </div>
              </div>
            </div>

            <!-- Tabela CFOP Padrão (Referência) -->
            <div v-else-if="cfopViewMode === 'padrao'" class="table-container glass-panel animate-fade">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Natureza Operação</th>
                    <th>Correlação</th>
                    <th>Devolução</th>
                    <th>Incidência Simples</th>
                    <th style="text-align: right;">Opções</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="cp in cfopPadraoList" :key="cp.id">
                    <td class="bold-text">{{ cp.cfopCodigo }}</td>
                    <td>{{ cp.descricao }}</td>
                    <td>{{ cp.naturezaOperacao }}</td>
                    <td>{{ cp.cfopCorrelacao || '-' }}</td>
                    <td>{{ cp.cfopDevolucao || '-' }}</td>
                    <td>
                      <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                        {{ getIncidenciaSimplesDesc(cp.incidenciaSimples) }}
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <button @click="importCfopFromPadrao(cp)" class="btn btn-primary" style="margin: 0; padding: 4px 10px; font-size: 11px;">📥 Importar</button>
                    </td>
                  </tr>
                  <tr v-if="cfopPadraoList.length === 0">
                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">Nenhum CFOP padrão localizado.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Seção de Configurações Fiscais (Certificado & SEFAZ) -->
          <div v-else-if="fiscalSubTab === 'certificado'" class="glass-panel animate-fade" style="padding: 25px; border-radius: 12px; display: flex; flex-direction: column; gap: 20px;">
            <!-- Certificados Digitais A1 -->
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px;">
                <h3 style="font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                  🔑 Certificado Digital A1 (Criptografia SEFAZ)
                </h3>
                <button @click="showUploadCertificateForm = true" class="btn btn-primary" style="margin: 0; font-size: 12px; padding: 6px 12px;">
                  ➕ Carregar Certificado A1 (.PFX)
                </button>
              </div>

              <!-- Certificados List -->
              <div v-if="certificatesList.length > 0" style="display: flex; flex-direction: column; gap: 10px;">
                <div v-for="cert in certificatesList" :key="cert.id" class="form-grid-2" style="background: rgba(255,255,255,0.02); padding: 15px; border: 1px solid var(--border-color); border-radius: 8px; align-items: center;">
                  <div>
                    <div class="bold-text" style="font-size: 14px; color: var(--primary);">{{ cert.nomeSujeito }}</div>
                    <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">
                      CNPJ: {{ cert.cnpj }} | Série: {{ cert.numeroSerie }}
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                      Vencimento: {{ formatDate(cert.fimValidade) }} 
                      <span v-if="new Date(cert.fimValidade) < new Date()" style="color: var(--danger); font-weight: bold;">(EXPIRADO)</span>
                    </div>
                  </div>
                  <div style="text-align: right;">
                    <button @click="deleteCertificate(cert.id)" class="btn btn-danger" style="font-size: 12px; padding: 6px 12px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
                      🗑️ Remover Certificado
                    </button>
                  </div>
                </div>
              </div>
              <div v-else style="text-align: center; color: var(--text-muted); border: 1px dashed var(--border-color); padding: 30px; border-radius: 8px; font-size: 13.5px;">
                Nenhum certificado digital A1 carregado para esta empresa. A emissão de notas fiscais reais está suspensa.
              </div>
            </div>

            <!-- SEFAZ Environment Configuration & Series -->
            <div style="border-top: 1px solid var(--border-color); padding-top: 20px;">
              <h3 style="font-size: 15px; font-weight: 600; margin-bottom: 15px;">⚙️ Parâmetros de Emissão SEFAZ</h3>
              
              <form @submit.prevent="saveFiscalParameters" class="vertical-form">
                <div class="form-grid-3">
                  <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Ambiente SEFAZ</label>
                    <select v-model="defaultFiscalSetup.ambienteSefaz" style="width: 100%; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                      <option :value="1">1 - Produção (Notas Reais com Valor Fiscal)</option>
                      <option :value="2">2 - Homologação (Ambiente de Testes da SEFAZ)</option>
                    </select>
                  </div>
                </div>

                <div class="form-grid-4" style="margin-top: 10px;">
                  <div class="form-group">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Série NF-e (Mod. 55)</label>
                    <input type="number" v-model="defaultFiscalSetup.serieNFe" required style="width: 100%; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Próximo Nº NF-e</label>
                    <input type="number" v-model="defaultFiscalSetup.numeroNFe" required style="width: 100%; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Série NFC-e (Mod. 65)</label>
                    <input type="number" v-model="defaultFiscalSetup.serieNFCe" required style="width: 100%; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Próximo Nº NFC-e</label>
                    <input type="number" v-model="defaultFiscalSetup.numeroNFCe" required style="width: 100%; padding: 10px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div style="margin-top: 20px;">
                  <button type="submit" class="btn btn-success" style="padding: 10px 20px; font-size: 13.5px; margin: 0;">
                    💾 Salvar Configurações Fiscais
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Seção de Serviços & ISSQN -->
            <div v-else-if="fiscalSubTab === 'servicos'" class="animate-fade" style="display: flex; flex-direction: column; gap: 15px;">
              <div style="display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
                <div>
                  <h3 style="font-size: 15px; font-weight: 600;">🛠️ Catálogo de Serviços do Inquilino</h3>
                  <p style="font-size: 12.5px; color: var(--text-secondary);">Cadastre os serviços prestados, regras de ISSQN, NBS e anexos do Simples Nacional.</p>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                  <input type="text" v-model="servicoLocalizar" @input="loadServicos" placeholder="Buscar por código ou descrição..." class="input-search" style="padding: 6px 12px; font-size: 13px; width: 250px; background: rgba(24, 24, 27, 0.6); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary);" />
                  <button @click="openNewServicoModal" class="btn btn-primary" style="margin: 0; font-size: 12.5px; padding: 6px 14px;">
                    ➕ Novo Serviço
                  </button>
                </div>
              </div>

              <div class="table-container glass-panel">
                <table class="workspace-table">
                  <thead>
                    <tr>
                      <th>Código</th>
                      <th>Descrição</th>
                      <th>Valor Padrão</th>
                      <th>CNAE / NBS</th>
                      <th>Alíquota ISS</th>
                      <th>PIS / COFINS</th>
                      <th>Simples Nacional</th>
                      <th style="text-align: right;">Ações</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr v-for="s in servicosList" :key="s.id">
                      <td class="bold-text">{{ s.codigo }}</td>
                      <td>
                        <div style="display: flex; flex-direction: column;">
                          <span class="bold-text">{{ s.descricao }}</span>
                          <span style="font-size: 10.5px; color: var(--text-muted);">LC 116: {{ s.codigoServicoSefazCodigo }} - {{ s.codigoServicoSefazDescricao }}</span>
                        </div>
                      </td>
                      <td>{{ formatAmount(s.valor) }}</td>
                      <td>
                        <div style="display: flex; flex-direction: column;">
                          <span>CNAE: {{ s.cnae }}</span>
                          <span style="font-size: 10.5px; color: var(--text-muted);">NBS: {{ s.codigoNbs || '-' }}</span>
                        </div>
                      </td>
                      <td>
                        <div style="display: flex; flex-direction: column;">
                          <span>{{ s.aliquotaIss }}%</span>
                          <span v-if="s.indicadorIss" style="font-size: 10.5px; color: var(--primary);">Retido: {{ s.aliquotaIssRetido }}%</span>
                        </div>
                      </td>
                      <td>
                        <span style="font-size: 11px;">PIS: {{ s.aliquotaPis }}% | COFINS: {{ s.aliquotaCofins }}%</span>
                      </td>
                      <td>
                        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                          Anexo {{ s.anexoSimplesNacional === 0 ? 'N/A' : s.anexoSimplesNacional }}
                        </span>
                      </td>
                      <td style="text-align: right; white-space: nowrap;">
                        <button @click="openEditServicoModal(s)" class="btn btn-secondary" style="margin: 0 4px 0 0; padding: 4px 8px; font-size: 11px;">✏️ Editar</button>
                        <button @click="deleteServico(s.id)" class="btn btn-danger" style="margin: 0; padding: 4px 8px; font-size: 11px; background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.4); color: #f87171;">🗑️ Excluir</button>
                      </td>
                    </tr>
                    <tr v-if="servicosList.length === 0">
                      <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 30px;">Nenhum serviço cadastrado.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Seção de Dados do Contador -->
            <div v-else-if="fiscalSubTab === 'contador'" class="glass-panel animate-fade" style="padding: 25px; border-radius: 12px; display: flex; flex-direction: column; gap: 20px;">
              <div>
                <h3 style="font-size: 16px; font-weight: 600;">💼 Cadastro do Contador Responsável</h3>
                <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 15px;">Configure as informações do contador da sua empresa para exportações fiscais do SPED e preenchimento de documentos.</p>
              </div>

              <div v-if="isLoadingContador" style="text-align: center; padding: 20px; color: var(--text-muted);">
                Carregando dados do contador...
              </div>
              <form v-else @submit.prevent="saveContadorSettings" class="config-form">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label>Razão Social / Nome do Escritório</label>
                    <input type="text" v-model="contadorForm.razaoSocial" placeholder="Ex: Contabilidade Central Ltda" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Nome do Contador Responsável *</label>
                    <input type="text" v-model="contadorForm.nomeContador" required placeholder="Ex: Roberto da Silva" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-3">
                  <div class="form-group">
                    <label>CPF</label>
                    <input type="text" v-model="contadorForm.cpf" placeholder="000.000.000-00" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>CNPJ</label>
                    <input type="text" v-model="contadorForm.cnpj" placeholder="00.000.000/0000-00" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" v-model="contadorForm.telefone" placeholder="(00) 00000-0000" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-3">
                  <div class="form-group">
                    <label>Número do CRC *</label>
                    <input type="text" v-model="contadorForm.numeroCrc" required placeholder="Ex: CRC-12345/O" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>UF do CRC *</label>
                    <select v-model="contadorForm.ufCrc" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                      <option v-for="uf in estadosList" :key="uf" :value="uf">{{ uf }}</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>Vencimento do CRC</label>
                    <input type="date" v-model="contadorForm.dataVencimentoCrc" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-3">
                  <div class="form-group">
                    <label>E-mail Contato</label>
                    <input type="email" v-model="contadorForm.email" placeholder="contador@escritorio.com" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Qualificação / Cargo</label>
                    <input type="text" v-model="contadorForm.qualificacao" placeholder="Ex: Sócio-Diretor" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Função</label>
                    <input type="text" v-model="contadorForm.funcao" placeholder="Ex: Auditor Externo" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-2">
                  <div class="form-group">
                    <label>Permissão Transmissão SEFAZ *</label>
                    <select v-model="contadorForm.permissaoTransmissao" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                      <option :value="-1">Não utiliza</option>
                      <option :value="1">CPF</option>
                      <option :value="2">CNPJ</option>
                      <option :value="3">Ambos</option>
                    </select>
                  </div>
                  <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 25px;">
                    <input type="checkbox" id="cont-ativo" v-model="contadorForm.ativo" style="width: 18px; height: 18px;" />
                    <label for="cont-ativo" style="margin: 0; font-size: 13.5px; font-weight: 500;">Contador Ativo no Sistema</label>
                  </div>
                </div>

                <h4 class="form-section-title" style="margin-top: 15px; font-size: 14px; font-weight: 600; border-bottom: 1px solid var(--border-color); padding-bottom: 5px;">📍 Endereço do Contador</h4>
                <div class="form-grid-3">
                  <div class="form-group">
                    <label>CEP *</label>
                    <input type="text" v-model="contadorForm.cep" required placeholder="80000000" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group" style="grid-column: span 2;">
                    <label>Logradouro *</label>
                    <input type="text" v-model="contadorForm.logradouro" required placeholder="Rua, avenida..." style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-3">
                  <div class="form-group">
                    <label>Número *</label>
                    <input type="text" v-model="contadorForm.numero" required placeholder="Ex: 123" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Complemento</label>
                    <input type="text" v-model="contadorForm.complemento" placeholder="Sala, Bloco..." style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Bairro *</label>
                    <input type="text" v-model="contadorForm.bairro" required placeholder="Centro" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                </div>

                <div class="form-grid-2">
                  <div class="form-group">
                    <label>Código IBGE Município *</label>
                    <input type="number" v-model="contadorForm.municipioId" required placeholder="Ex: 4106902" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
                  </div>
                  <div class="form-group">
                    <label>Estado / UF *</label>
                    <select v-model="contadorForm.uf" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                      <option v-for="uf in estadosList" :key="uf" :value="uf">{{ uf }}</option>
                    </select>
                  </div>
                </div>

                <div style="margin-top: 20px;">
                  <button type="submit" class="btn btn-success" style="padding: 10px 20px; font-size: 13.5px; margin: 0;">
                    💾 Salvar Configurações do Contador
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- RENDER: Pessoas & Contatos -->
        <div v-else-if="currentTab === 'pessoas'" class="tab-content animate-fade">
          <PessoasTab />
        </div>

        <!-- RENDER: Configurações -->
        <div v-else-if="currentTab === 'configuracoes'" class="tab-content animate-fade">
          <header class="tab-header">
            <h2>Configurações do Inquilino</h2>
            <p>Gerencie o perfil da sua empresa, preferências operacionais, tabelas auxiliares e chaves de API.</p>
          </header>

          <!-- Menu de Abas de Configuração -->
          <div class="config-tabs-nav glass-panel" style="flex-wrap: wrap; gap: 8px;">
            <button type="button" @click="activeConfigSubTab = 'empresa'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'empresa' }]">🏢 Perfil da Empresa</button>
            <button type="button" @click="activeConfigSubTab = 'preferencias'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'preferencias' }]">⚙️ Preferências</button>
            <button type="button" @click="activeConfigSubTab = 'armazens'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'armazens' }]">📦 Armazéns</button>
            <button type="button" @click="activeConfigSubTab = 'categorias'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'categorias' }]">🏷️ Categorias</button>
            <button type="button" @click="activeConfigSubTab = 'unidades'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'unidades' }]">⚖️ Unidades & Conversão</button>
            <button type="button" @click="activeConfigSubTab = 'projetos'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'projetos' }]">📊 Projetos</button>
            <button type="button" @click="activeConfigSubTab = 'impostos'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'impostos' }]">💸 Impostos</button>
            <button type="button" @click="activeConfigSubTab = 'email'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'email' }]">✉️ Servidor de E-mail</button>
            <button type="button" @click="activeConfigSubTab = 'auditoria'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'auditoria' }]">🕵️ Auditoria</button>
            <button type="button" @click="activeConfigSubTab = 'api'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'api' }]">🔑 Chaves de API</button>
            <button type="button" @click="activeConfigSubTab = 'perfis'" :class="['config-tab-btn', { 'active': activeConfigSubTab === 'perfis' }]">🔑 Perfis & Permissões</button>
          </div>

          <!-- SUB-ABA: Perfil da Empresa -->
          <div v-if="activeConfigSubTab === 'empresa'" class="config-pane glass-panel animate-fade">
            <form @submit.prevent="saveCompanySettings" class="config-form">
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="comp-razao">Razão Social *</label>
                  <input type="text" id="comp-razao" v-model="companySettings.razaoSocial" required placeholder="Ex: Minha Empresa S/A" />
                </div>
                <div class="form-group">
                  <label for="comp-fantasia">Nome Fantasia</label>
                  <input type="text" id="comp-fantasia" v-model="companySettings.nomeFantasia" placeholder="Ex: Minha Empresa" />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="comp-cnpj">CNPJ *</label>
                  <input type="text" id="comp-cnpj" v-model="companySettings.cnpj" required placeholder="Apenas números ou formatado" />
                </div>
                <div class="form-group">
                  <label for="comp-ie">Inscrição Estadual</label>
                  <input type="text" id="comp-ie" v-model="companySettings.inscricaoEstadual" placeholder="IE da Empresa" />
                </div>
                <div class="form-group">
                  <label for="comp-im">Inscrição Municipal</label>
                  <input type="text" id="comp-im" v-model="companySettings.inscricaoMunicipal" placeholder="IM da Empresa" />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="comp-suframa">Inscrição Suframa</label>
                  <input type="text" id="comp-suframa" v-model="companySettings.inscricaoSuframa" placeholder="Caso possua" />
                </div>
                <div class="form-group">
                  <label for="comp-cnae">CNAE Principal</label>
                  <input type="text" id="comp-cnae" v-model="companySettings.cnae" placeholder="Ex: 6201501" />
                </div>
                <div class="form-group">
                  <label for="comp-email">E-mail Comercial *</label>
                  <input type="email" id="comp-email" v-model="companySettings.email" placeholder="financeiro@empresa.com" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="comp-regimetrib">Regime Tributário *</label>
                  <select id="comp-regimetrib" v-model.number="companySettings.regimeTributario" required>
                    <option :value="1">Simples Nacional</option>
                    <option :value="2">Lucro Presumido</option>
                    <option :value="3">Lucro Real</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="comp-regimeap">Regime de Apuração *</label>
                  <select id="comp-regimeap" v-model.number="companySettings.regimeApuracao" required>
                    <option :value="1">Cumulativo</option>
                    <option :value="2">Não Cumulativo</option>
                    <option :value="3">Misto</option>
                  </select>
                </div>
              </div>

              <hr class="form-divider" />
              <h4 class="form-section-title">Endereço Comercial</h4>
              <div class="form-grid-3">
                <div class="form-group">
                  <label for="end-cep">CEP</label>
                  <input type="text" id="end-cep" v-model="companySettings.endereco.cep" placeholder="00000-000" />
                </div>
                <div class="form-group" style="grid-column: span 2;">
                  <label for="end-logradouro">Logradouro *</label>
                  <input type="text" id="end-logradouro" v-model="companySettings.endereco.logradouro" required placeholder="Ex: Avenida Paulista" />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="end-numero">Número *</label>
                  <input type="text" id="end-numero" v-model="companySettings.endereco.numero" required placeholder="123" />
                </div>
                <div class="form-group">
                  <label for="end-compl">Complemento</label>
                  <input type="text" id="end-compl" v-model="companySettings.endereco.complemento" placeholder="Sala, bloco..." />
                </div>
                <div class="form-group">
                  <label for="end-bairro">Bairro *</label>
                  <input type="text" id="end-bairro" v-model="companySettings.endereco.bairro" required placeholder="Centro" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="end-cidade">Cidade *</label>
                  <input type="text" id="end-cidade" v-model="companySettings.endereco.cidade" required placeholder="Campinas" />
                </div>
                <div class="form-group">
                  <label for="end-estado">Estado *</label>
                  <input type="text" id="end-estado" v-model="companySettings.endereco.estado" required placeholder="SP" maxLength="2" />
                </div>
              </div>

              <hr class="form-divider" />
              <h4 class="form-section-title">Preferências Regionais & Logo</h4>
              <div class="form-grid-3">
                <div class="form-group">
                  <label for="comp-timezone">Fuso Horário *</label>
                  <select id="comp-timezone" v-model="companySettings.timeZoneId" required>
                    <option v-for="tz in timezones" :key="tz.id" :value="tz.id">
                      {{ tz.nome }} ({{ tz.offset }})
                    </option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="comp-dateformat">Formato de Data *</label>
                  <select id="comp-dateformat" v-model="companySettings.dateFormat" required>
                    <option value="DD-MM-YYYY">DD-MM-YYYY (padrão)</option>
                    <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                    <option value="MM-DD-YYYY">MM-DD-YYYY</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="comp-currency">Moeda Padrão *</label>
                  <select id="comp-currency" v-model="companySettings.currencyId" required>
                    <option v-for="c in currencies" :key="c.id" :value="c.id">
                      {{ c.codigoISO }} ({{ c.simbolo }})
                    </option>
                  </select>
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="comp-logo">URL do Logotipo</label>
                  <input type="text" id="comp-logo" v-model="companySettings.logo" placeholder="https://exemplo.com/logo.png" />
                </div>
                <div class="form-group">
                  <label for="comp-favicon">URL do Favicon</label>
                  <input type="text" id="comp-favicon" v-model="companySettings.favicon" placeholder="https://exemplo.com/favicon.ico" />
                </div>
              </div>

              <div class="form-actions" style="justify-content: flex-start; margin-top: 10px;">
                <button type="submit" class="btn btn-success" :disabled="isSaving">
                  {{ isSaving ? 'Salvando...' : '💾 Salvar Configurações da Empresa' }}
                </button>
              </div>
            </form>
          </div>

          <!-- SUB-ABA: Preferências Gerais -->
          <div v-else-if="activeConfigSubTab === 'preferencias'" class="config-pane glass-panel animate-fade">
            <h4>⚙️ Preferências Operacionais do Sistema</h4>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 15px;">
              Ajuste as permissões de caixa, controle de inventário e parâmetros tributários padrões do seu inquilino.
            </p>
            <form @submit.prevent="savePreferences" class="config-form">
              <div class="form-grid-2" style="gap: 24px;">
                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">Exibir Símbolo da Moeda</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Seletor de exibição visual de moeda nas listagens.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.showCurrency" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">⚠️ Permitir Caixa Negativo</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Permite fluxos financeiros sem saldo disponível. Requer auditoria.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.negativeCash" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">⚠️ Permitir Estoque Negativo</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Habilita saídas de materiais sem saldo. Requer auditoria.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.negativeStock" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">Limite de Crédito de Clientes</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Bloqueia vendas caso o cliente ultrapasse o limite de crédito.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.creditLimit" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">Desconto Geral em Itens</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Permite aplicar percentual de desconto nas faturas.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.discount" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">Imposto Automático na Compra</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Calcula e provisiona impostos na entrada de mercadorias.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.vatOnPurchase" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>

                <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 12px;">
                  <div>
                    <label style="font-size: 13px; text-transform: none; color: var(--text-primary);">Imposto Automático na Venda</label>
                    <p style="font-size: 11px; color: var(--text-muted); margin: 2px 0 0;">Calcula e provisiona impostos na emissão de faturas/vendas.</p>
                  </div>
                  <input type="checkbox" v-model="preferencias.vatOnSales" style="width: 20px; height: 20px; cursor: pointer;" />
                </div>
              </div>

              <div class="form-group" style="margin-top: 12px; max-width: 400px;">
                <label for="pref-stockmode">⚠️ Modo de Custo de Estoque *</label>
                <select id="pref-stockmode" v-model="preferencias.stockCalculationMode" required>
                  <option value="CustoMedio">Custo Médio Padrão (Média Ponderada)</option>
                  <option value="FIFO">FIFO (Primeiro que entra, Primeiro que sai)</option>
                  <option value="Ultimo">Último Custo de Entrada</option>
                </select>
              </div>

              <div class="form-actions" style="justify-content: flex-start;">
                <button type="submit" class="btn btn-success" :disabled="isSaving">
                  💾 Salvar Preferências
                </button>
              </div>
            </form>
          </div>

          <!-- SUB-ABA: Armazéns -->
          <div v-else-if="activeConfigSubTab === 'armazens'" class="config-pane glass-panel animate-fade">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h4>📦 Armazéns e Depósitos</h4>
              <button type="button" @click="showArmazemForm = true; currentArmazem = { id: null, nome: '', pais: '', cidade: '', mobile: '', email: '' }" class="btn btn-primary" v-if="!showArmazemForm">
                ➕ Adicionar Armazém
              </button>
            </div>

            <!-- Form de Armazém -->
            <div v-if="showArmazemForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>{{ currentArmazem.id ? '🔄 Editar Armazém' : '⚡ Cadastrar Novo Armazém' }}</h5>
              <form @submit.prevent="saveArmazem" class="config-form" style="margin-top: 12px;">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="arm-nome">Nome do Depósito *</label>
                    <input type="text" id="arm-nome" v-model="currentArmazem.nome" required placeholder="Ex: Central SP" />
                  </div>
                  <div class="form-group">
                    <label for="arm-email">E-mail do Depósito</label>
                    <input type="email" id="arm-email" v-model="currentArmazem.email" placeholder="armazem@empresa.com" />
                  </div>
                </div>
                <div class="form-grid-3">
                  <div class="form-group">
                    <label for="arm-pais">País</label>
                    <input type="text" id="arm-pais" v-model="currentArmazem.pais" placeholder="Brasil" />
                  </div>
                  <div class="form-group">
                    <label for="arm-cidade">Cidade</label>
                    <input type="text" id="arm-cidade" v-model="currentArmazem.cidade" placeholder="São Paulo" />
                  </div>
                  <div class="form-group">
                    <label for="arm-mobile">Telefone / Celular</label>
                    <input type="text" id="arm-mobile" v-model="currentArmazem.mobile" placeholder="Ex: (11) 99999-9999" />
                  </div>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar</button>
                  <button type="button" @click="showArmazemForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <!-- Tabela de Armazéns -->
            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <th>Cidade / País</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="arm in armazens" :key="arm.id">
                    <td class="bold-text">{{ arm.nome }}</td>
                    <td>{{ arm.cidade || 'N/A' }} / {{ arm.pais || 'N/A' }}</td>
                    <td>{{ arm.mobile || 'N/A' }}</td>
                    <td>{{ arm.email || 'N/A' }}</td>
                    <td>
                      <div style="display: flex; gap: 8px;">
                        <button type="button" @click="editArmazem(arm)" class="btn-api-sub">✏️ Editar</button>
                        <button type="button" @click="deleteArmazem(arm.id, arm.nome)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                      </div>
                    </td>
                  </tr>
                  <tr v-if="armazens.length === 0">
                    <td colspan="5" style="text-align: center; color: var(--text-muted);">Nenhum armazém cadastrado.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Categorias -->
          <div v-else-if="activeConfigSubTab === 'categorias'" class="config-pane glass-panel animate-fade">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h4>🏷️ Categorias de Produtos</h4>
              <button type="button" @click="showCategoriaForm = true; currentCategoria = { id: null, nome: '', image: '', ativo: true }" class="btn btn-primary" v-if="!showCategoriaForm">
                ➕ Adicionar Categoria
              </button>
            </div>

            <div v-if="showCategoriaForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>{{ currentCategoria.id ? '🔄 Editar Categoria' : '⚡ Cadastrar Nova Categoria' }}</h5>
              <form @submit.prevent="saveCategoria" class="config-form" style="margin-top: 12px;">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="cat-nome">Nome da Categoria *</label>
                    <input type="text" id="cat-nome" v-model="currentCategoria.nome" required placeholder="Ex: Matéria Prima" />
                  </div>
                  <div class="form-group">
                    <label for="cat-img">URL da Imagem da Categoria</label>
                    <input type="text" id="cat-img" v-model="currentCategoria.image" placeholder="https://exemplo.com/imagens/cat.png" />
                  </div>
                </div>
                <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px;">
                  <input type="checkbox" id="cat-ativo" v-model="currentCategoria.ativo" />
                  <label for="cat-ativo" style="text-transform: none; cursor: pointer;">Categoria Ativa</label>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar</button>
                  <button type="button" @click="showCategoriaForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Imagem</th>
                    <th>Nome</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="cat in categorias" :key="cat.id">
                    <td>
                      <img v-if="cat.image" :src="cat.image" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover; border: 1px solid var(--border-color);" />
                      <span v-else style="font-size: 18px;">🏷️</span>
                    </td>
                    <td class="bold-text">{{ cat.nome }}</td>
                    <td>
                      <span :class="['badge', cat.ativo !== false ? 'badge-paga' : 'badge-cancelada']">
                        {{ cat.ativo !== false ? 'Ativa' : 'Inativa' }}
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 8px;">
                        <button type="button" @click="editCategoria(cat)" class="btn-api-sub">✏️ Editar</button>
                        <button type="button" @click="deleteCategoria(cat.id, cat.nome)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                      </div>
                    </td>
                  </tr>
                  <tr v-if="categorias.length === 0">
                    <td colspan="4" style="text-align: center; color: var(--text-muted);">Nenhuma categoria cadastrada.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Unidades & Conversão -->
          <div v-else-if="activeConfigSubTab === 'unidades'" class="config-pane glass-panel animate-fade">
            <!-- Unidades de Medida Section -->
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h4>⚖️ Unidades de Medida</h4>
              <button type="button" @click="showUnidadeForm = true; currentUnidade = { id: null, nome: '', codigoUNECE: '' }" class="btn btn-primary" v-if="!showUnidadeForm">
                ➕ Adicionar Unidade
              </button>
            </div>

            <div v-if="showUnidadeForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>{{ currentUnidade.id ? '🔄 Editar Unidade' : '⚡ Cadastrar Nova Unidade' }}</h5>
              <form @submit.prevent="saveUnidade" class="config-form" style="margin-top: 12px;">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="uni-nome">Nome da Unidade *</label>
                    <input type="text" id="uni-nome" v-model="currentUnidade.nome" required placeholder="Ex: Quilograma (KG)" />
                  </div>
                  <div class="form-group">
                    <label for="uni-unece">Código UNECE</label>
                    <input type="text" id="uni-unece" v-model="currentUnidade.codigoUNECE" placeholder="Ex: KGM" />
                  </div>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar</button>
                  <button type="button" @click="showUnidadeForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Nome da Unidade</th>
                    <th>Código UNECE</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="uni in unidades" :key="uni.id">
                    <td class="bold-text">{{ uni.nome }}</td>
                    <td><span class="sku-badge">{{ uni.codigoUNECE || 'N/A' }}</span></td>
                    <td>
                      <div style="display: flex; gap: 8px;">
                        <button type="button" @click="editUnidade(uni)" class="btn-api-sub">✏️ Editar</button>
                        <button type="button" @click="deleteUnidade(uni.id, uni.nome)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                      </div>
                    </td>
                  </tr>
                  <tr v-if="unidades.length === 0">
                    <td colspan="3" style="text-align: center; color: var(--text-muted);">Nenhuma unidade cadastrada.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Conversões Section -->
            <hr class="form-divider" style="margin-top: 30px;" />
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
              <h4>🔄 Regras de Conversão de Unidades</h4>
              <button type="button" @click="showConversaoForm = true; currentConversao = { id: null, unidadeOrigemId: '', unidadeDestinoId: '', fator: 1.0 }" class="btn btn-primary" v-if="!showConversaoForm && unidades.length > 1">
                ➕ Adicionar Conversão
              </button>
            </div>

            <div v-if="showConversaoForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>⚡ Adicionar Nova Conversão</h5>
              <form @submit.prevent="saveConversao" class="config-form" style="margin-top: 12px;">
                <div class="form-grid-3">
                  <div class="form-group">
                    <label for="conv-origem">Unidade de Origem *</label>
                    <select id="conv-origem" v-model="currentConversao.unidadeOrigemId" required>
                      <option v-for="u in unidades" :key="u.id" :value="u.id">{{ u.nome }}</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="conv-destino">Unidade de Destino *</label>
                    <select id="conv-destino" v-model="currentConversao.unidadeDestinoId" required>
                      <option v-for="u in unidades" :key="u.id" :value="u.id">{{ u.nome }}</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="conv-fator">Fator de Conversão *</label>
                    <input type="number" id="conv-fator" step="0.000001" v-model.number="currentConversao.fator" required placeholder="Ex: 12" />
                  </div>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar Conversão</button>
                  <button type="button" @click="showConversaoForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Unidade Origem</th>
                    <th>Equivale a</th>
                    <th>Fator de Conversão</th>
                    <th>Unidade Destino</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="conv in conversoes" :key="conv.id">
                    <td class="bold-text">{{ conv.unidadeOrigemNome }}</td>
                    <td>=</td>
                    <td class="bold-text" style="color: var(--primary);">{{ conv.fator }}</td>
                    <td>{{ conv.unidadeDestinoNome }}</td>
                    <td>
                      <button type="button" @click="deleteConversao(conv.id)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                    </td>
                  </tr>
                  <tr v-if="conversoes.length === 0">
                    <td colspan="5" style="text-align: center; color: var(--text-muted);">Nenhuma regra de conversão cadastrada.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Projetos -->
          <div v-else-if="activeConfigSubTab === 'projetos'" class="config-pane glass-panel animate-fade">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h4>📊 Centros de Apropriação de Projetos</h4>
              <button type="button" @click="showProjetoForm = true; currentProjeto = { id: null, nome: '' }" class="btn btn-primary" v-if="!showProjetoForm">
                ➕ Adicionar Projeto
              </button>
            </div>

            <div v-if="showProjetoForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>{{ currentProjeto.id ? '🔄 Editar Projeto' : '⚡ Cadastrar Novo Projeto' }}</h5>
              <form @submit.prevent="saveProjeto" class="config-form" style="margin-top: 12px;">
                <div class="form-group" style="max-width: 500px;">
                  <label for="proj-nome">Nome do Projeto *</label>
                  <input type="text" id="proj-nome" v-model="currentProjeto.nome" required placeholder="Ex: Black Friday 2026" />
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar</button>
                  <button type="button" @click="showProjetoForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Nome do Projeto</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="proj in projetos" :key="proj.id">
                    <td class="bold-text">{{ proj.nome }}</td>
                    <td>
                      <div style="display: flex; gap: 8px;">
                        <button type="button" @click="editProjeto(proj)" class="btn-api-sub">✏️ Editar</button>
                        <button type="button" @click="deleteProjeto(proj.id, proj.nome)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                      </div>
                    </td>
                  </tr>
                  <tr v-if="projetos.length === 0">
                    <td colspan="2" style="text-align: center; color: var(--text-muted);">Nenhum projeto cadastrado.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Impostos -->
          <div v-else-if="activeConfigSubTab === 'impostos'" class="config-pane glass-panel animate-fade">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h4>💸 Impostos e Alíquotas</h4>
              <button type="button" @click="showImpostoForm = true; currentImposto = { id: null, nome: '', rate: 0.0, isActive: true, vigenciaInicio: null, vigenciaFim: null }" class="btn btn-primary" v-if="!showImpostoForm">
                ➕ Adicionar Imposto
              </button>
            </div>

            <div v-if="showImpostoForm" class="glass-panel animate-fade" style="padding: 16px; border: 1px solid rgba(255,255,255,0.05);">
              <h5>{{ currentImposto.id ? '🔄 Editar Imposto' : '⚡ Cadastrar Novo Imposto' }}</h5>
              <form @submit.prevent="saveImposto" class="config-form" style="margin-top: 12px;">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="imp-nome">Nome da Alíquota *</label>
                    <input type="text" id="imp-nome" v-model="currentImposto.nome" required placeholder="Ex: ICMS Normal" />
                  </div>
                  <div class="form-group">
                    <label for="imp-rate">Taxa / Percentual (%) *</label>
                    <input type="number" id="imp-rate" step="0.01" v-model.number="currentImposto.rate" required placeholder="Ex: 18.0" />
                  </div>
                </div>
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="imp-inicio">Início da Vigência</label>
                    <input type="date" id="imp-inicio" v-model="currentImposto.vigenciaInicio" />
                  </div>
                  <div class="form-group">
                    <label for="imp-fim">Fim da Vigência</label>
                    <input type="date" id="imp-fim" v-model="currentImposto.vigenciaFim" />
                  </div>
                </div>
                <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px;">
                  <input type="checkbox" id="imp-ativo" v-model="currentImposto.isActive" />
                  <label for="imp-ativo" style="text-transform: none; cursor: pointer;">Imposto Ativo para Novos Lançamentos</label>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                  <button type="submit" class="btn btn-success">Salvar</button>
                  <button type="button" @click="showImpostoForm = false" class="btn btn-danger" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">Cancelar</button>
                </div>
              </form>
            </div>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Nome do Imposto</th>
                    <th>Alíquota</th>
                    <th>Início Vigência</th>
                    <th>Fim Vigência</th>
                    <th>Status</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="imp in impostos" :key="imp.id">
                    <td class="bold-text">{{ imp.nome }}</td>
                    <td class="bold-text" style="color: var(--primary);">{{ imp.rate }} %</td>
                    <td>{{ imp.vigenciaInicio ? new Date(imp.vigenciaInicio).toLocaleDateString('pt-BR') : 'Sem data' }}</td>
                    <td>{{ imp.vigenciaFim ? new Date(imp.vigenciaFim).toLocaleDateString('pt-BR') : 'Sem expiração' }}</td>
                    <td>
                      <span :class="['badge', imp.isActive !== false ? 'badge-paga' : 'badge-cancelada']">
                        {{ imp.isActive !== false ? 'Ativo' : 'Inativo' }}
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 8px;">
                        <button type="button" @click="editImposto(imp)" class="btn-api-sub">✏️ Editar</button>
                        <button type="button" @click="deleteImposto(imp.id, imp.nome)" class="btn-api-sub" style="color: #ef4444; border-color: rgba(239,68,68,0.2);">🗑️ Excluir</button>
                      </div>
                    </td>
                  </tr>
                  <tr v-if="impostos.length === 0">
                    <td colspan="6" style="text-align: center; color: var(--text-muted);">Nenhum imposto cadastrado.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Servidor de E-mail SMTP -->
          <div v-else-if="activeConfigSubTab === 'email'" class="config-pane glass-panel animate-fade">
            <h4>✉️ Parâmetros do Servidor SMTP (Notificações)</h4>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 15px;">
              Configure as credenciais SMTP utilizadas pelo Epros ERP para enviar faturas, contratos e orçamentos automaticamente aos seus clientes.
            </p>
            <form @submit.prevent="saveEmailSettings" class="config-form">
              <div class="form-grid-3">
                <div class="form-group" style="grid-column: span 2;">
                  <label for="mail-host">Servidor SMTP Host</label>
                  <input type="text" id="mail-host" v-model="emailConfig.host" placeholder="Ex: smtp.sendgrid.net" />
                </div>
                <div class="form-group">
                  <label for="mail-port">Porta SMTP</label>
                  <input type="number" id="mail-port" v-model.number="emailConfig.port" placeholder="Ex: 587" />
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="mail-user">Usuário SMTP</label>
                  <input type="text" id="mail-user" v-model="emailConfig.username" placeholder="Ex: apikey ou financeiro@epros.com" />
                </div>
                <div class="form-group">
                  <label for="mail-pass">Senha SMTP (Segredo Protegido)</label>
                  <input type="password" id="mail-pass" v-model="emailConfig.password" placeholder="Mantenha mascarado ou digite nova senha" />
                </div>
              </div>

              <div class="form-group" style="max-width: 500px;">
                <label for="mail-from">E-mail do Remetente (From Address) *</label>
                <input type="email" id="mail-from" v-model="emailConfig.fromEmail" required placeholder="financeiro@suaempresa.com" />
              </div>

              <div class="form-actions" style="justify-content: flex-start;">
                <button type="submit" class="btn btn-success" :disabled="isSaving">
                  💾 Salvar Configurações SMTP
                </button>
              </div>
            </form>
          </div>

          <!-- SUB-ABA: Auditoria -->
          <div v-else-if="activeConfigSubTab === 'auditoria'" class="config-pane glass-panel animate-fade">
            <h4>🕵️ Histórico de Alterações de Configurações (Logs Imutáveis)</h4>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 15px;">
              Este painel de conformidade internacional exibe todas as alterações feitas nas configurações e preferências operacionais, vinculando cada mudança à justificativa fornecida e ao usuário responsável.
            </p>

            <div class="table-container glass-panel">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Data/Hora</th>
                    <th>Operador</th>
                    <th>Entidade</th>
                    <th>Campo</th>
                    <th>Antes</th>
                    <th>Depois</th>
                    <th>Justificativa</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="log in auditLogs" :key="log.id">
                    <td style="white-space: nowrap; font-size: 12px;">{{ new Date(log.dataHora).toLocaleString('pt-BR') }}</td>
                    <td class="bold-text">{{ log.usuarioId }}</td>
                    <td><span class="sku-badge">{{ log.entidade }}</span></td>
                    <td class="bold-text" style="color: var(--primary);">{{ log.campo }}</td>
                    <td style="color: #fca5a5;">{{ log.valorAnterior }}</td>
                    <td style="color: #a7f3d0;">{{ log.valorNovo }}</td>
                    <td style="font-style: italic; font-size: 12px; color: var(--text-secondary);">{{ log.justificativa || 'N/A' }}</td>
                  </tr>
                  <tr v-if="auditLogs.length === 0">
                    <td colspan="7" style="text-align: center; color: var(--text-muted);">Nenhum log de alteração registrado.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SUB-ABA: Chaves de API & Integrações -->
          <div v-else-if="activeConfigSubTab === 'api'" class="config-pane glass-panel animate-fade">
            <div class="api-integration-section">
              <div class="api-info-header">
                <h4>🔒 Chaves de Integração API (REG-032)</h4>
                <p>As chaves de API permitem que você integre seus sistemas de vendas offline, e-commerce ou leitores IoT diretamente com o Epros ERP.</p>
              </div>

              <!-- Display da Chave Ativa -->
              <div class="api-key-container glass-panel">
                <div class="api-key-row">
                  <div class="api-key-label-group">
                    <span class="api-key-title">Chave de API Ativa</span>
                    <span :class="['badge', apiKeyData.key ? 'badge-paga' : 'badge-cancelada']">
                      {{ apiKeyData.key ? 'Ativa' : 'Nenhuma chave cadastrada' }}
                    </span>
                  </div>
                  <div class="api-key-action-group" v-if="apiKeyData.key">
                    <button type="button" @click="toggleApiKeyVisibility" class="btn-api-sub">
                      {{ showApiKeyText ? '👁️ Ocultar' : '👁️ Mostrar' }}
                    </button>
                    <button type="button" @click="copyApiKeyToClipboard" class="btn-api-sub">
                      📋 Copiar
                    </button>
                  </div>
                </div>

                <div class="api-key-value-box" v-if="apiKeyData.key">
                  <span class="api-key-raw-text">{{ showApiKeyText ? apiKeyData.key : '••••••••••••••••••••••••••••••••••••••••••••••••' }}</span>
                </div>
                <div class="api-key-empty-box" v-else>
                  <p>Você ainda não possui uma chave de API ativa para este usuário admin. Utilize o formulário abaixo para gerar.</p>
                </div>

                <div class="api-meta-grid" v-if="apiKeyData.key">
                  <div class="api-meta-item">
                    <span class="label">Taxa Limite (Rate Limit)</span>
                    <span class="value">{{ apiKeyData.rateLimit }} req/min</span>
                  </div>
                  <div class="api-meta-item">
                    <span class="label">Data de Criação</span>
                    <span class="value">{{ apiKeyData.createdDate ? new Date(apiKeyData.createdDate).toLocaleDateString('pt-BR') : 'N/A' }}</span>
                  </div>
                  <div class="api-meta-item">
                    <span class="label">Data de Expiração</span>
                    <span class="value" :class="{ 'danger-text': isApiKeyExpired }">
                      {{ apiKeyData.expirationDate ? new Date(apiKeyData.expirationDate).toLocaleDateString('pt-BR') : 'N/A' }}
                    </span>
                  </div>
                  <div class="api-meta-item">
                    <span class="label">Último Uso Detectado</span>
                    <span class="value">{{ apiKeyData.lastUsedDate ? new Date(apiKeyData.lastUsedDate).toLocaleString('pt-BR') : 'Nunca utilizada' }}</span>
                  </div>
                </div>
              </div>

              <!-- Formulário para Gerar/Rotacionar Chave -->
              <div class="api-key-setup-form glass-panel">
                <h5>{{ apiKeyData.key ? '🔄 Rotacionar / Alterar Chave de API' : '⚡ Gerar Nova Chave de API' }}</h5>
                <p class="setup-desc">A rotação de chave gerará um novo token de segurança imediatamente. O token antigo deixará de funcionar instantaneamente.</p>
                
                <form @submit.prevent="rotateApiKey" class="config-form" style="margin-top: 16px;">
                  <div class="form-grid-2">
                    <div class="form-group">
                      <label for="api-ratelimit">Limite de Requisições por Minuto</label>
                      <input type="number" id="api-ratelimit" v-model.number="apiKeySetup.rateLimit" min="1" required placeholder="Ex: 60" />
                    </div>
                    <div class="form-group">
                      <label for="api-validity">Validade em dias</label>
                      <input type="number" id="api-validity" v-model.number="apiKeySetup.validityDays" min="1" required placeholder="Ex: 365" />
                    </div>
                  </div>
                  <div class="form-actions-left" style="display: flex; justify-content: flex-start;">
                    <button type="submit" class="btn btn-primary" :disabled="isRotatingKey">
                      {{ isRotatingKey ? 'Gerando...' : (apiKeyData.key ? '🔄 Rotacionar Chave' : '⚡ Gerar Chave de API') }}
                    </button>
                    <button type="button" @click="revokeApiKey" class="btn btn-danger" style="margin-left: 12px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;" v-if="apiKeyData.key" :disabled="isRotatingKey">
                      🚫 Revogar Chave
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- SUB-ABA: Perfis de Acesso & Permissões -->
          <div v-else-if="activeConfigSubTab === 'perfis'" class="config-pane glass-panel animate-fade">
            <PerfisAcessoTab />
          </div>
        </div>
      </main>
    </div>

    <!-- Overlay de Boas-vindas para novos Inquilinos -->
    <div v-if="showWelcome" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale">
        <div class="welcome-rocket-icon">🚀</div>
        <h2>Seja bem-vindo ao Epros!</h2>
        <p>Sua conta de administrador foi criada e o seu ambiente corporativo foi provisionado com sucesso no <strong>{{ user?.planName }}</strong>.</p>
        <p class="sub-message">O sistema já está pronto para uso. Utilize o menu lateral para gerenciar estoque, vendas, financeiro e emitir notas fiscais.</p>
        <button @click="showWelcome = false" class="btn btn-success btn-welcome-dismiss">
          Começar a Usar
        </button>
      </div>
    </div>

    <!-- Overlay de Justificativa de Auditoria -->
    <div v-if="showJustificationModal" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 500px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>⚠️ Justificativa de Auditoria Requerida</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Você está alterando parâmetros críticos de controle operacional/financeiro (Caixa Negativo, Estoque Negativo ou Modo de Cálculo de Estoque).
          Essas alterações são registradas em log de auditoria imutável e exigem uma justificativa formal.
        </p>
        <div class="form-group">
          <label for="justification-text" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Motivo / Justificativa *</label>
          <textarea 
            id="justification-text" 
            v-model="justificationText" 
            rows="4" 
            required 
            placeholder="Descreva a razão desta alteração..."
            style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.01); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;"
          ></textarea>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 12px;">
          <button type="button" @click="confirmPreferencesSave" class="btn btn-success" style="flex: 1;" :disabled="!justificationText.trim()">
            Confirmar Alteração
          </button>
          <button type="button" @click="showJustificationModal = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
            Cancelar
          </button>
        </div>
      </div>
    </div>

    <!-- Modal de Conta Bancária -->
    <div v-if="showBancoForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 550px; text-align: left; align-items: stretch; gap: 12px; padding: 30px; max-height: 90vh; overflow-y: auto;">
        <h3>🏦 {{ isEditingBanco ? 'Editar Conta Bancária' : 'Nova Conta Bancária' }}</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Registre ou altere as informações de uma conta corrente, poupança ou aplicação financeira da sua empresa.
        </p>
        <form @submit.prevent="submitBancoForm" class="vertical-form">
          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Apelido da Conta *</label>
              <input type="text" v-model="bancoForm.apelido" required placeholder="Ex: Conta Principal Santander" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Banco Associado *</label>
              <select v-model="bancoForm.bancoId" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option v-for="b in defaultBancosLookup" :key="b.id" :value="b.id">{{ b.codigo }} - {{ b.descricao }}</option>
              </select>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Tipo de Conta *</label>
              <select v-model="bancoForm.tipoContaBancaria" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option v-for="t in tiposContaBancariaList" :key="t.value" :value="t.value">{{ t.text }}</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Titular da Conta *</label>
              <input type="text" v-model="bancoForm.titular" required placeholder="Nome do Titular ou Razão Social" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Agência *</label>
              <input type="text" v-model="bancoForm.agencia" required placeholder="Agência" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Dígito Ag.</label>
              <input type="text" v-model="bancoForm.digitoAgencia" placeholder="0" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Conta Corrente *</label>
              <input type="text" v-model="bancoForm.conta" required placeholder="Número da conta" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Nome do Gerente</label>
              <input type="text" v-model="bancoForm.gerente" placeholder="Gerente da conta" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Telefone do Gerente</label>
              <input type="text" v-model="bancoForm.foneGerente" placeholder="(00) 00000-0000" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Detalhes / Observações</label>
            <input type="text" v-model="bancoForm.detalhe" placeholder="Ex: Conta destinada ao recebimento de vendas Pix" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-success" style="flex: 1; padding: 12px;">
              💾 {{ isEditingBanco ? 'Atualizar Conta' : 'Criar Conta Bancária' }}
            </button>
            <button type="button" @click="showBancoForm = false" class="btn btn-danger" style="flex: 1; padding: 12px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Cartão de Crédito -->
    <div v-if="showCartaoForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 550px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>💳 {{ isEditingCartao ? 'Editar Cartão de Crédito' : 'Novo Cartão de Crédito' }}</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Cadastre cartões de crédito corporativos vinculados a uma conta bancária para controle de faturas e despesas a prazo.
        </p>
        <form @submit.prevent="submitCartaoForm" class="vertical-form">
          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Apelido do Cartão *</label>
              <input type="text" v-model="cartaoForm.apelido" required placeholder="Ex: Visa Gold Diretoria" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Bandeira *</label>
              <select v-model="cartaoForm.bandeiraCartao" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option v-for="b in bandeirasCartaoList" :key="b.value" :value="b.value">{{ b.text }}</option>
              </select>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Conta Bancária Associada *</label>
              <select v-model="cartaoForm.contaBancariaId" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option value="">Selecione a conta de débito...</option>
                <option v-for="c in bancosList" :key="c.id" :value="c.id">{{ c.apelido }} ({{ c.conta }})</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Nome do Portador / Titular *</label>
              <input type="text" v-model="cartaoForm.titular" required placeholder="Nome impresso no cartão" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Observações / Limites</label>
            <input type="text" v-model="cartaoForm.observacao" placeholder="Ex: Limite global de R$ 10.000,00" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-success" style="flex: 1; padding: 12px;">
              💾 {{ isEditingCartao ? 'Salvar Alterações' : 'Criar Cartão de Crédito' }}
            </button>
            <button type="button" @click="showCartaoForm = false" class="btn btn-danger" style="flex: 1; padding: 12px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Faturas / Lançamentos do Cartão -->
    <div v-if="showFaturasModal" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 750px; text-align: left; align-items: stretch; gap: 12px; padding: 30px; max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <h3>🧾 Extrato / Faturas: {{ selectedCartao?.apelido }}</h3>
          <button @click="openLancarFatura" class="btn btn-primary" style="margin: 0; padding: 8px 16px;">
            ➕ Lançar Despesa no Cartão
          </button>
        </div>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px; margin-top: -8px;">
          Lista de lançamentos e faturas registradas neste cartão corporativo.
        </p>

        <div class="table-container" style="max-height: 350px; overflow-y: auto; background: rgba(0, 0, 0, 0.2); border-radius: 8px; border: 1px solid var(--border-color);">
          <table class="workspace-table">
            <thead>
              <tr>
                <th>Lançamento</th>
                <th>Vencimento da Fatura</th>
                <th>Valor</th>
                <th>Status</th>
                <th style="text-align: right;">Ações</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="fatura in faturasList" :key="fatura.id">
                <td>{{ new Date(fatura.dataLancamento).toLocaleDateString('pt-BR') }}</td>
                <td>{{ new Date(fatura.dataVencimento).toLocaleDateString('pt-BR') }}</td>
                <td class="bold-text danger-text">- {{ formatAmount(fatura.valor) }}</td>
                <td>
                  <span :class="['badge', fatura.pago ? 'badge-active' : 'badge-inactive']">
                    {{ fatura.pago ? 'Pago ✅' : 'Em Aberto ⏳' }}
                  </span>
                </td>
                <td style="text-align: right;">
                  <button v-if="!fatura.pago" @click="pagarFatura(fatura)" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px; margin: 0; color: var(--success); border-color: rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.05);">
                    💸 Quitar Fatura
                  </button>
                  <span v-else style="font-size: 11px; opacity: 0.5;">Liquidado</span>
                </td>
              </tr>
              <tr v-if="faturasList.length === 0">
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 20px;">Nenhuma fatura ou despesa lançada para este cartão.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 15px;">
          <button type="button" @click="showFaturasModal = false" class="btn btn-danger" style="padding: 10px 24px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
            Fechar
          </button>
        </div>
      </div>
    </div>

    <!-- Modal de Novo Lançamento de Fatura -->
    <div v-if="showLancarFaturaForm" class="welcome-overlay" style="z-index: 1100;">
      <div class="welcome-card glass-panel animate-scale" style="width: 480px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>💳 Registrar Lançamento no Cartão</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Insira uma nova despesa corporativa no cartão de crédito selecionado.
        </p>
        <form @submit.prevent="submitLancarFatura" class="vertical-form">
          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Data do Lançamento *</label>
              <input type="date" v-model="lancarFaturaForm.dataLancamento" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Vencimento da Fatura *</label>
              <input type="date" v-model="lancarFaturaForm.dataVencimento" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor Lançamento *</label>
              <input type="number" v-model="lancarFaturaForm.valor" step="0.01" min="0.01" required placeholder="0.00" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px; display: flex; flex-direction: column; justify-content: center; padding-left: 10px;">
              <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px;">
                <input type="checkbox" v-model="lancarFaturaForm.pago" style="cursor: pointer; width: 16px; height: 16px;" />
                Já Pago (Liquidado)
              </label>
            </div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 15px;">
            <button type="submit" class="btn btn-success" style="flex: 1; padding: 12px;">
              💾 Registrar Despesa
            </button>
            <button type="button" @click="showLancarFaturaForm = false" class="btn btn-danger" style="flex: 1; padding: 12px; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Novo Lançamento Financeiro -->
    <div v-if="showFinanceForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 550px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>➕ Novo Lançamento Financeiro</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Cadastre um novo título a pagar ou a receber. Todos os títulos requerem uma categoria e uma data de vencimento válida.
        </p>
        <form @submit.prevent="submitFinanceForm" class="vertical-form">
          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="fin-tipo" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Tipo de Título *</label>
              <select id="fin-tipo" v-model="financeForm.tipo" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option value="Pagar">Conta a Pagar (Saída)</option>
                <option value="Receber">Conta a Receber (Entrada)</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="fin-valor" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor (R$) *</label>
              <input type="number" id="fin-valor" v-model="financeForm.valor" step="0.01" min="0.01" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label for="fin-desc" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Descrição da Origem *</label>
            <input type="text" id="fin-desc" v-model="financeForm.descricao" required placeholder="Ex: Fornecedor de insumos de trigo" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="fin-venc" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Data de Vencimento *</label>
              <input type="date" id="fin-venc" v-model="financeForm.dataVencimento" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="fin-doc" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Nº do Documento / Nota</label>
              <input type="text" id="fin-doc" v-model="financeForm.numeroDocumento" placeholder="Ex: NF-1052" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label for="fin-cat" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Categoria / Plano de Contas *</label>
            <select id="fin-cat" v-model="financeForm.categoria" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
              <option value="Mercadorias">Mercadorias / Insumos</option>
              <option value="Aluguel">Aluguel / Condomínio</option>
              <option value="Energia">Energia Elétrica / Copel</option>
              <option value="Salarios">Salários / Encargos</option>
              <option value="Impostos">Impostos / Simples Nacional</option>
              <option value="Outros">Outros Lançamentos</option>
            </select>
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Salvar Lançamento
            </button>
            <button type="button" @click="showFinanceForm = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Baixa Financeira (Pagamento/Recebimento) -->
    <div v-if="showPaymentModal" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 500px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>💸 Efetuar Baixa do Título</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Registre o pagamento ou recebimento do título. O status será atualizado para <strong>Pago</strong> e os totais do dashboard serão recalculados.
        </p>
        <form @submit.prevent="submitPaymentForm" class="vertical-form">
          <div class="form-group" style="margin-bottom: 12px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Título</label>
            <div style="padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; font-size: 13.5px; color: var(--text-secondary);">
              <strong>#{{ selectedFinanceItem?.id }}</strong> - {{ selectedFinanceItem?.description }}
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="pay-valor" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor Pago/Recebido (R$) *</label>
              <input type="number" id="pay-valor" v-model="paymentForm.valorPago" step="0.01" min="0.01" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="pay-data" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Data de Liquidação *</label>
              <input type="date" id="pay-data" v-model="paymentForm.dataPagamento" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label for="pay-forma" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Forma de Liquidação *</label>
            <select id="pay-forma" v-model="paymentForm.formaPagamento" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
              <option value="Pix">Pix (Instantâneo)</option>
              <option value="Boleto">Boleto Bancário</option>
              <option value="Cartao">Cartão de Crédito/Débito</option>
              <option value="Dinheiro">Dinheiro Físico</option>
              <option value="Transferencia">Transferência Bancária (TED/DOC)</option>
            </select>
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Confirmar Baixa
            </button>
            <button type="button" @click="showPaymentModal = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Cancelamento de Título Financeiro -->
    <div v-if="showCancelFinanceModal" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 500px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>🚫 Cancelar Título Financeiro</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Esta operação não pode ser desfeita. O cancelamento exige uma justificativa formal de pelo menos 10 caracteres.
        </p>
        <form @submit.prevent="submitCancelFinanceForm" class="vertical-form">
          <div class="form-group" style="margin-bottom: 12px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Título</label>
            <div style="padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; font-size: 13.5px; color: var(--text-secondary);">
              <strong>#{{ selectedFinanceItem?.id }}</strong> - {{ selectedFinanceItem?.description }}
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label for="cancel-motivo" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Motivo / Justificativa *</label>
            <textarea 
              id="cancel-motivo" 
              v-model="cancelFinanceForm.motivo" 
              rows="4" 
              required 
              placeholder="Descreva a razão para o cancelamento deste lançamento..."
              style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;"
            ></textarea>
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-danger" style="flex: 1;" :disabled="cancelFinanceForm.motivo.trim().length < 10">
              Confirmar Cancelamento
            </button>
            <button type="button" @click="showCancelFinanceModal = false" class="btn btn-secondary" style="flex: 1;">
              Voltar
            </button>
          </div>
        </form>
      </div>
    </div>
    <!-- Modal de Cadastro / Edição de Produto -->
    <div v-if="showProductForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 650px; text-align: left; align-items: stretch; gap: 12px; padding: 30px; max-height: 90vh; overflow-y: auto;">
        <h3>{{ isEditingProduct ? '✏️ Editar Produto' : '➕ Novo Produto' }}</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Insira os dados do produto. Os campos marcados com * são obrigatórios.
        </p>
        <form @submit.prevent="submitProductForm" class="vertical-form">
          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-sku" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">SKU / Código *</label>
              <input type="text" id="prod-sku" v-model="productForm.codigo" required placeholder="Ex: PROD-001" :disabled="isEditingProduct" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-ean" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Código de Barras / EAN</label>
              <input type="text" id="prod-ean" v-model="productForm.ean" placeholder="Ex: 7891234567890" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label for="prod-desc" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Nome / Descrição *</label>
            <input type="text" id="prod-desc" v-model="productForm.descricao" required placeholder="Ex: Cerveja Artesanal IPA 500ml" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div class="form-grid-3">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-preco" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Preço à Vista (R$) *</label>
              <input type="number" id="prod-preco" v-model="productForm.valorVenda" step="0.01" min="0" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-preco-prazo" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Preço à Prazo (R$)</label>
              <input type="number" id="prod-preco-prazo" v-model="productForm.valorVendaPrazo" step="0.01" min="0" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-compra" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Preço Compra (R$)</label>
              <input type="number" id="prod-compra" v-model="productForm.valorCompra" step="0.01" min="0" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-pesol" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Peso Líquido (kg)</label>
              <input type="number" id="prod-pesol" v-model="productForm.pesoLiquido" step="0.001" min="0" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label for="prod-pesob" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Peso Bruto (kg)</label>
              <input type="number" id="prod-pesob" v-model="productForm.pesoBruto" step="0.001" min="0" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-2" style="margin-bottom: 15px;">
            <div class="form-group" style="display: flex; align-items: center; gap: 8px; padding-top: 10px;">
              <input type="checkbox" id="prod-ativo" v-model="productForm.ativo" style="width: 18px; height: 18px; accent-color: var(--primary);" />
              <label for="prod-ativo" style="font-size: 13px; font-weight: 600; text-transform: uppercase; cursor: pointer;">Produto Ativo</label>
            </div>
            <div class="form-group" style="display: flex; align-items: center; gap: 8px; padding-top: 10px;">
              <input type="checkbox" id="prod-balanca" v-model="productForm.utilizaBalanca" style="width: 18px; height: 18px; accent-color: var(--primary);" />
              <label for="prod-balanca" style="font-size: 13px; font-weight: 600; text-transform: uppercase; cursor: pointer;">Exportar p/ Balança</label>
            </div>
          </div>

          <div class="form-grid-2" v-if="productForm.utilizaBalanca" style="margin-bottom: 20px; padding: 15px; background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px;">
            <div class="form-group">
              <label for="prod-bal-id" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Balança Cadastrada *</label>
              <select id="prod-bal-id" v-model="productForm.balancaId" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option value="4fa85f64-5717-4562-b3fc-2c963f66afa6">Toledo Prix 4 (Padrão)</option>
                <option value="3fa85f64-5717-4562-b3fc-2c963f66afa6">Filizola Platina</option>
              </select>
            </div>
            <div class="form-group">
              <label for="prod-bal-cod" style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Cód. Produto Balança *</label>
              <input type="text" id="prod-bal-cod" v-model="productForm.codigoProdutoBalanca" required placeholder="Apenas números, ex: 102" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 12px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Salvar Produto
            </button>
            <button type="button" @click="showProductForm = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Detalhes da Compra -->
    <div v-if="showPurchaseDetail" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 700px; text-align: left; align-items: stretch; gap: 12px; padding: 30px; max-height: 90vh; overflow-y: auto;">
        <h3>📋 Detalhes da Nota Fiscal de Compra</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Visualizando informações fiscais e os itens vinculados a esta nota de entrada.
        </p>

        <div v-if="selectedPurchase" style="display: flex; flex-direction: column; gap: 15px;">
          <div class="form-grid-2" style="background: rgba(255,255,255,0.02); padding: 15px; border: 1px solid var(--border-color); border-radius: 8px;">
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Fornecedor</span>
              <div class="bold-text" style="font-size: 14px; margin-top: 3px;">{{ selectedPurchase.fornecedorNome }}</div>
              <span style="font-size: 12px; color: var(--text-secondary);">CNPJ: {{ formatCnpj(selectedPurchase.fornecedorCnpj) }}</span>
            </div>
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Nota Fiscal / Status</span>
              <div class="bold-text" style="font-size: 14px; margin-top: 3px;">NF-e nº {{ selectedPurchase.numeroNota }}</div>
              <span :class="['badge', selectedPurchase.status === 'Cancelada' ? 'badge-atrasada' : 'badge-paga']" style="margin-top: 4px; display: inline-block;">
                {{ selectedPurchase.status }}
              </span>
            </div>
          </div>

          <div class="form-grid-3">
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Data Emissão</span>
              <div class="bold-text" style="margin-top: 3px;">{{ formatDate(selectedPurchase.dataEmissao) }}</div>
            </div>
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Valor Total</span>
              <div class="bold-text" style="margin-top: 3px; color: var(--primary);">{{ formatAmount(selectedPurchase.valorTotal) }}</div>
            </div>
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Chave de Acesso</span>
              <div style="font-size: 10.5px; font-family: monospace; word-break: break-all; margin-top: 3px;">{{ selectedPurchase.chaveAcesso }}</div>
            </div>
          </div>

          <div style="margin-top: 10px;">
            <h4 style="font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Itens da Nota</h4>
            <div class="table-container" style="max-height: 250px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
              <table class="workspace-table" style="font-size: 12px;">
                <thead>
                  <tr>
                    <th>SKU / Produto</th>
                    <th>Qtd.</th>
                    <th>Preço Unit.</th>
                    <th>ICMS</th>
                    <th>IPI</th>
                    <th style="text-align: right;">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="item in selectedPurchase.itens" :key="item.id">
                    <td>
                      <span class="sku-badge" style="font-size: 10px; padding: 2px 6px;">{{ item.sku }}</span>
                      <div class="bold-text" style="margin-top: 2px;">{{ item.nomeProduto }}</div>
                    </td>
                    <td>{{ item.quantidade }} un</td>
                    <td>{{ formatAmount(item.precoUnitario) }}</td>
                    <td>{{ formatAmount(item.valorIms) }}</td>
                    <td>{{ formatAmount(item.valorIpi) }}</td>
                    <td class="bold-text" style="text-align: right;">{{ formatAmount(item.quantidade * item.precoUnitario) }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 10px;">
            <button type="button" @click="showPurchaseDetail = false" class="btn btn-secondary" style="flex: 1;">
              Fechar Detalhes
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal de Importação / Lançamento de Compra -->
    <div v-if="showPurchaseForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 750px; text-align: left; align-items: stretch; gap: 12px; padding: 30px; max-height: 92vh; overflow-y: auto;">
        <h3>📥 Lançar Nota Fiscal de Entrada</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Importe o arquivo XML ou preencha os dados da nota. O lançamento atualizará o estoque físico e gerará a fatura a pagar no Financeiro.
        </p>

        <!-- Botão Carregar XML Simulado -->
        <div style="display: flex; gap: 10px; margin-bottom: 15px; padding: 12px; background: rgba(var(--primary-rgb), 0.05); border: 1px dashed var(--primary); border-radius: 8px; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 24px;">📁</span>
            <div>
              <div class="bold-text" style="font-size: 13px;">Importação de XML de Compra</div>
              <div style="font-size: 11px; color: var(--text-muted);">Carregue o arquivo .xml da NF-e</div>
            </div>
          </div>
          <button type="button" @click="simulateXmlUpload" class="btn btn-primary" style="font-size: 12px; padding: 6px 12px; margin: 0;">
            ⚡ Simular Upload XML
          </button>
        </div>

        <form @submit.prevent="submitPurchaseForm" class="vertical-form">
          <div class="form-grid-3">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">CNPJ Fornecedor *</label>
              <input type="text" v-model="purchaseForm.fornecedorCnpj" placeholder="Apenas números" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px; grid-column: span 2;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Nome/Razão Social Fornecedor *</label>
              <input type="text" v-model="purchaseForm.fornecedorNome" placeholder="Ex: Distribuidora de Bebidas Brasil Ltda" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Número da Nota *</label>
              <input type="text" v-model="purchaseForm.numeroNota" placeholder="Ex: 10523" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Data Emissão *</label>
              <input type="date" v-model="purchaseForm.dataEmissao" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor Total Nota *</label>
              <input type="number" step="0.01" min="0" v-model="purchaseForm.valorTotal" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Chave de Acesso (44 dígitos) *</label>
            <input type="text" v-model="purchaseForm.chaveAcesso" placeholder="Chave da NF-e" maxlength="44" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px; font-family: monospace;" />
          </div>

          <!-- Itens da Nota -->
          <div style="border-top: 1px solid var(--border-color); padding-top: 15px; margin-top: 15px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <h4 style="font-size: 12.5px; font-weight: 600; text-transform: uppercase;">Itens da Nota Fiscal</h4>
              <button type="button" @click="addPurchaseItem" class="btn btn-secondary btn-header-refresh" style="font-size: 11px; padding: 4px 10px; margin: 0;">
                ➕ Adicionar Item
              </button>
            </div>

            <div style="max-height: 200px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
              <div v-for="(item, idx) in purchaseForm.itens" :key="idx" class="form-grid-5" style="align-items: flex-end; gap: 8px; background: rgba(255,255,255,0.01); padding: 8px; border: 1px solid var(--border-color); border-radius: 6px;">
                <div class="form-group" style="grid-column: span 2;">
                  <label style="font-size: 9px; text-transform: uppercase;">Produto *</label>
                  <select v-model="item.sku" required style="width: 100%; padding: 8px; background: #18181b; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 12px;">
                    <option v-for="p in products" :key="p.sku" :value="p.sku">{{ p.sku }} - {{ p.name }}</option>
                  </select>
                </div>
                <div class="form-group">
                  <label style="font-size: 9px; text-transform: uppercase;">Qtd. *</label>
                  <input type="number" step="1" min="1" v-model="item.quantidade" required style="width: 100%; padding: 8px; background: #18181b; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 12px;" />
                </div>
                <div class="form-group">
                  <label style="font-size: 9px; text-transform: uppercase;">Unitário (R$) *</label>
                  <input type="number" step="0.01" min="0" v-model="item.precoUnitario" required style="width: 100%; padding: 8px; background: #18181b; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 12px;" />
                </div>
                <div class="form-group" style="display: flex; align-items: center; justify-content: center; padding-bottom: 4px;">
                  <button type="button" @click="removePurchaseItem(idx)" class="btn btn-danger" style="padding: 6px 10px; font-size: 11px; margin: 0; color: #ef4444; border-color: rgba(239, 68, 68, 0.2);">
                    🗑️
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 25px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Lançar Entrada de Nota
            </button>
            <button type="button" @click="showPurchaseForm = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Movimentação de Caixa (Suprimento / Sangria) -->
    <div v-if="showMovementForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 450px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>💸 Registrar Movimentação de Caixa</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Adicione um lançamento de entrada (suprimento/troco) ou saída (sangria/retirada) no caixa atual.
        </p>

        <form @submit.prevent="submitMovementForm" class="vertical-form">
          <div class="form-group" style="margin-bottom: 12px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Tipo de Operação</label>
            <div style="display: flex; gap: 10px; margin-top: 5px;">
              <button type="button" @click="movementType = 'Suprimento'" :class="['btn', movementType === 'Suprimento' ? 'btn-primary' : 'btn-secondary']" style="flex: 1; margin: 0; padding: 8px;">Suprimento</button>
              <button type="button" @click="movementType = 'Sangria'" :class="['btn', movementType === 'Sangria' ? 'btn-primary' : 'btn-secondary']" style="flex: 1; margin: 0; padding: 8px;">Sangria</button>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor (R$) *</label>
            <input type="number" step="0.01" min="0.01" v-model="movementAmount" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Observação / Justificativa</label>
            <input type="text" v-model="movementObservation" placeholder="Ex: Reforço de troco / Pagamento motoboy" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
          </div>

          <div style="display: flex; gap: 12px; margin-top: 20px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Confirmar Lançamento
            </button>
            <button type="button" @click="showMovementForm = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Fechamento de Caixa -->
    <div v-if="showCloseCaixaForm" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 500px; text-align: left; align-items: stretch; gap: 12px; padding: 30px;">
        <h3>🔒 Fechamento de Caixa</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Informe o valor total em dinheiro existente fisicamente na gaveta do caixa para fechamento. O sistema calculará a diferença automaticamente.
        </p>

        <div v-if="activeCaixaDetails" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; font-size: 13px;">
          <div style="display: flex; justify-content: space-between;">
            <span>Saldo Inicial (Abertura):</span>
            <span class="bold-text">{{ formatAmount(activeCaixaDetails.saldoAbertura) }}</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span>Vendas em Dinheiro:</span>
            <span class="bold-text" style="color: var(--success);">+ {{ formatAmount(activeCaixaDetails.totalVendasDinheiro) }}</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span>Total Suprimentos:</span>
            <span class="bold-text" style="color: var(--success);">+ {{ formatAmount(activeCaixaDetails.totalSuprimentos) }}</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span>Total Sangrias:</span>
            <span class="bold-text" style="color: var(--danger);">- {{ formatAmount(activeCaixaDetails.totalSangrias) }}</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 8px; font-size: 14.5px;">
            <span class="bold-text">Saldo Esperado em Caixa:</span>
            <span class="bold-text" style="color: var(--primary);">{{ formatAmount(activeCaixaDetails.saldoCalculadoDinheiro) }}</span>
          </div>
        </div>

        <form @submit.prevent="submitCloseCaixa" class="vertical-form">
          <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">Valor Físico Contado (Dinheiro) *</label>
            <input type="number" step="0.01" min="0" v-model="physicalCashCount" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 16px; font-weight: bold; text-align: right;" />
          </div>

          <div style="display: flex; gap: 12px; margin-top: 20px;">
            <button type="submit" class="btn btn-success" style="flex: 1;">
              Confirmar Fechamento
            </button>
            <button type="button" @click="showCloseCaixaForm = false" class="btn btn-danger" style="flex: 1; border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); color: #ef4444;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de Cadastro / Edição de Serviço -->
    <div v-if="showServicoModal" class="welcome-overlay">
      <div class="welcome-card glass-panel animate-scale" style="width: 850px; text-align: left; align-items: stretch; gap: 12px; padding: 25px; max-height: 90vh; overflow-y: auto;">
        <h3>{{ selectedServico ? '✏️ Editar Serviço' : '➕ Novo Serviço' }}</h3>
        <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Cadastre ou altere os parâmetros tributários, valores e códigos do serviço.
        </p>

        <form @submit.prevent="submitServicoForm" class="vertical-form">
          <div class="form-grid-3">
            <div class="form-group">
              <label>Código do Serviço *</label>
              <input type="text" v-model="servicoForm.codigo" required placeholder="Ex: SERV-01" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group" style="grid-column: span 2;">
              <label>Descrição do Serviço *</label>
              <input type="text" v-model="servicoForm.descricao" required placeholder="Ex: Consultoria de Integração de Sistemas" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group">
              <label>Valor Padrão (R$) *</label>
              <input type="number" step="0.01" v-model="servicoForm.valor" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>Unidade Medida *</label>
              <select v-model="servicoForm.unidadeMedidaId" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option v-for="u in unidades" :key="u.id" :value="u.id">{{ u.unidadeMedida }} - {{ u.descricao }}</option>
              </select>
            </div>
            <div class="form-group">
              <label>Código LC 116 (SEFAZ) *</label>
              <select v-model="servicoForm.codigoServicoSefazId" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option v-for="c in sefazServiceCodes" :key="c.id" :value="c.id">{{ c.codigo }} - {{ c.descricao }}</option>
              </select>
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group">
              <label>CNAE Relacionado *</label>
              <input type="number" v-model="servicoForm.cnae" required placeholder="Ex: 6201501" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>Código NBS</label>
              <input type="text" v-model="servicoForm.codigoNbs" placeholder="Ex: 1.01.1" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>Informações Fisco</label>
              <input type="text" v-model="servicoForm.informacaoAdicional" placeholder="Informações adicionais" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <h4 style="font-size: 14px; font-weight: 600; border-bottom: 1px solid var(--border-color); padding-bottom: 5px; margin-top: 15px; margin-bottom: 10px;">💸 Configurações Tributárias (ISSQN / Retenções)</h4>

          <div class="form-grid-4">
            <div class="form-group">
              <label>Alíquota ISS (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaIss" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>ISS Retido (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaIssRetido" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>IRRF Retido (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaIrrfRetido" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>INSS (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaInss" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-3" style="margin-top: 10px;">
            <div class="form-group">
              <label>CST PIS/COFINS *</label>
              <select v-model="servicoForm.cstPisCofins" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option :value="1">01 - Alíquota Básica</option>
                <option :value="7">07 - Isenta</option>
                <option :value="8">08 - Sem Incidência</option>
                <option :value="99">99 - Outras Operações</option>
              </select>
            </div>
            <div class="form-group">
              <label>Alíquota PIS (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaPis" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
            <div class="form-group">
              <label>Alíquota COFINS (%)</label>
              <input type="number" step="0.01" v-model="servicoForm.aliquotaCofins" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>
          </div>

          <div class="form-grid-3" style="margin-top: 10px;">
            <div class="form-group">
              <label>Anexo Simples Nacional *</label>
              <select v-model="servicoForm.anexoSimplesNacional" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;">
                <option :value="0">Não se Aplica</option>
                <option :value="1">Locação de bens móveis</option>
                <option :value="2">Escritório Serviços Contábeis</option>
                <option :value="3">Anexo III (Serviços gerais)</option>
                <option :value="4">Anexo IV (Obras/Medicina)</option>
                <option :value="5">Anexo III ou V (Fator R)</option>
