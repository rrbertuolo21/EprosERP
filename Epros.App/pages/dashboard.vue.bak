        </p>

        <form @submit.prevent="submitCfopForm" class="vertical-form">
          <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <!-- Codigo -->
            <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">CFOP Código *</label>
              <input type="number" v-model="cfopForm.cfopCodigo" :disabled="!!selectedCfop" placeholder="Ex: 5102" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>

            <!-- Natureza da operacao -->
            <div class="form-group" style="flex: 2; min-width: 250px; margin-bottom: 12px;">
