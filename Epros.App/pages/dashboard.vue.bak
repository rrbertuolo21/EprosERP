const submitPaymentForm = async () => {
  const item = selectedFinanceItem.value
  if (!item) return

  if (paymentForm.value.valorPago <= 0) {
    alert('Erro: O valor pago deve ser maior que zero.')
    return
  }

  if (apiOnline.value) {
    try {
      const endpoint = item.type === 'Pagar'
        ? `http://localhost:5000/api/v1/financeiro/contas-pagar/${item.realId || item.id}/baixar`
        : `http://localhost:5000/api/v1/financeiro/contas-receber/${item.realId || item.id}/baixar`

      const payload = item.type === 'Pagar' 
        ? {
            valorPago: paymentForm.value.valorPago,
            dataPagamento: new Date(paymentForm.value.dataPagamento).toISOString(),
            formaPagamento: paymentForm.value.formaPagamento
          }
        : {
            valorRecebido: paymentForm.value.valorPago,
            dataRecebimento: new Date(paymentForm.value.dataPagamento).toISOString(),
            formaPagamento: paymentForm.value.formaPagamento
          }

      await $fetch(endpoint, {
        method: 'POST',
        body: payload
      })

      alert('Baixa do título efetuada com sucesso!')
      showPaymentModal.value = false
      await loadFinance()
    } catch (e) {
      console.error(e)
      alert('Erro ao realizar baixa no servidor.')
    }
  } else {
    // Offline Mock Mode
    const found = finance.value.find(f => f.id === item.id)
    if (found) {
      found.status = 'Pago'
    }
    showPaymentModal.value = false
    
    // Atualiza totais
    receivablesTotal.value = finance.value.filter(f => f.type === 'Receber' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
    payablesTotal.value = finance.value.filter(f => f.type === 'Pagar' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
    
    alert('Baixa efetuada no modo de simulação!')
  }
}

