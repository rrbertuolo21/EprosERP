          <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <!-- Correlacao -->
            <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">CFOP de Correlação *</label>
              <input type="text" v-model="cfopForm.cfopCorrelacao" placeholder="Ex: 1102" maxLength="4" required style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>

            <!-- Devolucao -->
            <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 12px;">
              <label style="font-size: 11px; font-weight: 600; text-transform: uppercase;">CFOP de Devolução</label>
              <input type="text" v-model="cfopForm.cfopDevolucao" placeholder="Ex: 1202" maxLength="4" style="width: 100%; padding: 10px 14px; background: #18181b; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 13.5px;" />
            </div>

