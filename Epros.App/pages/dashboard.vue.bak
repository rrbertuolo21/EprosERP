const submitUploadCertificate = async () => {
  const empId = currentEmpresaId.value || '3fa85f64-5717-4562-b3fc-2c963f66afa6'
  const payload = {
    arquivoBase64: uploadCertificateForm.value.arquivoBase64,
    senha: uploadCertificateForm.value.senha
  }

  if (apiOnline.value) {
    try {
      const res = await $fetch(`http://localhost:5000/api/v1/empresas/${empId}/certificados`, {
        method: 'POST',
        body: payload
      })
      alert('Certificado carregado com sucesso!')
      showUploadCertificateForm.value = false
      await loadCertificates()
    } catch (e) {
      alert('Erro ao carregar certificado no servidor. Verifique a senha.')
    }
  } else {
    // Local Simulation
    const mockCert = {
      id: Math.random().toString(),
      nomeSujeito: 'SUA EMPRESA LTDA:12345678000100',
      cnpj: '12345678000100',
      numeroSerie: '26B4D89E30FD888',
      fimValidade: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString()
    }
    const currentList = [...certificatesList.value, mockCert]
    localStorage.setItem('mock_certificates', JSON.stringify(currentList))
    certificatesList.value = currentList
    
    alert('Certificado carregado localmente (Simulado)!')
    showUploadCertificateForm.value = false
    uploadCertificateForm.value.arquivoBase64 = ''
    uploadCertificateForm.value.senha = ''
  }
}

const deleteCertificate = async (certId) => {
  if (!confirm('Deseja realmente remover este certificado digital A1? A emissão de notas fiscais será bloqueada.')) return

  const empId = currentEmpresaId.value || '3fa85f64-5717-4562-b3fc-2c963f66afa6'

  if (apiOnline.value) {
    try {
      await $fetch(`http://localhost:5000/api/v1/empresas/${empId}/certificados/${certId}`, {
        method: 'DELETE'
      })
      alert('Certificado removido com sucesso!')
      await loadCertificates()
    } catch (e) {
      alert('Erro ao remover certificado no servidor.')
    }
  } else {
    // Local Simulation
    const currentList = certificatesList.value.filter(c => c.id !== certId)
    localStorage.setItem('mock_certificates', JSON.stringify(currentList))
    certificatesList.value = currentList
    alert('Certificado removido da simulação!')
  }
}

