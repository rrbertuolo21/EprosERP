onMounted(() => {
  const storedUser = localStorage.getItem('epros_user')
  if (!storedUser) {
    router.push('/')
    return
  }
  user.value = JSON.parse(storedUser)

  // Bloqueia de acessar se estiver inadimplente
  if (user.value.status === 'Atrasado') {
    router.push('/area-cliente/minhas-faturas')
    return
  }

  // Verifica se é um usuário recém-cadastrado
  if (route.query.new === 'true') {
    showWelcome.value = true
    // Limpa a query string sem recarregar a página
    router.replace({ path: '/dashboard', query: {} })
  }

  // Carga inicial de dados cruzando real API + mock fallbacks
  checkApiAndLoadData()
})

const checkApiAndLoadData = async () => {
  try {
    // Tenta disparar uma chamada ping para a API real
    await $fetch('http://localhost:5000/api/v1/plataforma/clientes').then(() => {
      apiOnline.value = true
    }).catch(() => {
      apiOnline.value = false
    })
  } catch (e) {
    apiOnline.value = false
  }

  loadProducts()
  loadSales()
  loadFinance()
  loadFiscal()
  loadCfops()
  loadPurchases()
  checkCaixaStatus()
}

// Módulo 1: Produtos
const loadProducts = async () => {
  if (apiOnline.value) {
    try {
      const data = await $fetch('http://localhost:5000/api/v1/estoque/produtos')
      const items = data?.dados?.itens || data?.dados?.Itens || (Array.isArray(data) ? data : [])
      products.value = items.map(p => ({
        id: p.id,
        sku: p.codigoSku || p.sku || p.codigo,
        name: p.nome || p.descricao,
        price: p.precoVenda || p.preco || p.valorVenda,
        stock: p.quantidadeEstoque || p.quantidade || p.saldoEstoque || 0,
        cost: p.custoMedio || p.custo || p.valorCompra || 0,
        ean: p.ean,
        pesoLiquido: p.pesoLiquido,
        pesoBruto: p.pesoBruto,
        valorVendaPrazo: p.valorVendaPrazo,
        valorCompra: p.valorCompra,
        tipoProduto: p.tipoProduto,
        ativo: p.ativo,
        imagem: p.imagem,
        cestId: p.cestId,
        codigoAnpId: p.codigoAnpId,
        balancaId: p.balancaId,
        utilizaBalanca: p.utilizaBalanca,
        codigoProdutoBalanca: p.codigoProdutoBalanca,
        ncmId: p.ncmId
      }))
    } catch (e) {
      loadMockProducts()
    }
  } else {
    loadMockProducts()
  }
  
  // Atualiza contadores
  lowStockCount.value = products.value.filter(p => p.stock < 50).length
}

