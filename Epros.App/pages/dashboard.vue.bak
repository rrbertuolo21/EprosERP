const pdvCartSubtotal = computed(() => {
  return pdvCart.value.reduce((sum, item) => sum + (item.price * item.qty), 0)
})

const pdvCartTotal = computed(() => {
  return Math.max(0, pdvCartSubtotal.value - pdvDiscount.value)
})

