const pagarFatura = async (fatura) => {
  if (!confirm('Deseja marcar esta fatura como paga?')) return
  
  if (apiOnline.value) {
    try {
      await $fetch(`http://localhost:5000/api/v1/cartoes-credito/faturas/${fatura.id}/baixar`, { method: 'POST' })
      await loadFaturas(selectedCartao.value.id)
    } catch (e) {
      alert('Erro ao dar baixa na fatura.')
    }
  } else {
    const allFaturas = JSON.parse(localStorage.getItem('epros_faturas_cartoes') || '[]')
    const idx = allFaturas.findIndex(f => f.id === fatura.id)
    if (idx !== -1) {
      allFaturas[idx].pago = true
    }
    localStorage.setItem('epros_faturas_cartoes', JSON.stringify(allFaturas))
    
    const itemIdx = faturasList.value.findIndex(f => f.id === fatura.id)
    if (itemIdx !== -1) {
      faturasList.value[itemIdx].pago = true
    }
    alert('Fatura quitada localmente (offline)!')
  }
}

// --- Reconciliação OFX ---
const processarOfx = async () => {
  if (!ofxForm.value.contaBancariaId || !ofxForm.value.ofxConteudo.trim()) {
    alert('Preencha a conta bancária e insira o extrato OFX XML.')
    return
  }

  isProcessingOfx.value = true
  ofxResult.value = null

  if (apiOnline.value) {
    try {
      const response = await $fetch(`http://localhost:5000/api/v1/contas-bancarias/${ofxForm.value.contaBancariaId}/importar-ofx`, {
        method: 'POST',
        body: { ofxConteudo: ofxForm.value.ofxConteudo }
      })
      ofxResult.value = response?.dados || response || null
      alert('OFX Processado e reconciliado com sucesso!')
      await loadFinance()
    } catch (e) {
      alert('Erro ao importar extrato OFX no servidor.')
    } finally {
      isProcessingOfx.value = false
    }
  } else {
    setTimeout(() => {
      const text = ofxForm.value.ofxConteudo
      const matches = []
      
      const amountRegex = /<TRNAMT>([\d\.\-]+)<\/TRNAMT>/g
      const memoRegex = /<MEMO>([^<]+)<\/MEMO>/g
      
      let amountMatch
      let memoMatch
      const amounts = []
      const memos = []
      
      while ((amountMatch = amountRegex.exec(text)) !== null) {
        amounts.push(parseFloat(amountMatch[1]))
      }
      while ((memoMatch = memoRegex.exec(text)) !== null) {
        memos.push(memoMatch[1].trim())
      }
      
      const totalCount = Math.min(amounts.length, memos.length)
      let reconciledCount = 0
      const resultsList = []

      for (let i = 0; i < totalCount; i++) {
        const amt = amounts[i]
        const memo = memos[i]
        const absAmt = Math.abs(amt)
        const isDebit = amt < 0
        
        const typeMatch = isDebit ? 'Pagar' : 'Receber'
        const match = finance.value.find(f => f.type === typeMatch && f.status === 'Pendente' && Math.abs(f.amount - absAmt) < 0.01)
        
        if (match) {
          match.status = 'Pago'
          reconciledCount++
          resultsList.push({
            data: new Date().toLocaleDateString('pt-BR'),
            memo: memo,
            valor: amt,
            conciliado: true,
            descricao: match.description
          })
        } else {
          resultsList.push({
            data: new Date().toLocaleDateString('pt-BR'),
            memo: memo,
            valor: amt,
            conciliado: false,
            descricao: 'Nenhum título correspondente encontrado'
          })
        }
      }

      ofxResult.value = {
        total: totalCount,
        conciliados: reconciledCount,
        itens: resultsList
      }
      isProcessingOfx.value = false
      alert(`OFX processado localmente: ${reconciledCount} de ${totalCount} transações conciliadas!`)
    }, 1200)
  }
}

// Módulo 3: Financeiro
const loadFinance = async () => {
  await loadBancos()
  await loadContasBancarias()
  await loadCartoesDeCredito()

  if (apiOnline.value) {
    try {
      const crResponse = await $fetch('http://localhost:5000/api/v1/financeiro/contas-receber')
      const cpResponse = await $fetch('http://localhost:5000/api/v1/financeiro/contas-pagar')
      
      const crItems = crResponse?.dados?.itens || crResponse?.dados?.Itens || (Array.isArray(crResponse) ? crResponse : [])
      const cpItems = cpResponse?.dados?.itens || cpResponse?.dados?.Itens || (Array.isArray(cpResponse) ? cpResponse : [])
      
      const combined = []
      crItems.forEach(item => {
        combined.push({
          id: item.id.substring(0, 8),
          realId: item.id,
          description: item.descricao || 'Recebimento de Venda',
          dueDate: new Date(item.dataVencimento).toLocaleDateString('pt-BR'),
          amount: item.valor,
          type: 'Receber',
          status: item.dataBaixa || item.status === 'Pago' ? 'Pago' : (item.status === 'Cancelado' ? 'Cancelado' : (new Date(item.dataVencimento) < new Date() ? 'Atrasado' : 'Pendente'))
        })
      })
      cpItems.forEach(item => {
        combined.push({
          id: item.id.substring(0, 8),
          realId: item.id,
          description: item.descricao || 'Pagamento Fornecedor',
          dueDate: new Date(item.dataVencimento).toLocaleDateString('pt-BR'),
          amount: item.valor,
          type: 'Pagar',
          status: item.dataBaixa || item.status === 'Pago' ? 'Pago' : (item.status === 'Cancelado' ? 'Cancelado' : (new Date(item.dataVencimento) < new Date() ? 'Atrasado' : 'Pendente'))
        })
      })
      finance.value = combined
    } catch (e) {
      loadMockFinance()
    }
  } else {
    loadMockFinance()
  }

  // Atualiza totais
  receivablesTotal.value = finance.value.filter(f => f.type === 'Receber' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
  payablesTotal.value = finance.value.filter(f => f.type === 'Pagar' && f.status === 'Pendente').reduce((acc, curr) => acc + curr.amount, 0)
}

