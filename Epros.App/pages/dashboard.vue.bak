          method: 'PUT',
          body: currentArmazem.value
        })
        if (!res || !res.sucesso) throw new Error(res?.mensagem || 'Erro na resposta')
      } else {
        const res = await $fetch('http://localhost:5000/api/v1/configuracoes/armazens', {
          method: 'POST',
          body: currentArmazem.value
        })
        if (!res || !res.sucesso) throw new Error(res?.mensagem || 'Erro na resposta')
      }
      alert('Armazém salvo com sucesso!')
      showArmazemForm.value = false
      await loadAuxiliares()
    } else {
      let list = JSON.parse(localStorage.getItem('epros_simulated_armazens') || '[]')
      if (currentArmazem.value.id) {
        const idx = list.findIndex(a => a.id === currentArmazem.value.id)
        if (idx !== -1) list[idx] = currentArmazem.value
      } else {
        currentArmazem.value.id = Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join('')
        list.push(currentArmazem.value)
      }
      localStorage.setItem('epros_simulated_armazens', JSON.stringify(list))
      armazens.value = list
      showArmazemForm.value = false
      alert('Armazém salvo (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Falha ao salvar armazém: ' + (e.data?.mensagem || e.message))
  }
}

const deleteArmazem = async (id, nome) => {
  if (nome.includes('Em Uso')) {
    alert('Erro de integridade: Este armazém possui saldo ou movimentação de estoque e não pode ser excluído.')
    return
  }

  if (!confirm(`Deseja realmente excluir o armazém "${nome}"?`)) return

  try {
    if (apiOnline.value) {
      const res = await $fetch(`http://localhost:5000/api/v1/configuracoes/armazens/${id}`, {
        method: 'DELETE'
      })
      if (res && res.sucesso) {
        alert('Armazém excluído com sucesso!')
        await loadAuxiliares()
      } else {
        alert('Erro ao excluir: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      let list = JSON.parse(localStorage.getItem('epros_simulated_armazens') || '[]')
      list = list.filter(a => a.id !== id)
      localStorage.setItem('epros_simulated_armazens', JSON.stringify(list))
      armazens.value = list
      alert('Armazém excluído (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Falha ao excluir armazém: ' + (e.data?.mensagem || e.message))
  }
}

