const saveCompanySettings = async () => {
  isSaving.value = true
  try {
    if (apiOnline.value) {
      const payload = {
        id: currentEmpresaId.value || '3fa85f64-5717-4562-b3fc-2c963f66afa6',
        razaoSocial: companySettings.value.razaoSocial,
        nomeFantasia: companySettings.value.nomeFantasia,
        cnpj: companySettings.value.cnpj,
        inscricaoEstadual: companySettings.value.inscricaoEstadual,
        inscricaoMunicipal: companySettings.value.inscricaoMunicipal,
        inscricaoSuframa: companySettings.value.inscricaoSuframa,
        cnae: companySettings.value.cnae,
        email: companySettings.value.email,
        regimeTributario: companySettings.value.regimeTributario,
        regimeApuracao: companySettings.value.regimeApuracao,
        endereco: {
          logradouro: companySettings.value.endereco.logradouro,
          numero: companySettings.value.endereco.numero,
          complemento: companySettings.value.endereco.complemento,
          bairro: companySettings.value.endereco.bairro,
          cep: companySettings.value.endereco.cep,
          cidade: companySettings.value.endereco.cidade,
          estado: companySettings.value.endereco.estado
        },
        dateFormat: companySettings.value.dateFormat,
        timeZoneId: companySettings.value.timeZoneId,
        currencyId: companySettings.value.currencyId,
        logo: companySettings.value.logo
      }

      const res = await $fetch('http://localhost:5000/api/v1/configuracoes/empresa', {
        method: 'PUT',
        body: payload
      })

      if (res && res.sucesso) {
        alert('Configurações da empresa salvas com sucesso!')
        await loadConfiguracoes()
      } else {
        alert('Erro ao salvar configurações da empresa: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      localStorage.setItem('epros_simulated_company_settings', JSON.stringify(companySettings.value))
      
      const storedUser = localStorage.getItem('epros_user')
      if (storedUser) {
        const parsed = JSON.parse(storedUser)
        parsed.tenantName = companySettings.value.razaoSocial
        localStorage.setItem('epros_user', JSON.stringify(parsed))
        user.value = parsed
      }
      alert('Configurações da empresa salvas com sucesso (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Erro ao salvar as configurações: ' + (e.data?.mensagem || e.message))
  } finally {
    isSaving.value = false
  }
}

const savePreferences = async () => {
  const mudouCash = preferencias.value.negativeCash !== preferenciasOriginal.value?.negativeCash
  const mudouStock = preferencias.value.negativeStock !== preferenciasOriginal.value?.negativeStock
  const mudouMode = preferencias.value.stockCalculationMode !== preferenciasOriginal.value?.stockCalculationMode

  if (mudouCash || mudouStock || mudouMode) {
    justificationText.value = ''
    showJustificationModal.value = true
  } else {
    await performSavePreferences()
  }
}

const confirmPreferencesSave = async () => {
  if (!justificationText.value.trim()) return
  showJustificationModal.value = false
  await performSavePreferences(justificationText.value.trim())
}

const performSavePreferences = async (justificativa = null) => {
  isSaving.value = true
  try {
    const payload = {
      showCurrency: preferencias.value.showCurrency,
      negativeCash: preferencias.value.negativeCash,
      negativeStock: preferencias.value.negativeStock,
      stockCalculationMode: mapStockModeToApi(preferencias.value.stockCalculationMode),
      creditLimit: preferencias.value.creditLimit,
      discount: preferencias.value.discount,
      vatOnPurchase: preferencias.value.vatOnPurchase,
      vatOnSales: preferencias.value.vatOnSales,
      justificativa: justificativa
    }

    if (apiOnline.value) {
      const res = await $fetch('http://localhost:5000/api/v1/configuracoes/preferencias', {
        method: 'PUT',
        body: payload
      })
      if (res && res.sucesso) {
        alert('Preferências atualizadas com sucesso!')
        await loadConfiguracoes()
      } else {
        alert('Erro ao salvar preferências: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      localStorage.setItem('epros_simulated_preferencias', JSON.stringify(preferencias.value))
      
      if (justificativa) {
        const storedLogs = JSON.parse(localStorage.getItem('epros_simulated_audit_logs') || '[]')
        const userStr = localStorage.getItem('epros_user')
        const userId = userStr ? JSON.parse(userStr).email : 'usuario@teste.com'
        
        const mudouCash = preferencias.value.negativeCash !== preferenciasOriginal.value?.negativeCash
        const mudouStock = preferencias.value.negativeStock !== preferenciasOriginal.value?.negativeStock
        const mudouMode = preferencias.value.stockCalculationMode !== preferenciasOriginal.value?.stockCalculationMode
        
        const timestamp = new Date().toISOString()
        const entityId = 'simulated-prefs'

        if (mudouCash) {
          storedLogs.unshift({
            id: Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join(''),
            entidade: 'PreferenciaGeral',
            entidadeId: entityId,
            campo: 'NegativeCash',
            valorAnterior: preferenciasOriginal.value.negativeCash ? 'True' : 'False',
            valorNovo: preferencias.value.negativeCash ? 'True' : 'False',
            usuarioId: userId,
            justificativa: justificativa,
            dataHora: timestamp
          })
        }
        if (mudouStock) {
          storedLogs.unshift({
            id: Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join(''),
            entidade: 'PreferenciaGeral',
            entidadeId: entityId,
            campo: 'NegativeStock',
            valorAnterior: preferenciasOriginal.value.negativeStock ? 'True' : 'False',
            valorNovo: preferencias.value.negativeStock ? 'True' : 'False',
            usuarioId: userId,
            justificativa: justificativa,
            dataHora: timestamp
          })
        }
        if (mudouMode) {
          storedLogs.unshift({
            id: Array(4).fill(0).map(() => Math.random().toString(36).substring(2)).join(''),
            entidade: 'PreferenciaGeral',
            entidadeId: entityId,
            campo: 'StockCalculationMode',
            valorAnterior: preferenciasOriginal.value.stockCalculationMode,
            valorNovo: preferencias.value.stockCalculationMode,
            usuarioId: userId,
            justificativa: justificativa,
            dataHora: timestamp
          })
        }
        
        localStorage.setItem('epros_simulated_audit_logs', JSON.stringify(storedLogs))
        auditLogs.value = storedLogs
      }
      
      preferenciasOriginal.value = JSON.parse(JSON.stringify(preferencias.value))
      alert('Preferências salvas com sucesso (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Erro ao salvar preferências: ' + (e.data?.mensagem || e.message))
  } finally {
    isSaving.value = false
  }
}

const saveEmailSettings = async () => {
  isSaving.value = true
  try {
    let pwdToSend = emailConfig.value.password
    if (pwdToSend === '••••••••') {
      pwdToSend = null
    }

    const payload = {
      host: emailConfig.value.host,
      port: emailConfig.value.port,
      username: emailConfig.value.username,
      password: pwdToSend,
      fromEmail: emailConfig.value.fromEmail
    }

    if (apiOnline.value) {
      const res = await $fetch('http://localhost:5000/api/v1/configuracoes/email', {
        method: 'PUT',
        body: payload
      })
      if (res && res.sucesso) {
        alert('Configurações do servidor SMTP atualizadas com sucesso!')
        await loadConfiguracoes()
      } else {
        alert('Erro ao atualizar SMTP: ' + (res?.mensagem || 'Resposta inválida'))
      }
    } else {
      localStorage.setItem('epros_simulated_email', JSON.stringify(emailConfig.value))
      alert('Configurações SMTP salvas com sucesso (Modo Simulação)!')
    }
  } catch (e) {
    console.error(e)
    alert('Erro ao salvar SMTP: ' + (e.data?.mensagem || e.message))
  } finally {
    isSaving.value = false
  }
}

