const openNewCfopModal = () => {
  selectedCfop.value = null
  cfopForm.value = initialCfopForm()
  showCfopModal.value = true
}

const openEditCfopModal = (cfop) => {
  selectedCfop.value = cfop
  cfopForm.value = { ...cfop }
  showCfopModal.value = true
}

const importCfopFromPadrao = (cp) => {
  selectedCfop.value = null
  cfopForm.value = {
    ...initialCfopForm(),
    cfopCodigo: cp.cfopCodigo,
    descricao: cp.descricao,
    naturezaOperacao: cp.naturezaOperacao,
    cfopCorrelacao: cp.cfopCorrelacao || '',
    cfopDevolucao: cp.cfopDevolucao || '',
    integraFaturamento: cp.integraFaturamento,
    indicadorNfe: cp.indicadorNfe,
    indicadorNfce: cp.indicadorNfce,
    incidenciaSimples: cp.incidenciaSimples
  }
  cfopViewMode.value = 'cliente'
  showCfopModal.value = true
}

const submitCfopForm = async () => {
  if (cfopForm.value.cfopDevolucao) {
    const codeStr = cfopForm.value.cfopCodigo.toString()
    const devStr = cfopForm.value.cfopDevolucao.toString()
    if (codeStr.length > 0 && devStr.length > 0) {
      const init = codeStr[0]
      const devInit = devStr[0]
      let valid = true
      if (init === '1' && devInit !== '5') valid = false
      else if (init === '2' && devInit !== '6') valid = false
      else if (init === '3' && devInit !== '7') valid = false
      else if (init === '5' && devInit !== '1') valid = false
      else if (init === '6' && devInit !== '2') valid = false
      else if (init === '7' && devInit !== '3') valid = false
      
      if (!valid) {
        alert(`Erro de validação fiscal: Um CFOP iniciado em ${init} deve conter CFOP de devolução iniciado em ${init === '1' ? '5' : init === '2' ? '6' : init === '3' ? '7' : init === '5' ? '1' : init === '6' ? '2' : '3'}`)
        return
      }
    }
  }

  if (apiOnline.value) {
    try {
      const url = selectedCfop.value 
        ? `http://localhost:5000/api/v1/cfops/${cfopForm.value.id}` 
        : 'http://localhost:5000/api/v1/cfops'
      const method = selectedCfop.value ? 'PUT' : 'POST'
      
      const payload = { ...cfopForm.value }
      if (!selectedCfop.value) delete payload.id
      
      await $fetch(url, {
        method,
        body: payload
      })
      alert(selectedCfop.value ? 'CFOP atualizado com sucesso!' : 'CFOP criado com sucesso!')
      showCfopModal.value = false
      await loadCfops()
    } catch (e) {
      alert('Erro ao salvar CFOP no servidor. Verifique os campos.')
    }
  } else {
    const local = localStorage.getItem('mock_cfops')
    let items = local ? JSON.parse(local) : []
    if (selectedCfop.value) {
      items = items.map(c => c.id === cfopForm.value.id ? { ...cfopForm.value } : c)
    } else {
      const newCfop = { ...cfopForm.value, id: Math.random().toString() }
      items.push(newCfop)
    }
    localStorage.setItem('mock_cfops', JSON.stringify(items))
    alert('CFOP salvo com sucesso (Simulado)!')
    showCfopModal.value = false
    await loadCfops()
  }
}

const deleteCfop = async (id) => {
  if (!confirm('Deseja realmente excluir este CFOP?')) return
  if (apiOnline.value) {
    try {
      await $fetch(`http://localhost:5000/api/v1/cfops/${id}`, {
        method: 'DELETE'
      })
      alert('CFOP excluído com sucesso!')
      await loadCfops()
    } catch (e) {
      alert('Erro ao excluir CFOP do servidor.')
    }
  } else {
    const local = localStorage.getItem('mock_cfops')
    if (local) {
      let items = JSON.parse(local)
      items = items.filter(c => c.id !== id)
      localStorage.setItem('mock_cfops', JSON.stringify(items))
    }
    alert('CFOP excluído com sucesso (Simulado)!')
    await loadCfops()
  }
}

let cfopDebounceTimer
const debounceLoadCfops = () => {
  clearTimeout(cfopDebounceTimer)
  cfopDebounceTimer = setTimeout(() => {
    cfopPagina.value = 1
    loadCfops()
  }, 400)
}

// Métodos para Contador
const loadContador = async () => {
  isLoadingContador.value = true
  if (apiOnline.value) {
    try {
      const data = await $fetch('http://localhost:5000/api/v1/contadores')
      const items = data.dados?.itens || data.itens || []
      if (items.length > 0) {
        const item = items[0]
        contadorForm.value = {
          ...item,
          ufCrc: typeof item.ufCrc === 'number' ? estadosList[item.ufCrc] : item.ufCrc,
          uf: typeof item.uf === 'number' ? estadosList[item.uf] : item.uf,
          dataVencimentoCrc: item.dataVencimentoCrc ? item.dataVencimentoCrc.substring(0, 10) : ''
        }
      } else {
        resetContadorForm()
      }
    } catch (e) {
      loadMockContador()
    }
  } else {
    loadMockContador()
  }
  isLoadingContador.value = false
}

const loadMockContador = () => {
  const local = localStorage.getItem('mock_contador')
  if (local) {
    contadorForm.value = JSON.parse(local)
  } else {
    resetContadorForm()
  }
}

const resetContadorForm = () => {
  contadorForm.value = {
    id: '',
    razaoSocial: '',
    nomeContador: '',
    cpf: '',
    cnpj: '',
    numeroCrc: '',
    ufCrc: 'PR',
    dataVencimentoCrc: new Date().toISOString().substring(0, 10),
    qualificacao: '',
    funcao: '',
    telefone: '',
    email: '',
    permissaoTransmissao: 3, // Ambos
    ativo: true,
    logradouro: '',
    numero: '',
    complemento: '',
    bairro: '',
    cep: '',
    municipioId: 4106902,
    uf: 'PR'
  }
}

const saveContadorSettings = async () => {
  isSavingContador.value = true
  const ufCrcVal = estadosList.indexOf(contadorForm.value.ufCrc)
  const ufVal = estadosList.indexOf(contadorForm.value.uf)

  const payload = {
    ...contadorForm.value,
    ufCrc: ufCrcVal >= 0 ? ufCrcVal : 15,
    uf: ufVal >= 0 ? ufVal : 15
  }

  if (apiOnline.value) {
    try {
      if (!payload.id) {
        const res = await $fetch('http://localhost:5000/api/v1/contadores', {
          method: 'POST',
          body: payload
        })
        if (res.sucesso) {
          contadorForm.value.id = res.dados.id
          alert('Dados do contador salvos com sucesso!')
        } else {
          alert('Erro ao salvar dados do contador: ' + (res.mensagem || 'erro desconhecido'))
        }
      } else {
        const res = await $fetch(`http://localhost:5000/api/v1/contadores/${payload.id}`, {
          method: 'PUT',
          body: payload
        })
        if (res.sucesso) {
          alert('Dados do contador atualizados com sucesso!')
        } else {
          alert('Erro ao atualizar dados do contador: ' + (res.mensagem || 'erro desconhecido'))
        }
      }
      localStorage.setItem('mock_contador', JSON.stringify(contadorForm.value))
    } catch (e) {
      saveContadorLocal()
    }
  } else {
    saveContadorLocal()
  }
  isSavingContador.value = false
}

const saveContadorLocal = () => {
  if (!contadorForm.value.id) {
    contadorForm.value.id = 'c_' + Math.random().toString(36).substr(2, 9)
  }
  localStorage.setItem('mock_contador', JSON.stringify(contadorForm.value))
  alert('Dados do contador salvos localmente com sucesso!')
}

