# URL base da API (host, sem o prefixo /api/v1). Ex.: https://api.epros.com.br
NUXT_PUBLIC_API_BASE_URL=https://api.example.com

# URL do hub SignalR para emissão de documentos fiscais em tempo real.
NUXT_PUBLIC_REALTIME_URL=https://api.example.com

# URI base do storage de arquivos (logos, certificados, anexos).
NUXT_PUBLIC_STORAGE_URI=https://storage.example.com

# Defina como 'true' apenas para builds Electron (baseURL relativa).
# NUXT_ELECTRON=true
