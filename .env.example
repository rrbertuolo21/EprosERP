# =============================================================================
# EprosERP — variáveis locais (docker-compose.local.yml)
# Copie para .env e ajuste se necessário:  cp .env.example .env
# =============================================================================

# --- postgres ----------------------------------------------------------------
POSTGRES_DB=epros
POSTGRES_USER=epros
POSTGRES_PASSWORD=epros_dev
# Porta no host (container sempre usa 5432)
POSTGRES_PORT=55432

# --- migrate -----------------------------------------------------------------
# Reutiliza POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD.
# Demais valores ficam fixos no compose (Host=postgres, Cofre__KekLocal, etc.).

# --- api ---------------------------------------------------------------------
# Porta no host (container escuta 8080)
API_PORT=8080
# Connection string montada no compose a partir de POSTGRES_* acima.
# CORS_ORIGINS, Seguranca__JwtSigningKey e Cofre__KekLocal ficam no compose.

# --- web ---------------------------------------------------------------------
# Porta no host (container serve na 80)
WEB_PORT=3000
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080  (build arg no compose)
