# =============================================================================
# EprosERP — produção (docker-compose.prod.yml)
# Copie para .env.production e preencha com valores reais:
#   cp .env.production.example .env.production
# Nunca commite .env.production (contém segredos).
# =============================================================================

# --- registry / deploy (CD via GitHub Actions) --------------------------------
# Prefixo GHCR sem nome da imagem. Ex.: ghcr.io/rrbertuolo21
REGISTRY=ghcr.io/rrbertuolo21
# Tag da imagem (SHA do commit no autodeploy; latest no bootstrap manual)
IMAGE_TAG=latest

# --- postgres -----------------------------------------------------------------
POSTGRES_DB=epros
POSTGRES_USER=epros
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# --- minio --------------------------------------------------------------------
MINIO_ROOT_USER=epros_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=epros-fiscal

# --- cofre / API (segredos obrigatórios) --------------------------------------
# KEK base64 para criptografia local (Cofre). Gere com: openssl rand -base64 32
COFRE_KEK_LOCAL=CHANGE_ME_base64_32_bytes
# JWT assinatura — mínimo 32 caracteres. Fail-closed se vazio em Production.
Seguranca__JwtSigningKey=CHANGE_ME_jwt_signing_key_min_32_chars

# --- domínios (Caddy + TLS ACME) ----------------------------------------------
# Produção: app.siser.com.br, api.siser.com.br, storage.siser.com.br
DOMAIN_APP=app.siser.com.br
DOMAIN_API=api.siser.com.br
DOMAIN_STORAGE=storage.siser.com.br
ACME_EMAIL=admin@siser.com.br

# --- CORS (origem do front) ---------------------------------------------------
CORS_ORIGINS=https://app.siser.com.br

# --- frontend (build args Nuxt generate) --------------------------------------
NUXT_PUBLIC_API_BASE_URL=https://api.siser.com.br
NUXT_PUBLIC_REALTIME_URL=https://api.siser.com.br
NUXT_PUBLIC_STORAGE_URI=https://storage.siser.com.br
