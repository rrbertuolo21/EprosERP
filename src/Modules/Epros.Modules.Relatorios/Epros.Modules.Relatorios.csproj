  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Epros.Shared\Epros.Shared.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Epros.Infrastructure\Epros.Infrastructure.csproj" />
    <ProjectReference Include="..\Epros.Modules.Estoque\Epros.Modules.Estoque.csproj" />
    <ProjectReference Include="..\Epros.Modules.Vendas\Epros.Modules.Vendas.csproj" />
    <ProjectReference Include="..\Epros.Modules.Financeiro\Epros.Modules.Financeiro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
