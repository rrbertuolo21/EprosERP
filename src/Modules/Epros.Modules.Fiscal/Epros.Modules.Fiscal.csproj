<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Epros.Shared\Epros.Shared.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Epros.Infrastructure\Epros.Infrastructure.csproj" />
    <ProjectReference Include="..\..\External\Epros.ERP.DfeCalculos\Epros.ERP.DfeCalculos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="Hercules.NET.NFe.NFCe" Version="2026.3.15.14" />
    <!-- Geração de PDF do DANFE (NF-e) / cupom (NFC-e). QuestPDF (licença Community, gratuita)
         gera um PDF real e legível a partir do documento autorizado — sem depender das DLLs
         FastReport/NFe.Danfe do legado (que não estão neste repositório). -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <!-- Geração do QR Code obrigatório da NFC-e (Anexo II do Ajuste SINIEF 07/05) desenhado no cupom.
         QRCoder produz o PNG do QR a partir da URL de consulta (qrCode) que o motor Hercules já grava
         em infNFeSupl do XML autorizado — não fabricamos o hash CSC, apenas renderizamos a URL oficial.
         Sem dependência nativa. O Code128C da chave (DANFE NF-e) é desenhado por rotina própria. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catálogo de CFOP (621 códigos) portado do legado (CFO_LISTA_FIN.csv). Embutido para o seeder. -->
    <EmbeddedResource Include="Infrastructure\Data\SeedData\cfop.csv" />
  </ItemGroup>

</Project>
